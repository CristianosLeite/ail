# lib/async/time.ai -- timers for the tasks of lib/async/task.ai, which a
# program uses before this file: an event that is done after a number of
# milliseconds, and a limit on the time something may take. The file has
# no line that runs at its use; the first timer finds everything zero.
#
# Every variable, parameter and label of this file has a name that starts
# with "async", as its functions and its buffer have.
#
# The timers that run are a heap in memory from alloc, an entry 16 bytes:
# the time it is due, in nanoseconds of the clock that only goes forward,
# and the event. The event keeps the index of its entry at 64, so that a
# timer can be taken out before it is due. asynctm: 0 the heap, 8 how
# many entries it has, 16 how many it has room for.
buf asynctm 24

# the clock (CLOCK_MONOTONIC), in nanoseconds
fn asyncclock
local asyncts 16
sys clock_gettime 1 asyncts
load asyncts as asyncs
load asyncts+8 as asyncn
ret asyncs*1000000000+asyncn
end

# put the entry (asyncd, asynce) where the entry asynci of the heap is,
# and move it up or down until the earliest is first again
fn asyncsift asynci asyncd asynce
load asynctm as asynch
load asynctm+8 as asyncn
while asynci
asyncp=asynci-1>>1
load asynch+asyncp*16 as asynck
jle asynck asyncd asyncdown
load asynch+asyncp*16+8 as asyncx
store asynch+asynci*16 asynck
store asynch+asynci*16+8 asyncx
store asyncx+64 asynci
asynci=asyncp
end
label asyncdown
asyncc=asynci*2+1
if asyncc<asyncn
load asynch+asyncc*16 as asynck
if asyncc+1<asyncn
load asynch+asyncc*16+16 as asyncx
if asyncx<asynck
asynck=asyncx
asyncc+=1
end
end
if asynck<asyncd
load asynch+asyncc*16+8 as asyncx
store asynch+asynci*16 asynck
store asynch+asynci*16+8 asyncx
store asyncx+64 asynci
asynci=asyncc
jmp asyncdown
end
end
store asynch+asynci*16 asyncd
store asynch+asynci*16+8 asynce
store asynce+64 asynci
end

# take the entry asynci out of the heap
fn asyncunheap asynci
load asynctm as asynch
load asynctm+8 as asyncn
asyncn-=1
store asynctm+8 asyncn
if asynci<asyncn
load asynch+asyncn*16 as asyncd
load asynch+asyncn*16+8 as asynce
call asyncsift asynci asyncd asynce
end
end

# what asynccancel calls for a timer: it is no longer due
fn asynctimeroff asynce
load asynce+64 as asynci
call asyncunheap asynci
end

# end the timers that are due
fn asyncexpire
load asynctm+8 as asyncn
ifz asyncn
ret 0
end
call asyncclock as asyncnow
label asyncnext
load asynctm+8 as asyncn
if asyncn
load asynctm as asynch
load asynch as asyncd
if asyncd<=asyncnow
load asynch+8 as asynce
call asyncunheap 0
call asyncdisarm asynce
call asyncfinish asynce 0
jmp asyncnext
end
end
end

# the function of the outside world that asyncstep calls: with asyncb 1
# sleep until a timer is due or a file is ready, with 0 only look; then
# end what is due. 0 if there is no timer and nothing else is expected,
# so that nothing can happen.
fn asynctick asyncb
load asynctm+8 as asyncn
load asyncq+112 as asyncx
ifz asyncn|asyncx
ret 0
end
asyncms=-1
if asyncn
call asyncclock as asyncnow
load asynctm as asynch
load asynch as asyncd
asyncms=0
if asyncd>asyncnow
asyncms=(asyncd-asyncnow+999999)/1000000
if asyncms>0x7fffffff
asyncms=0x7fffffff
end
end
end
ifz asyncb
asyncms=0
end
load asyncq+104 as asyncf
if asyncf
callp asyncf asyncms
else
if asyncms
local asyncts 16
store asyncts asyncms/1000
store asyncts+8 asyncms%1000*1000000
sys nanosleep asyncts 0
end
end
call asyncexpire
ret 1
end

# "call asyncsleep ms as h": an event that is done, with the result 0,
# when ms milliseconds have passed; asynccancel ends it before. 0 if
# there is no memory.
fn asyncsleep asyncms
load asynctm+8 as asyncn
load asynctm+16 as asyncc
if asyncn==asyncc
asyncc=asyncc*2+64
alloc asyncc*16 as asynch
ifz asynch
ret 0
end
load asynctm as asynco
asynci=0
while asynci<asyncn*2
load asynco+asynci*8 as asyncx
store asynch+asynci*8 asyncx
asynci+=1
end
if asynco
free asynco
end
store asynctm asynch
store asynctm+16 asyncc
end
call async 128 0 as asynce
ifz asynce
ret 0
end
ref asynctimeroff as asyncf
call asyncarm asynce asyncf
ref asynctick as asyncf
store asyncq+24 asyncf
# a time that the clock cannot reach is the last one it can count to,
# 292 years, so that neither the product nor the sum wraps
call asyncclock as asyncd
if asyncms>(0x7fffffffffffffff-asyncd)/1000000
asyncd=0x7fffffffffffffff
else
asyncd+=asyncms*1000000
end
store asynctm+8 asyncn+1
call asyncsift asyncn asyncd asynce
ret asynce
end

# A limit is a task with the task or event it limits at 64, its timer
# at 72, 0 once that is gone, and at 80 how it ends: 0 with the result
# of what it limits, 1 with -62, the time being up, 2 with -125, being
# cancelled. Each of the two wakes this task when it is done.
#
# What it limits is cancelled when the time is up or the limit is
# cancelled. An event mostly ends at that; a task is only told, and
# work of the pool that a thread is doing cannot be stopped. The limit
# goes on waiting for those, and ends only when they have, so that
# whoever awaits the limit does not go on while they still use its
# memory.
fn asynclimit asynct
label asynctop
load asynct+64 as asynch
load asynct+72 as asynce
load asynct+80 as asyncf
load asynch+24 as asyncs
if asyncs&4
call asyncdisarm asynct
if asynce
call asynccancel asynce
call await asynce 0
end
call await asynch 0 as asyncv
if asyncf==1
asyncv=-62
end
if asyncf==2
asyncv=-125
end
store asynct+16 asyncv
ret 1
end
if asyncf
store asynch+40 asynct
ret 0
end
load asynce+24 as asyncs
if asyncs&4
call await asynce 0
store asynct+72 0
store asynct+80 1
call asynclimstop asynct as asyncr
jeq asyncr 2 asynctop
ret 0
end
store asynch+40 asynct
store asynce+40 asynct
ret 0
end

# cancel what the limit limits: 2 if it is done then, its record still
# there; 1 if not, a task, which is told and ends when it likes, or work
# that a thread is doing: the limit waits for it
fn asynclimstop asynct
load asynct+64 as asynch
store asynch+40 0
call asynccancel asynch
load asynch+24 as asyncs
if asyncs&4
ret 2
end
store asynch+40 asynct
ret 1
end

# what asynccancel calls for a limit: its timer and what it limits are
# cancelled with it. 1 if the limit cannot end yet: what it limits has
# to end first, or is done already, and the limit is about to have its
# result, which is not thrown away.
fn asynclimitoff asynct
load asynct+64 as asynch
load asynch+24 as asyncs
if asyncs&4
ret 1
end
load asynct+72 as asynce
if asynce
store asynce+40 0
call asynccancel asynce
call asyncdetach asynce
store asynct+72 0
end
store asynct+80 2
call asynclimstop asynct as asyncr
if asyncr==2
load asynct+64 as asynch
call await asynch 0
ret 0
end
ret asyncr
end

# "call asynctimeout h ms as g": a task whose result is that of h if h
# is done within ms milliseconds, and else -62, after h was cancelled.
# It is awaited in the place of h, whose handle means nothing afterwards,
# and cancelling it cancels h. 0 if h is 0, or if there is no memory,
# and h stays.
fn asynctimeout asynch asyncms
# no task: 0, which await takes for one that is done
ifz asynch
ret 0
end
call asyncsleep asyncms as asynce
ifz asynce
ret 0
end
ref asynclimit as asyncp
call async 128 asyncp as asynct
ifz asynct
call asynccancel asynce
call await asynce 0
ret 0
end
store asynct+64 asynch
store asynct+72 asynce
store asynct+80 0
ref asynclimitoff as asyncp
call asyncarm asynct asyncp
ret asynct
end
