# lib/algo/search.aiw -- binary search in 64-bit words that rise in the
# unsigned order.
#
# searchlower returns the first index whose word is not smaller than
# the key, or the count if every word is smaller: the place where the
# key is, if it is there, and where it would go, if not. Of equal words
# it is the first. The words are at an address of the caller, one
# behind the other; they are read and nothing fails. In words that do
# not rise the result is some index up to the count.
#
# Every name of this file starts with "search".

# the first index of the searchn words at searcha whose word is at
# least searchk
fn searchlower searcha searchn searchk
	searchl=0
	while searchl<searchn
		searchm=searchl+searchn>>1
		load searcha+searchm*8 as searchv
		if searchv<searchk
			searchl=searchm+1
		else
			searchn=searchm
		end
	end
	ret searchl
end
