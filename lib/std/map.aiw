# lib/std/map.aiw -- a hash map from 64-bit keys to 64-bit values.
#
# A map is 32 bytes that the caller owns, in a buf or a local: the
# address of its table, the number of places in it, the number of keys,
# and the number of places that hold a key or held one. All zero is an
# empty map, so a buf is one as it stands. The functions take the
# address of the 32 bytes, here called the map; the number of keys is
# read at 16 of it.
#
# A place is 24 bytes: 0 for free, 1 for a key or 2 for one that was
# taken out, then the key and the value, so that every key and every
# value can be used. There is a power of two of places, at least 64. A
# key belongs at the place its hash names, the last step of splitmix64
# cut to the table, and is put at the first place from there on, round
# the end, that holds no key; it is looked for up to the first free one.
#
# mapput may make a new table (an alloc, a free): when three quarters of
# the places hold or held a key, all keys go to a table of twice the
# places, or of as many if the keys fill less than half, which only
# clears the places of keys taken out. The map changes when the new
# table is whole. It returns 1, or 0 when the kernel has no memory, and
# then the map is as it was. mapget returns a value and 1, or 0 and 0
# for a key that is not there, since a value may be 0; mapdel returns 1
# if the key was there. The caller ends the map with mapfree.
#
# Every variable and parameter of this file has a name that starts with
# "map"; a program has no var of such a name (see lib/std/io.aiw).

# the place of the key mapk and 1; or the place where it goes and 0; or 0
# and 0 for a map without a table
fn mapfind mapm mapk
	load mapm as mapp
	load mapm+8 as mapc
	ifz mapc
		ret 0 0
	end
	maph=(mapk^mapk>>30)*0xbf58476d1ce4e5b9
	maph=(maph^maph>>27)*0x94d049bb133111eb
	maph=(maph^maph>>31)&mapc-1
	mapd=0
	label next
	maps=mapp+maph*24
	load maps as mapt
	ifz mapt
		ifz mapd
			mapd=maps
		end
		ret mapd 0
	end
	if mapt==1
		load maps+8 as mapx
		if mapx==mapk
			ret maps 1
		end
	else
		# the first place of a key taken out is where a new key goes
		ifz mapd
			mapd=maps
		end
	end
	maph=maph+1&mapc-1
	jmp next
end

# move every key to a new table: 1, or 0 without memory
fn mapgrow mapm
	local mapnew 32
	load mapm as mapp
	load mapm+8 as mapc
	load mapm+16 as mapn
	mapd=mapc
	if mapn*2>=mapc
		mapd=mapc*2
	end
	if mapd<64
		mapd=64
	end
	# bytes that do not fit in 64 bits are no memory
	if mapd>>58
		ret 0
	end
	alloc mapd*24 as mapq
	ifz mapq
		ret 0
	end
	store mapnew mapq
	store mapnew+8 mapd
	mapi=0
	while mapi<mapc
		maps=mapp+mapi*24
		load maps as mapt
		if mapt==1
			load maps+8 as mapk
			load maps+16 as mapv
			call mapfind mapnew mapk as mapx
			store mapx 1
			store mapx+8 mapk
			store mapx+16 mapv
		end
		mapi+=1
	end
	if mapp
		free mapp
	end
	store mapm mapq
	store mapm+8 mapd
	store mapm+24 mapn
	ret 1
end

# make mapv the value of the key mapk
fn mapput mapm mapk mapv
	call mapfind mapm mapk as maps mapf
	if mapf
		store maps+16 mapv
		ret 1
	end
	load mapm+8 as mapc
	load mapm+24 as mapu
	if mapu*4>=mapc*3
		call mapgrow mapm as mapf
		ifz mapf
			ret 0
		end
		call mapfind mapm mapk as maps mapf
	end
	# a free place is one more that holds a key; another held one before
	load maps as mapt
	ifz mapt
		load mapm+24 as mapu
		store mapm+24 mapu+1
	end
	store maps 1
	store maps+8 mapk
	store maps+16 mapv
	load mapm+16 as mapn
	store mapm+16 mapn+1
	ret 1
end

# the value of the key mapk and 1, or 0 and 0 if it is not there
fn mapget mapm mapk
	call mapfind mapm mapk as maps mapf
	ifz mapf
		ret 0 0
	end
	load maps+16 as mapv
	ret mapv 1
end

# take the key mapk out: 1, or 0 if it was not there
fn mapdel mapm mapk
	call mapfind mapm mapk as maps mapf
	ifz mapf
		ret 0
	end
	store maps 2
	load mapm+16 as mapn
	store mapm+16 mapn-1
	ret 1
end

# give the table back; the map is empty and may be used again
fn mapfree mapm
	load mapm as mapp
	if mapp
		free mapp
	end
	store mapm 0
	store mapm+8 0
	store mapm+16 0
	store mapm+24 0
end
