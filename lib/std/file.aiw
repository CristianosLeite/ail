# lib/std/file.aiw -- whole files, read into a buffer of lib/std/bytes.aiw and
# written from memory. A program that uses it uses lib/std/bytes.aiw first.
#
# A path is an address and a length, as a string literal and the two
# results of argv are; it has no NUL byte in it and fewer than 4096 bytes.
# Every function returns a number that is negative after an error, the
# error of the runtime (-2 no such file, -13 not allowed, -12 no memory,
# -36 path too long), and closes what it opened. The file asks the
# runtime for everything, so it is the same on every platform.
#
# Every variable and parameter of this file has a name that starts with
# "file"; a program has no var of such a name (see lib/std/io.aiw).

# the path with a NUL byte at its end, as a system call of Linux takes
# one, into the 4096 bytes at filez: 0, or -36 if it does not fit. No
# function of this file needs it: the runtime takes a path and its
# length
fn filepath filep filen filez
	if filen>4095
		ret -36
	end
	filei=0
	while filei<filen
		loadb filep+filei as filec
		storeb filez+filei filec
		filei+=1
	end
	storeb filez+filen 0
end

# open the path with the flags and the mode of the service open, plus
# the flag that closes the file in a program the process starts: the
# descriptor, which the caller closes, or the error
fn fileopen filep filen fileflags filemode
	label again
	rt open filep filen fileflags|0x80000 filemode as filefd
	jeq filefd -4 again
	ret filefd
end

# add everything that can be read from the descriptor to the buffer
# fileb, up to the end of the file: the number of bytes added, or the
# error, after which the buffer holds what was read until then
fn filereadfd filefd fileb
	filesum=0
	label more
	call byneed fileb 65536 as fileok
	ifz fileok
		ret -12
	end
	load fileb as filep
	load fileb+8 as filelen
	load fileb+16 as filecap
	rt read filefd filep+filelen filecap-filelen as filer
	jeq filer -4 more
	ifslt filer 0
		ret filer
	end
	ifz filer
		ret filesum
	end
	store fileb+8 filelen+filer
	filesum+=filer
	jmp more
end

# add the bytes of the file at the path to the buffer fileb: their
# number, or the error
fn fileread filep filen fileb
	call fileopen filep filen 0 0 as filefd
	ifslt filefd 0
		ret filefd
	end
	call filereadfd filefd fileb as filer
	rt close filefd
	ret filer
end

# make the file at the path hold the filedn bytes at filed and nothing
# else, creating it if there is none (mode 0666 less the umask): 0, or
# the error
fn filewrite filep filen filed filedn
	call fileopen filep filen 0x241 438 as filefd
	ifslt filefd 0
		ret filefd
	end
	while filedn
		rt write filefd filed filedn as filer
		ifz filer
			filer=-5
		end
		ifslt filer 0
			ifne filer -4
				rt close filefd
				ret filer
			end
			filer=0
		end
		filed+=filer
		filedn-=filer
	end
	rt close filefd as filer
	ret filer
end

# make the directory at the path with the mode filemode less the umask,
# remove the file at the path, remove the empty directory at the path:
# 0, or the error (-17 the directory is there already, -39 not empty)
fn filemkdir filep filen filemode
	rt mkdir filep filen filemode as filer
	ret filer
end
fn fileunlink filep filen
	rt unlink filep filen as filer
	ret filer
end
fn filermdir filep filen
	rt rmdir filep filen as filer
	ret filer
end

# add the names in the directory at the path to the buffer fileb, each
# with a NUL byte after it, in the order the platform gives them and
# without "." and "..": their number, or the error
fn filenames filep filen fileb
	local filed 4096
	call fileopen filep filen 0x10000 0 as filefd
	ifslt filefd 0
		ret filefd
	end
	filec=0
	label more
	rt names filefd filed 4096 as filer
	jeq filer -4 more
	ifsle filer 0
		rt close filefd
		ifslt filer 0
			ret filer
		end
		ret filec
	end
	call byadd fileb filed filer as filek
	ifz filek
		rt close filefd
		ret -12
	end
	filei=0
	while filei<filer
		loadb filed+filei as filek
		filec+=filek==0
		filei+=1
	end
	jmp more
end
