# lib/task.ai -- tasks: the functions that the statements spawn and join
# call, and the pool of threads that runs them. Put  use "lib/task.ai"  in
# a program that has them, compiled from the top of the repository. The
# file has no line that runs at its use: a program that never spawns pays
# nothing, and the first spawn finds everything zero.
#
# A task is a record of 80 bytes, and its handle the address:
#    0  state: 0 waiting in the queue, 1 taken, 2 done, 3 taken and its
#       join asleep on this word
#    8  result
#   16  function
#   24  the five values
#   64  next and 72 previous task of the queue; 64 also links free records
#
# The state of the pool is the buffer taskq, every cell written under the
# lock except the two that a futex sleeps on:
#    0  lock: 0 free, 1 held, 2 held and someone asleep on it
#    8  count of the tasks ever queued, on which idle workers sleep
#   16  first and 24 last task waiting
#   32  how many wait
#   40  workers asleep
#   48  workers started
#   56  the most workers there may be, valid when 64 is not zero
#   72  free records, which come in blocks and are never given back
buf taskq 80

# take the lock: after a few tries, asleep in the kernel while another
# thread holds it. The lock is held for a few instructions, so a try
# mostly succeeds where a sleep would cost two system calls.
fn tasklock
n=100
while n
cas taskq 0 1 as k
jnz k x
n-=1
end
label a
cas taskq 1 2 as k
sys futex taskq 128 2 0
cas taskq 0 2 as k
jz k a
label x
end

# release it, and wake one thread if any may be asleep on it
fn taskunlock
xadd taskq -1 as s
if s!=1
store taskq 0
sys futex taskq 129 1
end
end

# "call workers n": at most n threads run tasks, besides the threads that
# join them. Without it the limit is the number of processors the program
# may use. Workers already started stay.
fn workers n
call tasklock
store taskq+56 n
store taskq+64 1
call taskunlock
end

# the processors this process may run on; 1 if the kernel does not say
fn taskcpus
local m 128
sys sched_getaffinity 0 128 m as r
if r>128
ret 1
end
c=0
while r
r-=1
loadb m+r as b
while b
b&=b-1
c+=1
end
end
ret c
end

# take the waiting task t out of the queue; the caller holds the lock
fn tasktake t
load t+64 as n
load t+72 as p
if p
store p+64 n
else
store taskq+16 n
end
if n
store n+72 p
else
store taskq+24 p
end
load taskq+32 as c
store taskq+32 c-1
store t 1
end

# run the task t, which the caller has taken, and wake its join if that
# went to sleep. After the state is 2 the record may be gone.
fn taskrun t
load t+16 as p
load t+24 as a
load t+32 as b
load t+40 as c
load t+48 as d
load t+56 as e
callp p a b c d e as x
store t+8 x
cas t 1 2 as k
ifz k
store t 2
sys futex t 129 1
end
end

# a worker: run the tasks of the queue, sleep while there are none. It
# never returns; the end of the program ends it.
fn taskwork
label top
call tasklock
label look
load taskq+16 as t
ifz t
load taskq+8 as s
load taskq+40 as i
store taskq+40 i+1
call taskunlock
sys futex taskq+8 128 s 0
call tasklock
load taskq+40 as i
store taskq+40 i-1
jmp look
end
call tasktake t
call taskunlock
call taskrun t
jmp top
end

# start a worker: a thread on a stack of 8 MiB whose lowest page is closed,
# so that a task that needs more faults. 1 if it runs, 0 if the kernel
# refused the memory or the thread. The new thread comes out of clone on
# the new stack with the registers of this one, so nothing between the
# clone and the call of taskwork may be kept in the frame: this function
# has two variables, which have registers.
fn taskstart
alloc 8388608 as s
ifz s
ret 0
end
sys clone 0x50f00 s+8388608 0 0 0 as r
ifz r
call taskwork
end
if r>-4096
free s
ret 0
end
sys mprotect s-16 4096 0
ret 1
end

# 819 free records in one block of 64 KiB from alloc, linked; 0 if there
# is no memory. A task of its own mapping would be a page and a system
# call for 80 bytes.
fn taskmore
alloc 65520 as t
ifz t
ret 0
end
p=t
n=818
while n
store p+64 p+80
p+=80
n-=1
end
store p+64 0
ret t
end

# put the task t at the end of the queue; 1 if an idle worker is to be
# woken, 2 if a worker is to be started: when more tasks wait than workers
# sleep and the limit allows one more. The caller holds the lock.
fn taskput t
store t+64 0
load taskq+24 as n
store t+72 n
if n
store n+64 t
else
store taskq+16 t
end
store taskq+24 t
load taskq+8 as n
store taskq+8 n+1
load taskq+32 as n
n+=1
store taskq+32 n
load taskq+40 as i
w=i!=0
if n>i
load taskq+64 as k
ifz k
call taskcpus as k
store taskq+56 k
store taskq+64 1
end
load taskq+48 as k
load taskq+56 as m
if k<m
store taskq+48 k+1
w=2
end
end
ret w
end

# "spawn f a b c d e as t": a task that will call the function at p with
# the five values; 0 if there is no memory for it
fn spawn p a b c d e
call tasklock
load taskq+72 as t
ifz t
call taskmore as t
ifz t
call taskunlock
ret 0
end
end
load t+64 as n
store taskq+72 n
store t 0
store t+16 p
store t+24 a
store t+32 b
store t+40 c
store t+48 d
store t+56 e
call taskput t as w
call taskunlock
if w==1
sys futex taskq+8 129 1
end
if w==2
call taskstart as k
ifz k
call tasklock
load taskq+48 as k
store taskq+48 k-1
call taskunlock
end
end
ret t
end

# "join t as x": the result of the task t. A task still in the queue is
# run here; one that a worker took is waited for. The record is free
# afterwards. The result of no task is 0.
fn join t
ifz t
ret 0
end
load t as s
ifz s
call tasklock
load t as s
ifz s
call tasktake t
call taskunlock
call taskrun t
jmp done
end
call taskunlock
end
label w
load t as s
if s!=2
cas t 1 3 as k
sys futex t 128 3 0
jmp w
end
label done
load t+8 as x
call tasklock
load taskq+72 as n
store t+64 n
store taskq+72 t
call taskunlock
ret x
end
