# ---- start: a closed output pipe must be a write error, not a death
store sig 1
sys rt_sigaction 13 sig 0 8
p=in
q=in+inmax
label rd
r=q-p
ifz r
call ebig
end
sys read 0 p r as r
if r
if r>inmax
call erd
end
p+=r
jmp rd
end
ie=p
srcend=p
mainend=p
ip=in
op=out
call cp hdr 176

