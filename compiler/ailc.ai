if f==255
loadb r as d
jeq d 1 fndef
jeq d 2 bufdef
jeq d 3 fnend
jeq d 4 labdef
jeq d 5 datadef
jeq d 6 vardef
jeq d 7 constdef
jeq d 8 localdef
jeq d 9 usedef
jeq d 10 elsedef
jmp whiledef
end
cur=r
ai=0
ncap=0
store opd 0
store opd+32 0
call pk as c
call blank c as d
call ok d
call blanks
if f&32
ifz infn
call eplace
end
end
loadb cur+2 as d
if d&16
if infn
call eplace
end
end
call xclass as d
xst=d
if d
call exinit
end
if f&16
call rname
cn=ns
cl=nl
jmp tokend
end
jz f&4 arg
call pk as c
call low c as d
jz d num
call sname as r
call mov r
jmp tokend

# The value of a while has been read again, at the end of its loop, as the
# value of a jnz: compare or test it, and jump back to the first line of
# the loop while it holds. The jump of the head, taken when the value does
# not hold at first, lands behind.
label wclose
call xjcond
call eop
call e4 wbody-op-4
call blktop as p
nblk-=1
wend=0
ip=wip
asg=wasg
dead=0
jmp be3

# "<name>=<expression>" and "<name><operator>=<expression>"
label asgn
call exasn d-2
jmp next

# the end of a unit of source: go on after the use that named it, or finish
label uend
jz nustk fin
if infn
call eend
end
nustk-=1
load nustk*8+ucur as curunit
p=nustk*16+ustack
load p as ip
p+=8
load p as ie
jmp next

# "use "<path>"": read the file behind the source read so far and compile
# it here, unless a use with the same path was compiled before
label usedef
if infn
call eplace
end
call blank1
call pk as c
call ok c==34
call adv
p=ip
label u1
call pk as c
if c==256
call estr
end
if c!=34
if c==10
call estr
end
call adv
jmp u1
end
q=ip-p
call adv
call eol
ns=p
nl=q
call ok q
call no q>4095
call look uses nuses 16 as r
jne r -1 next
call putn nuses*16+uses
nuses+=1
r=pathbuf
label u8
if q
loadb p as c
storeb r c
p+=1
r+=1
q-=1
jmp u8
end
storeb r 0
epos=ns
sys open pathbuf 0 0 as f
ifslt f 0
call euse
end
r=srcend
label u4
q=in+inmax-srcend
ifz q
call ebig
end
sys read f srcend q as c
ifslt c 0
call euse
end
if c
srcend+=c
jmp u4
end
sys close f
epos=0
p=nuses*8
store p+ustart-8 r
store p+uendp-8 srcend
store nustk*8+ucur curunit
curunit=nuses
p=nustk*16+ustack
store p ip
p+=8
store p ie
nustk+=1
ip=r
ie=srcend
jmp next

# ---- arguments
# every token must be followed by a space, tab, comment or end of line
label tokend
call tokchk
label arg
call ochk
call pk as c
jeq c 256 a1
jeq c 10 a1
jeq c 35 a1
call blank c as d
jnz d a2
if c!=13
jnz xst xarg
jeq c 34 str
call excomp as d
jnz d earg
call low c as d
jnz d ident
jeq c 45 num
call dig c as d
jnz d num
call err
end
call crlf
label a1
jnz wend wclose
loadb cur+1 as f
if f&8
call emlab
end
if f&1
call eas
end
if xst==5
call xmstore
end
call xjcond
call eop
loadb cur+2 as f
jz f&8 next
p=nblk*40+blks
store p op
p+=8
store p asg
p+=8
store p 0
p+=8
ifz whead
store p 0
else
# a while: its first line is behind this jump
store p op+4
end
p+=8
store p wsrc
whead=0
call z 4
nblk+=1
jmp next
label a2
call adv
jmp arg

# an expression: not where a name must stand (the first value of at, the
# operand of len, the label of a jump)
label earg
call atfirst as d
call no d
loadb cur+1 as r
call no r&64
if r&8
loadb cur as d
if ai>=d
call err
end
end
call exinit
call exparse 0
call exarg
jmp tokend

# a value of a statement that is compiled like an expression: parsed now,
# computed when the statement is complete. A name may be as, or the label
# of a jump that has its values.
label xarg
call low c as d
if d
q=ip
call name
r=cur
loadb r+1 as f
if f&8
loadb r as f
jge ai f jtarget
end
call isas as d
jnz d capture
ip=q
end
call exparse ai
ai+=1
jmp tokend

label num
call atfirst as d
call no d
call rdnum as r
loadb cur+1 as d
call no d&64
call opdp as p
store p 1
p+=8
store p r
call mov r
jmp tokend

# string: the bytes go into the code behind a jmp. sys and call get two
# values (address, length), len the length, the rest the address
label str
call atfirst as d
call no d
call adv
call eb 233
r=op
call z 4
p=op
call sbytes
q=op-p
store4 r q
call opdp as d
store d 3
store d+8 q
loadb cur+1 as r
jnz r&64 s1
call elea
store4 immpos p-immpos-4
jnz r&20 s1
loadb cur+2 as d
jz d&4 tokend
label s1
call mov q
jmp tokend

# a name: a variable or buffer to pass, "as", or the label of a jump
label ident
call name
r=cur
loadb r+1 as f
if f&8
loadb r as f
jge ai f jtarget
end
call isas as d
jnz d capture
call atfirst as d
jnz d atname
loadb cur+1 as r
if r&64
call lbuf as r
if r==-1
call mov 0
r=1
jmp i9
end
call gent r as r
load r+32 as d
call no d
load r+24 as r
call mov r
jmp tokend
end
call lvar as r
jeq r -1 i2
store r*8+vlast ip
ifz asg>>r&1
call eunasg
end
call opdp as d
call cp4 r*32+vk d
call aidx as d
call areg d as f
call vmov r f 139
call anext
jmp tokend
label i2
call lbuf as r
jne r -1 i4
label i8
call opda
call elea
r=0
label i9
call addref r
jmp tokend

# the first value of at: a name, passed as its address and its size
label atname
call lvar as r
if r!=-1
load r*8+vlocal as d
call ok d
store r*8+vlast ip
call vmov r 0 139
ai=1
load r*8+vlocsz as d
call mov d
jmp tokend
end
call lbuf as r
if r!=-1
call gent r as p
load p+32 as d
call no d
end
call elea
call addref 0
call mov 0
call addref 2
jmp tokend
label i4
call gent r as p
load p+32 as d
if d!=1
if d==2
load p+24 as r
call opdp as d
store d 1
store d+8 r
call mov r
jmp tokend
end
jmp i8
end
load p+16 as r
call ldvar r
jmp tokend

# "as <name>": emit the statement and keep rax in the variable
label capture
loadb cur+1 as r
if r&2
call enoas
end
label cp0
call blanks
q=ip
call rdname
call lbuf as r
jeq r -1 cp1
call gent r as p
load p+32 as d
jz d==1 cp1
load p+16 as p
f=1
jmp cp3
label cp1
ip=q
call defvar as p
load p*8+vlocal as d
if d
call edup
end
f=0
label cp3
call ok ncap<6
d=ncap*16+caps
store d f
store d+8 p
ncap+=1
call blanks
call pk as c
jeq c 256 cp4
jeq c 10 cp4
jeq c 13 cp4
jeq c 35 cp4
loadb cur+1 as d
jnz d&16 cp0
loadb cur+2 as d
jnz d&4 cp0
call err
label cp4
call eol
if xst
if xst==4
call xmload
jmp next
end
call xcap
jmp next
end
call eop
r=0
label cp5
jge r ncap next
d=r*16+caps
load d as f
load d+8 as p
call areg r as q
ifz f
asg|=1<<p
call prop p
call vmov p q 137
jmp cp7
end
call emem q 1 p 137
label cp7
r+=1
jmp cp5

# "buf <name> <size>"
label bufdef
call blank1
call rdname
call newglob as p
call blank1
call pk as c
call low c as d
if d
call cname as r
jmp b2
end
call rdnum as r
label b2
if r>0x7fffffff
call ebuf
end
call eol
store p+32 0
store p+40 0
store p+24 r
r=r+7>>3<<3
q=bsssz
r+=q
if r>0x7fffffff
call ebuf
end
bsssz=r
p+=16
store p q
call globdone
jmp next

# "local <name> <size>": bytes in the frame of the open function; the name
# takes one of its variables, whose value is the address
label localdef
ifz infn
call eplace
end
call blank1
q=nv
call defvar as r
if nv==q
call edup
end
call blank1
call pk as c
call low c as d
if d
call cname as p
jmp l3
end
call rdnum as p
label l3
if p>0x7ffffff0
call ebuf
end
call eol
store r*8+vlocsz p
p=p+7>>3<<3
store r*8+vlocal loccur+1
p+=loccur
if p>0x7ffffff0
call ebuf
end
loccur=p
asg|=1<<r
store r*32+vk 0
jmp next

# "var <name>...": global cells, below the buffers, the first one highest
label vardef
call blank1
label v1
call rdname
call newglob as p
store p+32 1
r=ngv+1
ngv=r
store p+16 r
call globdone
call tokchk
call blanks
call pk as c
jeq c 256 v2
jeq c 10 v2
jeq c 13 v2
jne c 35 v1
label v2
call eol
jmp next

# "const <name> <number>"
label constdef
call blank1
call rdname
call newglob as p
call blank1
call rdnum as r
call eol
store p+24 r
store p+32 2
call globdone
jmp next

# "data [<name>] <item>...": bytes behind a jmp; data statements that
# follow each other share the jmp, so their bytes are contiguous
label datadef
call blank1
f=0
call pk as c
call no c==256
call low c as d
if d
call rdname
call newglob as p
call tokchk
f=1
end
if op!=dataend
call eb 233
datarel=op
call z 4
nruns+=1
end
q=op
r=0
label d3
call ochk
call blanks
call pk as c
jeq c 256 d6
jeq c 10 d6
jeq c 13 d6
jeq c 35 d6
if c==34
call adv
call sbytes
jmp d5
end
call rdnum as c
call no c>255
call eb c
label d5
call tokchk
r+=1
jmp d3
label d6
call ok r
call eol
if f
store p+32 0
store p+40 nruns
store p+24 op-q
store p+16 q-out
call globdone
end
p=datarel
q=op
store4 p q-p-4
dataend=q
store nruns*8+runend-8 q-out
jmp next

# "label <name>"
label labdef
call blank1
call rname
call eol
call llab as r
call nodup r
r=nlabels
p=r*40+labs
call putn p
p+=16
store p op
p+=8
store p ip
call labasg
call clrvk
xflg=16
p+=8
store p asg
call hadd 3 scope r
nlabels=r+1
dataend=0
jmp next

# the label name of a jump: its rel32 is filled in by resolve
label jtarget
call eol
call llab as r
jeq r -1 j1
r=(r+labbase)*40+labs
load r+32 as d
if d&(asg^-1)
call eunasgj
end
jne pass 1 j2
load r+24 as r
p=nloops*16+loops
store p r
store p+8 ip
nloops+=1
jmp j2
label j1
call hfind 4 scope as q
ifz q
call hadd 4 scope 0 as q
store q+8 -1
end
q+=8
load q as d
store q d&asg
label j2
call xjcond
call eop
r=nfix
p=r*32+fixs
call putn p
p+=16
store p op
p+=8
store p asg
call z 4
nfix=r+1
loadb cur as d
jnz d next
call godead
jmp next

# "fn <name> <parameter>...": jump over the body, save the variable
# registers and open a scope whose first variables are the parameters
label fndef
if infn
call eplace
end
jnz pass f0
sip=ip
sop=op
snb=nbufs
snv=ngv
sbs=bsssz
snc=ncalls
snf=nfuncs
snr=nrefs
sde=dataend
sdr=datarel
snk=nchks
snu=nruns
snh=nhn
pass=1
fnslots=0
fnregs=6
fnlocal=0
nloops=0
label f0
loccur=0
fnres=0
fntail=0
call clrloc
call blank1
call rname
call lfn as r
call nodup r
p=nfuncs*40+funs
call putn p
call eb 233
fnskip=op
call z 4
q=op
p+=16
store p q
loadb fnregs+pushlen as q
call cp fnpush q
call frame 236
topvars=nv
nv=0
topblk=blkbase
blkbase=nblk
tasg=asg
tdead=dead
tjmask=jmask
asg=0
dead=0
infn=1
nscope+=1
scope=nscope
labbase=nlabels
fixbase=nfix
label f1
call blanks
call pk as c
jeq c 256 f2
jeq c 10 f2
jeq c 13 f2
jeq c 35 f2
q=nv
call defvar as r
if nv==q
call edup
end
asg|=1<<r
if r<6
call areg r as f
call vmov r f 137
jmp f1
end
call emem 11 2 (fnnpar-r+fnslots+fnregs)*8+fnlocal 139
call vmov r 11 137
jmp f1
label f2
call eol
fnnpar=nv
store p+8 nv
p=nfuncs*40+funs
call getn p
call hadd 2 0 nfuncs
nfuncs=nfuncs+1
jmp next

# "end": return 0, resolve the function's jumps, drop its labels and jumps
label fnend
jgt nblk blkbase blkend
ifz infn
call eplace
end
call eol
q=fnres
d=q
jnz q e0
q=1
d=1
jz fntail e0
d=6
label e0
store (nfuncs-1)*40+funs+32 d
loadb q+zerolen-1 as p
call cp zeroes p
call frame 196
call popskip as q
call cp retc+q 11-q
call resolve
nfix=fixbase
nlabels=labbase
fixbase=0
labbase=0
infn=0
scope=0
asg=tasg
dead=tdead
jmask=tjmask
blkbase=topblk
call clrvk
p=fnskip
store4 p op-p-4
jne pass 1 e1
fnlocal=loccur
call alloc
ip=sip
op=sop
nbufs=snb
ngv=snv
bsssz=sbs
ncalls=snc
nfuncs=snf
nrefs=snr
dataend=sde
datarel=sdr
nchks=snk
nruns=snu
call hundo snh
nv=topvars
pass=2
jmp fndef
label e1
call clrloc
pass=0
fnslots=0
fnregs=6
fnlocal=0
nv=topvars
jmp next

# "end" with a block open: what is assigned after it is what both ways
# here have assigned, its last line and the jump past it, or after an else
# part the last line of the part before
label blkend
call eol
p=(nblk-1)*40+blks
load p+24 as r
if r
# The end of a while: here its value is read again from the source, as the
# value of a jnz that leads back to the first line of the loop (wclose),
# and behind that the jump of the head lands. A round is thus one jump. The way
# back must have assigned what was assigned at the head, like a jump back
# to a label, and in the first pass over a function the loop is noted for
# alloc. At the test and after the loop, what is assigned is what the head
# had.
ifz dead
load p+8 as q
if q&(asg^-1)
call eunasgj
end
end
if pass==1
load p+32 as q
d=nloops*16+loops
store d q
store d+8 ip
nloops+=1
end
load p+8 as q
wasg=q
asg=q
dead=0
wbody=r
load p+32 as q
wip=ip
ip=q
p=exnm
store2 p 0x6e6a
storeb p+2 122
p=exnm
ns=p
nl=3
call kw as r
cur=r
ai=0
ncap=0
store opd 0
store opd+32 0
call xclass as d
xst=d
if d
call exinit
end
wend=1
jmp arg
end
call blktop as p
nblk-=1
load4 p+16 as d
if d
load4 p+20 as d
jnz d be3
end
load p+8 as q
if dead
asg=q
dead=0
jmp be3
end
asg&=q
label be3
xflg=16
call clrvk
dataend=0
jmp next

# "else": the block so far ends with a jump past the rest, and the jump of
# its "if" lands here
label elsedef
if nblk<=blkbase
call eplace
end
call eol
load (nblk-1)*40+blks+24 as d
if d
call eplace
end
call eb 233
r=op
call z 4
call blktop as p
load4 p+16 as d
if d
call eplace
end
store p r
q=p+8
load q as f
store q asg
store4 p+20 dead
store4 p+16 1
asg=f
dead=0
call clrvk
jmp next

# "while <value>": an if on the value, whose block ends with the value
# read again and a jump back to its first line while it holds. A
# jump reaches the loop, so what is known of the variables is forgotten, as
# at a label.
label whiledef
call blank1
call clrvk
dataend=0
whead=op
wsrc=ip
p=exnm
store2 p 0x6669
ns=p
nl=2
call kw as r
cur=r
ai=0
ncap=0
store opd 0
store opd+32 0
call xclass as d
xst=d
if d
call exinit
end
jmp arg

# ---- implicit exit(0), patch jumps, calls and sizes, write the ELF
label fin
if infn
call eend
end
if nblk
call eend
end
call cp exit0 9
rwstart=op-out+4095>>12<<12
call resolve
p=calls
r=ncalls
while r
call getn p
epos=ns
call lfn as c
if c==-1
call efn
end
c=c*40+funs
load4 p+24 as q
jeq q 0xffffffff c5
load c+24 as d
ifz d==q
call eargc
end
load c+32 as d
load4 p+28 as q
if q>d
call eresf
end
load c+16 as c
load p+16 as q
store4 q c-q-4
jmp c7
label c5
load c+16 as c
load p+16 as q
store4 q c-q-4
label c7
p+=32
r-=1
end
p=refs
r=nrefs
while r
load p+24 as f
if f==3
load p as q
q=q*8-8+rwstart
jmp r7
end
call getn p
epos=ns
call lbuf as c
if c==-1
call eund
end
call gent c as c
load c+32 as d
if d
call eund
end
load c+16 as q
load c+40 as d
ifz f
jnz d r7
q=q+ngv*8+rwstart
label r7
load p+16 as d
store4 d q-(d-out+4)
jmp r8
end
jnz f!=2 r6
jz d r6
load d*8+runend-8 as d
q=d-q
jmp r5
label r6
load c+24 as q
label r5
load p+16 as d
store4 d q
label r8
p+=32
r-=1
end
p=chks
r=nchks
while r
call getn p
load4 p+28 as d
epos=d+in
call lbuf as c
jeq c -1 k4
call gent c as c
load c+32 as d
jnz d k4
load c+40 as d
if d
load p+24 as q
if q&256
call eacc
end
load d*8+runend-8 as d
load c+16 as q
d-=q
jmp k6
end
load c+24 as d
label k6
load p+16 as q
if q>=d
call eacc
end
d-=q
loadb p+24 as q
jle q d k4
call eacc
label k4
p+=32
r-=1
end
epos=-1
q=op-out
store out+96 q
store out+104 q
store out+136 rwstart
store out+144 rwstart
c=ngv*8+bsssz
store out+160 c
if c+rwstart>0x7fffffff
call ebuf
end
p=out
label w1
sys write 1 p q as c
ifz c-1<q
call ewr
end
p+=c
q-=c
jnz q w1

# ---- the read-only tables are a file of their own, compiled here: a data
# name may be declared after its uses
use "compiler/tables.ai"
