# a task woken three times before it is polled is polled once, and a wake
# of a task that is done does nothing
use "lib/async/task.aiw"
var polls
fn poll t
	polls+=1
	load t+64 as n
	n+=1
	store t+64 n
	if n==2
		ret 1
	end
	ret 0
end
ref poll as p
call async 72 p as h
store h+64 0
# the first poll: the task waits
call asyncrun as n
x=polls*10+n
call asyncwake h
call asyncwake h
call asyncwake h
call asyncrun as n
x=x*10+polls
x=x*10+n
call asyncwake h
call asyncrun
x=x*10+polls
call await h 0
sys exit_group x-11000
