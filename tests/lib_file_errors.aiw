# errors are the negated numbers of the kernel: no such file, a directory
# that cannot be read or written as a file, a path that is too long
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
buf b 24
buf long 5000
call fileread "tests/lib/no-such-file" b as r
call putn 0-r
call print " "
call fileread "tests/lib" b as r
call putn 0-r
call print " "
call filewrite "tests/lib" "x" as r
call putn 0-r
call print " "
i=0
while i<4096
	storeb long+i 97
	i+=1
end
call fileread long 4096 b as r
call putn 0-r
call print " "
call fileread long 4095 b as r
call putn 0-r
load b+8 as n
call print "\n"
sys exit n
