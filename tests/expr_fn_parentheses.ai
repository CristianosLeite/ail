# parentheses group values that are computed when the program runs, in a function whose parameters are the values
fn f v0 v1 v2 v3 v4 v5 v6 v7
jne (v0+v1)*v2 20 f1
jne v0*(v1+v2) 14 f2
jne ((v0+v1))*((v2)) 20 f3
jne (v3+(v0*(v1+(v2)))) 15 f4
jne (v4) 7 f5
jne v5/(v0+v1) 4 f6
jne (v3<<v2)-(v3<<v0) 12 f7
jne (v0+v1)*(v2+v6)-(v7+v4)*(v3+v3) 19 f8
jne v0-(v1-(v2-(v6-(v7-v4)))) -3 f9
ret 0
label f1
ret 1
label f2
ret 2
label f3
ret 3
label f4
ret 4
label f5
ret 5
label f6
ret 6
label f7
ret 7
label f8
ret 8
label f9
ret 9
end
call f 2 3 4 1 7 20 5 6 as r
sys exit r
