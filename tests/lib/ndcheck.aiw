# tests/lib/ndcheck.aiw -- compare arrays with the results of
# tests/lib/ndfix.aiw; needs lib/std/io.aiw and lib/nd/array.aiw.

# make chkd an array of the numbers at chkp with chkr axes of the
# lengths chka, chkb and chkc; they are read-only
fn fix chkd chkp chkr chka chkb chkc
	local chks 24
	store chks chka
	store chks+8 chkb
	store chks+16 chkc
	chkn=1
	chki=0
	while chki<chkr
		load chks+chki*8 as chkx
		chkn*=chkx
		chki+=1
	end
	tail ndwrap chkd chkp chkn*8 chkr chks
end

# 1 if the doubles chkx and chky are the same bits, or differ by no
# more than 2^-40 of their sizes together. A difference that is no
# finite number is never near: that of an infinity and a number, or of
# two numbers too far apart for a double. Each size is made small
# before the two are added, so that the sum is finite too
fn near chkx chky
	if chkx==chky
		ret 1
	end
	fsub chkx chky as chkd
	chkd=chkd<<1>>1
	if chkd>=0x7ff0000000000000
		ret 0
	end
	fmul chkx<<1>>1 0x3d70000000000000 as chks
	fmul chky<<1>>1 0x3d70000000000000 as chkt
	fadd chks chkt as chks
	fle chkd chks as chkd
	ret chkd
end

# how many elements of chkd are not those of chkw: with chkm 0 the same
# bits, with 1 near, with 2 the same bits or both no number. Other
# lengths count as 99999
fn differ chkd chkw chkm
	local chka 176
	local chkb 176
	load chkd+16 as chkr
	load chkw+16 as chkx
	if chkr!=chkx
		ret 99999
	end
	chki=0
	while chki<chkr
		load chkd+48+chki*8 as chkx
		load chkw+48+chki*8 as chky
		if chkx!=chky
			ret 99999
		end
		chki+=1
	end
	call ndcopy chka chkd as chkx
	call ndcopy chkb chkw as chky
	ifz chkx&chky
		ret 99999
	end
	call ndsize chka as chkn
	load chka as chkp
	load chkb as chkq
	chkc=0
	chki=0
	while chki<chkn
		load chkp+chki*8 as chkx
		load chkq+chki*8 as chky
		chkt=chkx==chky
		if chkm==1
			call near chkx chky as chkt
		end
		if chkm==2
			if (chkx<<1>0xffe0000000000000)&(chky<<1>0xffe0000000000000)
				chkt=1
			end
		end
		chkc+=1-chkt
		chki+=1
	end
	call ndfree chka
	call ndfree chkb
	ret chkc
end
