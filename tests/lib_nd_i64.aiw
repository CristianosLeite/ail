# arrays of integers: the four operations element by element with rows
# and numbers broadcast, sums of all and along an axis, the dot product
# and the product of matrices, all in integers
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
use "lib/nd/elem.aiw"
use "lib/nd/reduce.aiw"
use "tests/lib/ndshow.aiw"
buf a 176
buf b 176
buf c 176
buf row 176
buf k 176
buf v 176
buf w 176
buf m 176
call ndmat a 2 3 as r
call ndkind a 2 as r
call ndmat b 2 3 as r
call ndkind b 2 as r
call ndmat c 2 3 as r
call ndkind c 2 as r
# 7 4 1 -2 -5 -8 and 1 2 3 4 5 6
call count a 7 -3
call count b 1 1
call ndadd c a b as s
call showi c
call ndsub c a b as t
call showi c
call ndmul c a b as u
call showi c
# the quotient is cut off towards 0: 7 2 0 0 -1 -1
call nddiv c a b as x
call showi c
# a row and a number, and a view with the columns backwards
call ndvec row 3 as r
call ndkind row 2 as r
call count row 10 10
call ndscalar k -2
call ndkind k 2 as r
call ndadd c a row as y
call showi c
call ndmul c c k as z
call showi c
call ndslice v a 1 0 3 -1 as d
call ndsub c v a as e
call showi c
call ndput c v as f
call showi c
# sums
call ndsum a as n g
call putn 0-n
call ndsumpw a as n h
call print " "
call putn 0-n
call print " "
call ndsumax row a 0 as l
call showi row
call ndvec w 2 as r
call ndkind w 2 as r
call ndsumax w a 1 as o
call showi w
# 7 4 1 times 1 2 3, and 2 by 3 times 3 by 2
call ndslice v a 0 0 1 1 as d
store v+16 1
store v+48 3
store v+112 8
call ndslice w b 0 0 1 1 as d
store w+16 1
store w+48 3
store w+112 8
call nddot v w as n p
call putn n
call print " "
call ndtrans v b as d
call ndmat m 2 2 as r
call ndkind m 2 as r
call ndmatmul m a v as q
call showi m
call ndfree a
call ndfree b
call ndfree c
call ndfree m
sys exit r+s+t+u+x+y+z+d+e+f+g+h+l+o+p+q
