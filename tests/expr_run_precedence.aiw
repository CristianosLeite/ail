# the operators bind in six steps when the values are variables too; exit status = the first check that fails
v0=2
v1=3
v2=4
v3=20
v4=6
v5=7
v6=1
v7=16
v8=5
v9=0
v10=64
v11=100
jne v0+v1*v2 14 f1
jne v0*v1+v2 10 f2
jne v3-v4/v0 17 f3
jne v5%v2*v0 6 f4
jne v6<<v0+v6 8 f5
jne v7>>v6+v6 4 f6
jne v6+v0<<v1 24 f7
jne v4&v1<<v6 6 f8
jne v5&v0+v6 3 f9
jne v8^v1&v6 4 f10
jne v4^v1&v0 4 f11
jne v2|v0^v0 4 f12
jne v6|v0&v2 1 f13
jne v6+v0==v1 1 f14
jne v0==v6+v6 1 f15
jne v1<v0+v0 1 f16
jne v6|v0==v0 0 f17
jne v8&v2!=v9 1 f18
jne v0*v1>=v4 1 f19
jne v5-v0-v6 4 f20
jne v10/v2/v0 8 f21
jne v11%v5%v1 2 f22
jne v6<<v0<<v1 32 f23
rt exit 0
