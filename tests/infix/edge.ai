# the fixture of tests/infix.sh for the lines at the edges of the rules;
# tests/infix/edge.out.ai is what the Python script made of it, which
# the tool was ported from. It is compared, not compiled.
# a line without a string is written anew: one space between its words,
# no CR at its end, also when nothing else changes
set 1 as x
	add	x  2 as y
  frob	x   y
# a no-break space separates words
set 3 as z
# a line with a string keeps every byte
sys  write 1 "a # b"	3
# negative numbers, and a minus that takes the next token along
set -5 as n
add n -1 as n
sub n 0x1F as n
# the comment keeps its column, or follows after two spaces
add x 1 as y            # short
sub x 1 as x # close
# two labels of one name: the last one counts
label twice
label twice
jz x out
sub x 1 as x
jmp twice
label out
# a line of 100 bytes is folded into, one of 101 is not
aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa=1
bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb=2
ccccccccccccccccccccccccccccccccccccc=3
dddddddddddddddddddddddddddddddddddddd=4
t=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa+bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
u=t+ccccccccccccccccccccccccccccccccccccc
t=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa+bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
v=t+dddddddddddddddddddddddddddddddddddddd
# what is no expression stays, and == makes no assignment
w=u+
w==v
x=u+v
sys exit x
