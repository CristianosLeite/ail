# a copy has storage of its own with the elements of a view one behind
# the other, also in place of the view or of the array; ndfill sets the
# elements of a view and no other
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
buf a 176
buf v 176
buf c 176
buf e 176
buf sh 24
fn show d
	call ndsize d as n
	load d as p
	i=0
	while i<n
		load p+i*8 as x
		call putn x
		call print " "
		i+=1
	end
	call print "\n"
end
call ndmat a 3 4 as r
load a as p
i=0
while i<12
	store p+i*8 i
	i+=1
end
# the columns 3 and 1 as rows
call ndslice v a 1 0 4 -2 as s
call ndtrans v v as t
call ndcopy c v as u
call show c
load c+40 as o
load c+48 as n
load c+56 as m
load c+120 as f
call ndcontig c as g
load c as q
call putn o
call putn n
call putn m
call putn f
call putn g+(q!=p)
call print "\n"
# the view filled: the array has the value there and nowhere else
call ndfill v 9
call show a
# a copy in place of the view, and of the array, whose storage is freed
call ndcopy v v as h
load v+40 as o
call putn o
call ndslice a a 0 2 3 1 as k
call ndcopy a a as l
call show a
# three axes, the middle one from the top downwards
store sh 2
store sh+8 3
store sh+16 2
call ndnew e 3 sh as w
load e as p
i=0
while i<12
	store p+i*8 i
	i+=1
end
call ndslice e e 1 0 3 -1 as x
call ndcopy e e as y
call show e
# no element, and no array
call ndslice e e 0 1 1 1 as z
call ndcopy e e as b
call ndsize e as n
call ndcopy c sh+16 as d
call putn n+d
call print "\n"
call ndfree a
call ndfree v
call ndfree c
call ndfree e
sys exit r+s+t+u+h+k+l+w+x+y+z+b
