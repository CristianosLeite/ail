# variables 7 and 8 passed in every argument register
set 1 as a
set 1 as b
set 1 as c
set 1 as d
set 1 as e
set 1 as f
set 4 as g
set "wxyz" as h
fn sum p q r s t u
add p q as p
add p r as p
add p s as p
add p t as p
add p u as p
ret p
end
call sum g g g g g g as x
sys 1 1 h g 0 0 g as n
add x n as x
sys 60 x
