# a child ended where the kernel has no descriptor to give for it: with
# a limit of three open files, a child that sleeps is ended by its
# number and reap gives -9 for it. In a process that ignores the signal
# of its children the kernel takes a child that ends, and its number
# may be another process then: no signal is sent, the result is the
# error that kept the descriptor away, -24, and the child, which still
# runs, is ended once the signal is not ignored any more. A child that
# another thread waits for in reap is sent no signal either, -24, and
# is ended by a descriptor once the limit is as it was, which that
# reap then gives -9 for
const getrlimit 97
const setrlimit 160
buf exe 4096
buf argv 24
buf io 24
buf lim 16
buf act 32
buf res 8
buf done 8
data slow "s" 0
fn work v
	rt reap v 0 as r
	store res r
	store done 1
	rt wake done 1
end
args as p
load p as n
if n>1
	rt sleep 60000000000
	rt exit 5
end
rt self exe 4095 as e
storeb exe+e 0
store argv exe
store argv+8 slow
store io -1
store io+8 -1
store io+16 -1
rt start argv 0 io 0 as c1
rt start argv 0 io 0 as c2
rt start argv 0 io 0 as c3
sys getrlimit 7 lim as g
load lim as soft
store lim 3
sys setrlimit 7 lim as s
rt kill c1 as k1
rt reap c1 0 as r1
x=(c1>0)&(c2>0)&(g==0)&(s==0)&(k1==0)&(r1==-9)
store act 1
sys rt_sigaction 17 act 0 8 as a1
rt kill c2 as k2
store act 0
sys rt_sigaction 17 act 0 8 as a2
rt kill c2 as k3
rt reap c2 0 as r3
x+=((a1==0)&(k2==-24)&(a2==0))*2+((k3==0)&(r3==-9))*4
ref work as f
rt thread f c3 as t
rt sleep 50000000
rt kill c3 as k4
store lim soft
sys setrlimit 7 lim as s2
rt kill c3 as k5
d=0
while d==0
	rt wait done 0 -1
	load done as d
end
load res as r5
x+=((c3>0)&(t==0)&(k4==-24)&(s2==0)&(k5==0)&(r5==-9))*8
rt exit x
