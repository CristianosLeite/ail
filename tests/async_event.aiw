# an event is not polled: a task that awaits it waits until asyncfinish,
# and until then nothing can happen
use "lib/async/task.aiw"
fn poll t
	load t+64 as e
	call await e t as v r
	ifz r
		ret 0
	end
	store t+16 v+1
	ret 1
end
call async 64 0 as e
ref poll as p
call async 72 p as h
store h+64 e
call asyncrun as n
call asyncfinish e 7 as a
call asyncfinish e 9 as b
call asyncrun as m
call await h 0 as x
sys exit_group n*100+m*50+a*20+b*10+x
