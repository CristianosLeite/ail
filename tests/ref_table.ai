# functions in a table, chosen by a number at run time
fn zero
ret 10
end
fn one
ret 20
end
fn two
ret 30
end
buf t 24
ref zero as p
store t p
ref one as p
add t 8 as q
store q p
ref two as p
add t 16 as q
store q p
sys 39 as i
and i 0 as i
add i 2 as i
mul i 8 as i
at t i 8 as q
load q as p
callp p as r
sys 60 r
