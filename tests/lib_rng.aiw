# splitmix64: the first numbers of the seed 1234567 are the published
# ones, numbers below a limit are below it and all occur, and the same
# seed gives the same numbers again
use "lib/std/io.aiw"
use "tools/lib/rng.aiw"
buf s 8
buf t 8
buf seen 8
call rngseed s 1234567
i=0
while i<3
	call rngnext s as x
	call putn x
	call print "\n"
	i+=1
end
call rngseed s 42
call rngseed t 42
i=0
n=0
while i<100000
	call rngbelow s 6 as x
	call rngbelow t 6 as y
	n+=x
	ok=x==y
	if x>5
		ok=0
	end
	ifz ok
		rt exit 1
	end
	storeb seen+x 1
	i+=1
end
call putn n
call print " "
load seen as x
call putn x==0x010101010101
call rngbelow s 1 as x
call putn x
call print "\n"
# a shuffle keeps the numbers and is the same for the same seed
buf a 80
buf c 80
i=0
while i<10
	store a+i*8 i
	store c+i*8 i
	i+=1
end
call rngseed s 77
call rngseed t 77
call rngshuffle s a 10
call rngshuffle t c 10
i=0
n=0
m=0
while i<10
	load a+i*8 as x
	load c+i*8 as y
	call putn x
	n+=1<<x
	m+=x==y
	i+=1
end
call print " "
call putn n
call print " "
call putn m
call print "\n"
