# open with 0x200000, on Linux: what is at a path is opened only to be
# asked what it is. A directory that the process may enter and may not
# read is opened so, with 0x10000 or without, and is the directory of
# an openat that opens and reads a file below it; its names are not
# read, and it is not read. A file opened so is asked what it is and
# which path it has, and is not read. Nothing is made with 64, and
# what is not there is -2.
buf b 512
buf st 32
data dir "build/tests/rt_open_look.d"
len dir as n
rt unlink "build/tests/rt_open_look.d/f"
rt unlink "build/tests/rt_open_look.d/none"
rt rmdir dir n
rt mkdir dir n 448
rt open dir n 0x10000 0 as d
rt openat d "f" 65 420 as f
rt write f "hi\n" as w
rt close f
# to be entered and written to, and not read
rt chmod d 192 as c
rt open dir n 0x210000 0 as l
rt fstat l st as r
load st as kind
rt openat l "f" 0 0 as f
rt read f b 512 as k
rt close f
x=(d>2)&(w==3)&(c==0)&(l>2)&(r==0)&(kind==2)&(f>2)&(k==3)
rt names l b 512 as e1
rt read l b 512 as e2
rt close l as c
x+=((e1==-9)&(e2==-9)&(c==0))*2
rt open "build/tests/rt_open_look.d/f" 0x200000 0 as l
rt fstat l st as r
load st as kind
rt read l b 512 as e1
rt fdpath l b 512 as p
rt close l
x+=((l>2)&(r==0)&(kind==1)&(e1==-9)&(p>26)&(p<512))*4
rt open dir n 0x200000 0 as l
rt fstat l st as r
load st as kind
rt openat l "f" 0 0 as f
rt close f as c
rt close l
x+=((l>2)&(r==0)&(kind==2)&(f>2)&(c==0))*8
rt open "build/tests/rt_open_look.d/none" 0x200000 0 as e1
rt open "build/tests/rt_open_look.d/none" 0x200040 420 as e2
rt kind "build/tests/rt_open_look.d/none" as e3
x+=((e1==-2)&(e2==-2)&(e3==-2))*16
rt chmod d 448 as c
rt close d
rt unlink "build/tests/rt_open_look.d/f" as u1
rt rmdir dir n as u2
x+=((c|u1|u2)==0)*32
rt exit x
