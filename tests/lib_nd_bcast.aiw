# arrays with fewer axes or with an axis of length 1 go with every index
# of the result there: a row with every row, a column with every
# column, one number with all, and what has no element gives none
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
use "lib/nd/elem.aiw"
use "tests/lib/ndshow.aiw"
buf a 176
buf row 176
buf col 176
buf c 176
buf k 176
buf e 176
buf sh 24
call ndmat a 2 3 as r
call ramp a 0 4
call ndvec row 3 as r
call ramp row 40 40
call ndmat col 2 1 as r
call ramp col 400 400
call ndmat c 2 3 as r
# 0 1 2 3 4 5 plus 10 20 30 in every row
call ndadd c a row as s
call show c
# plus 100 in the first row and 200 in the second
call ndadd c a col as t
call show c
# a row and a column alone make the table
call ndadd c row col as u
call show c
# a number on either side
itof 2 as x
call ndscalar k x
call ndmul c a k as v
call show c
call ndsub c k a as w
call show c
call ndput c k as y
call show c
# the same into a view with a step, from a view of the row backwards
call ndslice e c 1 0 3 2 as z
call ndslice row row 0 1 3 -1 as b
call ndadd e row k as d
call show c
# three axes: 2 pages of 1 row of 3 with 2 rows of 1
store sh 2
store sh+8 1
store sh+16 3
call ndreshape a a 3 sh as f
call ndfree c
store sh+8 2
call ndnew c 3 sh as g
call ndadd c a col as h
call show c
# no element: nothing is written and that is no error
call ndfree c
call ndmat c 0 3 as l
call ndvec row 3 as m
call ndadd c c row as n
call ndsize c as o
call putn o
call print "\n"
rt exit r+s+t+u+v+w+y+z+b+d+f+g+h+l+m+n
