# the services of sockets and of a poller, with nothing of lib/async: a
# socket that listens, one that connects to it, the poller telling when
# each may go on, bytes one way, and the errors of a closed end
buf ev 64
buf b 8
rt poller as ep
rt listen 0x7f000001 0 16 as l
rt port l as port
rt watch ep l 1 100 as w1
rt accept l as none
rt socket as c
rt watch ep c 3 200 as w2
rt connect c 0x7f000001 port as k
# the poller says when the connection is there, on both sockets
got=0
while got!=3
	rt poll ep ev 4 2000 as n
	if n>4
		rt exit 99
	end
	ifz n
		rt exit 98
	end
	i=0
	while i<n
		load ev+i*16+8 as tag
		got|=(tag==100)+(tag==200)*2
		i+=1
	end
end
rt sockerr c as e
rt accept l as s
rt send c "hi" as sent
rt read s b 8 as r
rt write 1 b r
rt write 1 "\n"
rt close s
rt sleep 20000000
rt send c "x" as p1
rt send c "x" as p2
rt send 1 "x" as nosock
rt poll ep ev 4 0 as idle
rt unwatch ep c as u
rt close c
rt close l
rt close ep
rt exit (none==-11)+(w1==0)*2+(w2==0)*4+((k==0)|(k==-115))*8+(e==0)*16+(sent==2)*32+(p2==-32)*64+(nosock==-88)*128
