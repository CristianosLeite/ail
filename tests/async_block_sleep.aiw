# four pieces of work that each sleep in the kernel for 50 milliseconds
# take one such time together, and a task with a timer goes on meanwhile
use "lib/std/task.aiw"
use "lib/async/task.aiw"
use "lib/async/time.aiw"
use "lib/async/io.aiw"
use "lib/async/pool.aiw"
var ticks done
fn nap ms b c d
	local ts 16
	store ts 0
	store ts+8 ms*1000000
	sys nanosleep ts 0
	ret ms
end
async fn tick
	while done==0
		await asyncsleep 5
		ticks+=1
	end
end
call workers 4
call asyncclock as t0
call tick as t
ref nap as p
call asyncblock p 50 0 0 0 as a
call asyncblock p 50 0 0 0 as b
call asyncblock p 50 0 0 0 as c
call asyncblock p 50 0 0 0 as d
await a as x
await b as y
await c
await d
done=1
call asyncclock as t1
await t
call asyncrun as n
ms=(t1-t0)/1000000
rt exit (ms<45)+(ms>150)*2+(ticks<5)*4+n*8+x+y
