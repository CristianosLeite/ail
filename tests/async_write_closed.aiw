# writing where nobody reads any more is the result -32, not the end of
# the program: to a socket whose other side is closed, and to a pipe
# whose reading end is; the signal is neither left pending nor blocked
# afterwards, and a write to a plain file is a write
use "lib/std/io.aiw"
use "lib/async/task.aiw"
use "lib/async/time.aiw"
use "lib/async/io.aiw"
buf sa 32
buf fds 8
buf m 16
data null "/dev/null" 0
# the signal ends a process, whatever the one that started this left
sys rt_sigaction 13 sa 0 8
call asynclisten 0x7f000001 0 as l
call asyncport l as port
call asyncaccept l as ha
await asyncconnect 0x7f000001 port as c
await ha as s
call asyncclose s
await asyncsleep 20
await asyncwrite c "x" as r1
await asyncwrite c "x" as r2
await asyncwriteall c "xyz" as r3
call putn 0-r2
call print " "
call putn 0-r3
call print " "
sys pipe fds
load4 fds as rd
load4 fds+4 as wr
sys close rd
await asyncwrite wr "x" as r
await asyncwriteall wr "xyz" as q
call putn 0-r
call print " "
call putn 0-q
call print " "
sys asyncsigmask 0 0 m 8
load m as blocked
store m+8 0
store m 4096
sys asyncsigwait m 0 sa 8 as pending
call putn blocked
call putn pending==-11
call print " "
sys open null 1 as f
await asyncwriteall f "abc" as w
call putn w
call print "\n"
