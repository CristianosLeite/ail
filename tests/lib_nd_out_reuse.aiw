# one array is the result of one operation after another and nothing is
# allocated for them: the storage stays where it is
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
use "lib/nd/elem.aiw"
use "tests/lib/ndshow.aiw"
buf a 176
buf b 176
buf t 176
buf k 176
call ndmat a 100 100 as r
call ndmat b 100 100 as r
call ndmat t 100 100 as r
call ramp a 0 4
call ramp b 4 0
itof 2 as x
call ndscalar k x
load t as p
# t = ((a + b) * 2 - a) / 2 = a / 2 + 1, a thousand times
i=0
s=0
while i<1000
	call ndadd t a b as u
	call ndmul t t k as v
	call ndsub t t a as w
	call nddiv t t k as y
	s+=u+v+w+y
	i+=1
end
load t as q
load p as x
call showx x
load p+79992 as x
call showx x
call putn s
call print "\n"
call ndfree a
call ndfree b
call ndfree t
sys exit r+(p==q)
