# a new array has its lengths, the strides of elements one behind the
# other, storage of its own that is all zero, and an axis without
# elements gives none; no axis is one element, nine are refused
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
buf a 176
buf sh 72
fn show n
	call putn n
	call print " "
end
fn field a o
	load a+o as x
	tail show x
end
store sh 2
store sh+8 3
store sh+16 4
call ndnew a 3 sh as r
call field a 8
call field a 16
call field a 32
call field a 40
call field a 112
call field a 120
call field a 128
call field a 136
call ndsize a as n
call show n
load a as p
load a+24 as q
s=0
i=0
while i<n
	load p+i*8 as x
	s|=x
	i+=1
end
call show s+(p!=q)
call ndfree a
store sh+8 0
call ndnew a 3 sh as t
call field a 112
call field a 120
call field a 32
call ndsize a as n
call show n
call ndfree a
call ndnew a 0 sh as u
call field a 16
call field a 32
call ndsize a as n
call show n
call ndfree a
call ndvec a 5 as v
call field a 48
call field a 112
call ndfree a
call ndmat a 3 7 as w
call field a 48
call field a 56
call field a 112
call ndfree a
call ndnew a 9 sh as x
load a+8 as y
call show x+y
call print "\n"
sys exit r+t+u+v+w
