# ifz with a comparison as its value, for a smaller, an equal and a larger left side,
# also where the order is only right unsigned; exit status = the first wrong one
a=3
b=5
ifz a==b
else
sys exit 1
end
ifz a!=b
sys exit 2
else
end
ifz a<b
sys exit 3
else
end
ifz a<=b
sys exit 4
else
end
ifz a>b
else
sys exit 5
end
ifz a>=b
else
sys exit 6
end
