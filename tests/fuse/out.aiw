# the fixture of tests/tools.sh for tools/fuse.aiw: every rewrite, and the
# lines that must stay as they are; the program exits with 27
var g
buf b 16
fn pick a b
	iflt a b
		ret a
	end
	ret b
end
fn count n
	set 0 as i
	set 0 as s
	label more
	iflt i n
		and i 1 as o
		ifne o 0
			add s i as s
		end
		add i 1 as i
		jmp more
	end
	ret s
end
fn kept a
	# the result is read after the jump: the pair stays
	eq a 3 as t
	if t
		ret t
	end
	add t 5 as t
	ret t
end
set 7 as x
call pick x 9 as y
call count 6 as z
# a var is no temporary
eq y 7 as g
if g
	add y z as y
end
# two jumps to one label: no block
jge y 100 out
jle y 5 out
add y 1 as y
label out
# a comment between the jump and its label: no block
jeq y 0 far
# here
add y 2 as y
label far
# blocks nest
if y
	if x
		add y 1 as y
	end
	add y 1 as y
end
# a string keeps its text, a state label of the compiler stays a label
store b "a # b"
jz x next
add y 0 as y
label next
call kept 3 as k
call kept 4 as m
add y k as y
add y m as y
sys exit y
