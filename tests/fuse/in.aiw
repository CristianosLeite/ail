# the fixture of tests/tools.sh for tools/fuse.aiw: every rewrite, and the
# lines that must stay as they are; the program exits with 27
var g
buf b 16
fn pick a b
lt a b as t
jz t other
ret a
label other
ret b
end
fn count n
set 0 as i
set 0 as s
label more
ge i n as t
jnz t done
and i 1 as o
eq o 0 as t
jnz t even
add s i as s
label even
add i 1 as i
jmp more
label done
ret s
end
fn kept a
# the result is read after the jump: the pair stays
eq a 3 as t
jz t no
ret t
label no
add t 5 as t
ret t
end
set 7 as x
call pick x 9 as y
call count 6 as z
# a var is no temporary
eq y 7 as g
jz g skip
add y z as y
label skip
# two jumps to one label: no block
lt y 100 as t
jz t out
gt y 5 as t
jz t out
add y 1 as y
label out
# a comment between the jump and its label: no block
ne y 0 as t
jz t far
# here
add y 2 as y
label far
# blocks nest
jz y a1
jz x a2
add y 1 as y
label a2
add y 1 as y
label a1
# a string keeps its text, a state label of the compiler stays a label
store b "a # b"
jz x next
add y 0 as y
label next
call kept 3 as k
call kept 4 as m
add y k as y
add y m as y
sys exit y
