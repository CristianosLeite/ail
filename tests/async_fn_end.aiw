# an async function that reaches its end has the result 0; one without
# parameters and one with six
use "lib/async/task.aiw"
var sum
async fn none
	sum+=1
end
async fn six a b c d e f
	sum+=a+b*2+c*3+d*4+e*5+f*6
end
call none as h
call six 1 2 3 4 5 6 as g
call await g 0 as x
call await h 0 as y
sys exit_group sum+x+y
