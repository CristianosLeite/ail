# a minus sign before a digit, where a value is expected, is a negative number
jne 2+-1 1 f1
jne 5--3 8 f2
jne -4+6 2 f3
jne (-4)+6 2 f4
jne 3*-2 -6 f5
jne -0x10+17 1 f6
jne -1<0 0 f7
jne 0-(-7) 7 f8
rt exit 0
label f1
rt exit 1
label f2
rt exit 2
label f3
rt exit 3
label f4
rt exit 4
label f5
rt exit 5
label f6
rt exit 6
label f7
rt exit 7
label f8
rt exit 8
