# the comparisons are unsigned and give 1 or 0
jne 3<5 1 f1
jne 5<3 0 f2
jne 3<=3 1 f3
jne 4<=3 0 f4
jne 5>3 1 f5
jne 3>3 0 f6
jne 3>=3 1 f7
jne 2>=3 0 f8
jne 6==6 1 f9
jne 6==7 0 f10
jne 6!=7 1 f11
jne 6!=6 0 f12
jne 0-1>1 1 f13
jne (1<2)+(2<3) 2 f14
sys exit 0
label f1
sys exit 1
label f2
sys exit 2
label f3
sys exit 3
