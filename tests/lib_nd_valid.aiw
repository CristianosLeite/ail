# ndvalid says whether 176 bytes written by hand are an array whose
# elements all lie in its storage: every view the library makes is one,
# a stride or a start that leads out of the storage is not
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
buf a 176
buf v 176
buf m 176
buf g 80
buf sh 16
call ndmat a 3 4 as r
call ndvalid a as s
call ndslice v a 0 0 3 -2 as t
call ndtrans v v as t
call ndvalid v as u
call ndvalid m as w
# 5 elements two words apart in 10 words, from the first and backwards
# from the last but one
store m g
store m+8 1
store m+16 1
store m+24 g
store m+32 80
store m+48 5
store m+112 16
call ndvalid m as x
store m g+64
store m+112 -16
call ndvalid m as y
# a sixth, a start before the storage, one element too far, nine axes
store m+48 6
call ndvalid m as b
store m+48 5
store m g+56
call ndvalid m as c
store m g+80
call ndvalid m as d
store m+16 9
call ndvalid m as e
# no element reaches nothing
store m+16 1
store m+48 0
call ndvalid m as f
call putn b+c+d+e+w
call print "\n"
call ndfree a
rt exit r+s+t+u+x+y+f
