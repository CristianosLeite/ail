# a read against its limit and against cancel: bytes that come before
# the time is up are the result and the timer is gone; a read that was
# cancelled or ran out of time leaves the bytes that come later to the
# next read
use "lib/std/io.aiw"
use "lib/async/task.aiw"
use "lib/async/time.aiw"
use "lib/async/io.aiw"
buf rb 16
call asynclisten 0x7f000001 0 as l
call asyncport l as port
call asyncaccept l as ha
call asyncconnect 0x7f000001 port as hc
call await hc 0 as c
call await ha 0 as s
call asyncclock as t0
# bytes before the time is up
call asyncread s rb 16 as h
call asynctimeout h 5000 as g
call asyncwrite c "ab" as hw
call await hw 0
call await g 0 as x
call putn x
# the time is up, then the bytes come
call asyncread s rb 16 as h
call asynctimeout h 10 as g
call await g 0 as x
call print " "
call putn 0-x
call asyncwrite c "cde" as hw
call await hw 0
call asyncread s rb 16 as h
call await h 0 as x
call putn x
# cancelled, then the bytes come
call asyncread s rb 16 as h
call asynccancel h as a
call await h 0 as x
call print " "
call putn 0-x
call putn a
call asyncwrite c "f" as hw
call await hw 0
call asyncread s rb 16 as h
call asynccancel h as a
call await h 0 as x
call putn x
call putn a
# two reads wait: the first gets the bytes, the second the end
call asyncread s rb 8 as h1
call asyncread s rb+8 8 as h2
call asyncwrite c "gh" as hw
call await hw 0
call asyncclose c
call await h1 0 as x
call await h2 0 as y
call print " "
call putn x
call putn y
call asyncclose s
call asyncclose l
call asyncrun as n
call asyncclock as t1
call print " "
call putn n
call print "\n"
rt exit t1-t0>1000000000
