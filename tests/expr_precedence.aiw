# the operators bind in six steps, * / % tightest and the comparisons last; exit status = the first check that fails
jne 2+3*4 14 f1
jne 2*3+4 10 f2
jne 20-6/2 17 f3
jne 7%4*2 6 f4
jne 1<<2+1 8 f5
jne 16>>1+1 4 f6
jne 1+2<<3 24 f7
jne 6&3<<1 6 f8
jne 7&2+1 3 f9
jne 5^3&1 4 f10
jne 6^3&2 4 f11
jne 4|2^2 4 f12
jne 1|2&4 1 f13
jne 1+2==3 1 f14
jne 2==1+1 1 f15
jne 3<2+2 1 f16
jne 1|2==2 0 f17
jne 5&4!=0 1 f18
jne 2*3>=6 1 f19
jne 7-2-1 4 f20
jne 64/4/2 8 f21
jne 100%7%3 2 f22
jne 1<<2<<3 32 f23
rt exit 0
label f1
rt exit 1
