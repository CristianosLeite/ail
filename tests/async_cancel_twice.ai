# a cancelled task that awaits again after it was told is ended there:
# the lines behind that await never run, and its result is -125. A task
# that nobody awaits is told and ended the same way.
use "lib/io.ai"
use "lib/async/task.ai"
use "lib/async/time.ai"
var after
async fn stubborn
	while 1
		await asyncsleep 1 as r
		if r==-125
			call print "told "
		end
	end
end
async fn again
	await asyncsleep 5000 as r
	call print "one "
	await asyncsleep 5000 as r
	after=1
	ret 9
end
call stubborn as h
call again as g
await asyncsleep 5
call asynccancel h
call asynccancel g
await h as x
await g as y
call asyncrun as n
call putn 0-x
call print " "
call putn 0-y
call print " "
call putn n+after
call print "\n"
