# a directory is made once, holds a file, cannot be removed while it
# does, and is gone after the file and it are removed
use "lib/io.ai"
use "lib/bytes.ai"
use "lib/file.ai"
fn show x
ifslt x 0
call print "-"
x=0-x
end
call putn x
call print " "
end
call filemkdir "build/tests/lib_file_dirs.d" 493 as r
call show r
call filemkdir "build/tests/lib_file_dirs.d" 493 as r
call show r
call filewrite "build/tests/lib_file_dirs.d/f" "x" as r
call show r
call filermdir "build/tests/lib_file_dirs.d" as r
call show r
call fileunlink "build/tests/lib_file_dirs.d/f" as r
call show r
call fileunlink "build/tests/lib_file_dirs.d/f" as r
call show r
call filermdir "build/tests/lib_file_dirs.d" as r
call show r
call filermdir "build/tests/lib_file_dirs.d" as r
call show r
call print "\n"
