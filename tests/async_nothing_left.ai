# awaiting, outside a task, what nothing will end gives -35 and keeps the
# handle; so does awaiting without a task of one's own inside a poll.
# The result of no task is 0.
use "lib/async/task.ai"
var inner
fn poll t
call async 64 0 as e
call await e 0 as v r
inner=v+r
ret 1
end
call async 64 0 as e
call await e 0 as x r
a=x+35+r
call asyncfinish e 4
call await e 0 as x r
a=a*10+x+r
ref poll as p
call async 64 p as h
call await h 0
a=a*10+inner+35
call await 0 0 as x r
sys exit_group a*10+x+r
