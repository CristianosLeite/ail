# a child of procheld ends when the process that started it is killed,
# and a child of procstart goes on. A process in the middle starts
# /bin/sleep with the writing end of a pipe as its stdout, writes the
# number of that child to the pipe and waits to be killed; this one
# reads the number, kills the middle and then reads the pipe, which
# ends only when the child is gone, the last to hold its writing end.
use "lib/std/io.aiw"
use "lib/std/proc.aiw"
const pipe2 293
const pause 34
const poll 7
data sleep "/bin/sleep" 0
data t30 "30" 0
buf av 32
buf pp 8
buf num 8
buf pf 8
# held: start the child with procheld (1) or procstart (0); the result
# is 1 if the pipe ended within ms milliseconds of the kill
fn try held ms
	sys pipe2 pp 0
	load4 pp as rd
	load4 pp+4 as wr
	sys fork as mid
	ifz mid
		sys close rd
		if held
			call procheld av -1 wr -1 as p
		else
			call procstart av -1 wr -1 as p
		end
		store num p
		sys write wr num 8
		sys close wr
		while 1
			sys pause
		end
	end
	sys close wr
	sys read rd num 8 as r
	load num as child
	sys kill mid 9
	call procwait mid 0 as st
	store4 pf rd
	store4 pf+4 1
	sys poll pf 1 ms as r
	ended=0
	if r
		sys read rd num 8 as k
		ended=k==0
	end
	ifz ended
		# it is still there, and is not left behind by the test
		sys kill child 9 as k
		call putn 0-k
		call print " for the kill of the child that went on; "
	end
	sys close rd
	ret st ended
end
store av sleep
store av+8 t30
call try 1 5000 as st ended
call print "procheld: the middle ended by signal "
call putn 0-st
call print ", the child with it "
call putn ended
call print "\n"
call print "procstart: "
call try 0 300 as st ended
call print "the middle ended by signal "
call putn 0-st
call print ", the child with it "
call putn ended
call print "\n"
