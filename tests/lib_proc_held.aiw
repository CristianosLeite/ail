# a child of procheld ends when the process that started it is killed,
# and a child of procstart goes on. A process in the middle starts
# /bin/sleep with the writing end of a pipe as its stdout, writes the
# number of that child to the pipe and waits to be killed; this one
# reads the number, kills the middle and then reads the pipe, which
# ends only when the child is gone, the last to hold its writing end.
# Then a process that has denied itself that request of prctl, with a
# filter of system calls, starts the program with procheld: the child
# ends with status 127 and the program did not run.
use "lib/std/io.aiw"
use "lib/std/proc.aiw"
const pipe2 293
const pause 34
const poll 7
const prctl 157
buf filt 48
buf prog 16
data sleep "/bin/sleep" 0
data t30 "30" 0
buf av 32
buf pp 8
buf num 8
buf pf 8
# held: start the child with procheld (1) or procstart (0); the result
# is 1 if the pipe ended within ms milliseconds of the kill
fn try held ms
	sys pipe2 pp 0
	load4 pp as rd
	load4 pp+4 as wr
	sys fork as mid
	ifz mid
		rt close rd
		if held
			call procheld av -1 wr -1 as p
		else
			call procstart av -1 wr -1 as p
		end
		store num p
		rt write wr num 8
		rt close wr
		while 1
			sys pause
		end
	end
	rt close wr
	rt read rd num 8 as r
	load num as child
	sys kill mid 9
	call procwait mid 0 as st
	store4 pf rd
	store4 pf+4 1
	sys poll pf 1 ms as r
	ended=0
	if r
		rt read rd num 8 as k
		ended=k==0
	end
	ifz ended
		# it is still there, and is not left behind by the test
		sys kill child 9 as k
		call putn 0-k
		call print " for the kill of the child that went on; "
	end
	rt close rd
	ret st ended
end
# deny: in a process of its own, make prctl(PR_SET_PDEATHSIG) fail with
# EPERM and start the program with procheld; what procwait says of the
# child, or -2000 when the filter could not be put in place
fn deny
	sys fork as mid
	ifz mid
		# the number of the call; if it is prctl, its first argument; if
		# that is 1, the error 1, and else the call goes on
		store4 filt 32
		store4 filt+4 0
		store4 filt+8 21+3*16777216
		store4 filt+12 prctl
		store4 filt+16 32
		store4 filt+20 16
		store4 filt+24 21+16777216
		store4 filt+28 1
		store4 filt+32 6
		store4 filt+36 327681
		store4 filt+40 6
		store4 filt+44 2147418112
		store prog 6
		store prog+8 filt
		# PR_SET_NO_NEW_PRIVS, then PR_SET_SECCOMP with a filter
		sys prctl 38 1 0 0 0 as r
		ifz r
			sys prctl 22 2 prog 0 0 as r
		end
		if r
			rt exit 99
		end
		call procheld av -1 -1 -1 as p
		call procwait p 5000 as st
		if st==127
			rt exit 0
		end
		rt exit 1
	end
	call procwait mid 8000 as st
	ret st
end
store av sleep
store av+8 t30
call try 1 5000 as st ended
call print "procheld: the middle ended by signal "
call putn 0-st
call print ", the child with it "
call putn ended
call print "\n"
call print "procstart: "
call try 0 300 as st ended
call print "the middle ended by signal "
call putn 0-st
call print ", the child with it "
call putn ended
call print "\n"
call deny as st
call print "prctl denied: "
if st==0
	call print "the child ended with status 127\n"
else
	if st==99
		call print "the filter could not be put in place\n"
	else
		call print "the program was started\n"
	end
end
