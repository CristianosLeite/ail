# a program named without a slash is looked for in PATH, and one that is
# nowhere ends with 127; the child has the environment of this process
use "lib/io.ai"
use "lib/proc.ai"
data sh "sh" 0
data c "-c" 0
data s "test -n \x22$PATH\x22 && exit 5" 0
data none "no-such-program-of-ail" 0
buf av 32
store av sh
store av+8 c
store av+16 s
call procstart av -1 -1 -1 as p
call procwait p 5000 as r
call putn r
call print " "
store av none
store av+8 0
call procstart av -1 -1 -1 as p
call procwait p 5000 as r
call putn r
call print " "
call procvar "PATH" as q n
call putn (q!=0)&(n!=0)
call procvar "NO_SUCH_VARIABLE_OF_AIL" as q n
call putn q+n
call procvar "PAT" as q n
call putn q+n
call print "\n"
