# the process is bound to one processor it may run on, also when the one
# asked for is none of them, and the clock goes forward
use "lib/io.ai"
use "lib/proc.ai"
buf m 128
call procnow as t
call procpin 100000 as c
sys sched_getaffinity 0 128 m as r
n=0
i=0
while i<1024
	loadb m+i/8 as b
	n+=b>>(i&7)&1
	i+=1
end
loadb m+c/8 as b
call procpin c as d
call procnow as u
call putn n
call putn b>>(c&7)&1
call putn c==d
call putn u>t
call print "\n"
