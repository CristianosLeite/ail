# calls of short functions are compiled in place: each must do what the
# call did
use "lib/std/io.aiw"
var g
fn two a b
	ret a+b a*b
end
fn none a
	a+=1
end
fn pick a b
	if a<b
		ret a
	else
		ret b
	end
end
fn first p n k
	i=0
	while i<n
		load p+i*8 as x
		if x==k
			ret i
		end
		i+=1
	end
	ret n
end
fn clamp x lo hi
	jlt x lo a
	jgt x hi b
	ret x
	label a
	ret lo
	label b
	ret hi
end
fn bump x
	x+=1
	x*=2
	ret x
end
fn sum3 a b c
	ret a+b+c
end
fn fact n
	r=1
	label l
	jz n e
	r*=n
	n-=1
	jmp l
	label e
	ret r
end
fn say n
	rt write 1 "say "
	ret n+1
end
fn inner a
	ret a*3
end
fn outer a
	call inner a as b
	ret b+1
end
fn out n
	call putn n
	call print " "
end
buf t 64
fn run
	local w 16
	# two results, fewer names, none
	call two 3 4 as a b
	call out a
	call out b
	call two 5 6 as a
	call out a
	call two 7 8
	# the end reached without ret gives 0, and the argument stays
	x=41
	call none x as a
	call out a
	call out x
	# ret in both parts of a block
	call pick 3 9 as a
	call pick 9 2 as b
	call out a
	call out b
	# ret in a loop, a hit and a miss
	store t 5
	store t+8 6
	store t+16 7
	call first t 3 6 as a
	call first t 3 8 as b
	call out a
	call out b
	# labels, twice in one function
	call clamp 5 10 20 as a
	call clamp 15 10 20 as b
	call clamp 25 10 20 as c
	call out a
	call out b
	call out c
	# a parameter the body assigns is a copy
	x=10
	call bump x as y
	call out x
	call out y
	# into the variable that is given, and one variable twice
	call bump x as x
	call out x
	call sum3 x x x as x
	call out x
	# values that are expressions, and names the body also has
	i=4
	n=3
	call first t n i+2 as r
	call out r
	call out i
	call out n
	call fact 10 as r
	call out r
	# in a loop, with the result in a var and a local beside
	store w 0
	i=0
	while i<5
		call sum3 i i*2 1 as g
		load w as a
		store w a+g
		i+=1
	end
	load w as a
	call out a
	call out g
	# a string in the body, and a body with a call of its own
	call say 1 as a
	call out a
	call outer 5 as a
	call out a
	# after a jump, where no way leads
	jmp z
	call pick 1 2 as a
	label z
	call out a
end
# a local declared after a body compiled in place, whose variables had
# its number
fn late
	call two 1 2 as a b
	call bump a as c
	local z 16
	store z a+b
	store z+8 c
	load z as d
	load z+8 as e
	call bump d as c
	call out c
	call out e
end
call run
call late
call print "\n"
