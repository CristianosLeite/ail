# Cases of tests/insn.sh: source | code in hex | the code as instructions.
# " ; " in the source is a line end. The hex is what GNU as writes for the
# instructions (tests/insn.sh hex '<instructions>'), not what the compiler
# writes; tests/insn.sh asm checks the two columns against each other.
# {disp32} asks as for the four-byte form of a jump or a displacement,
# which is the only one the compiler writes. `add rsp, 8` after a call
# with pushed values is given as bytes, since the compiler writes the
# four-byte immediate and as would not.
# The first variable of the top level is in rbx, the second in rbp; a
# buffer of a small program is at 4096, the page after the code.
sys 39 as x | b8270000000f054889c3 | mov eax, 39 ; syscall ; mov rbx, rax
set 5 as x | b8050000004889c3 | mov eax, 5 ; mov rbx, rax
add 7 3 as x | b807000000bf030000004801f84889c3 | mov eax, 7 ; mov edi, 3 ; add rax, rdi ; mov rbx, rax
