# what is written to a file after it was mapped is read in the memory:
# on Linux, where the memory is the pages of the file. Windows does not
# say that a view has what is written through a descriptor, so this
# test is not run for it (tests/win.skip)
rt unlink "build/tests/rt_map_written.txt"
rt open "build/tests/rt_map_written.txt" 0x42 420 as f
rt write f "0123456789" as w
rt map f 10 as m
loadb m+3 as c
rt pwrite f "ab" 3 as p
loadb m+3 as d
rt close f
loadb m+4 as e
rt write 1 m 10
rt write 1 "\n"
rt unmap m 10 as u
rt unlink "build/tests/rt_map_written.txt" as ul
rt exit (w==10)+(c==51)*2+(p==2)*4+((d==97)&(e==98))*8+(u==0)*16+(ul==0)*32
