# the caller has all six registers in use; a callee that uses one, three
# or six of them must restore exactly those
fn one a
	ret a
end
fn three a b c
	add a b as a
	add a c as a
	ret a
end
fn six a b c d e g
	add a b as a
	add a c as a
	add a d as a
	add a e as a
	add a g as a
	ret a
end
set 1 as p
set 2 as q
set 4 as r
set 8 as s
set 16 as t
call one 100 as u
call three 1 1 1 as u
call six 1 1 1 1 1 1 as u
add u p as u
add u q as u
add u r as u
add u s as u
add u t as u
rt exit u
