# jnz with a comparison as its value, for a smaller, an equal and a larger left side,
# also where the order is only right unsigned; exit status = the first wrong one
a=3
b=5
jnz a==b t1
jmp e1
label t1
rt exit 1
label e1
jnz a!=b t2
rt exit 2
label t2
label e2
jnz a<b t3
rt exit 3
label t3
label e3
jnz a<=b t4
rt exit 4
label t4
label e4
jnz a>b t5
jmp e5
label t5
rt exit 5
label e5
jnz a>=b t6
jmp e6
label t6
rt exit 6
label e6
