# with no number free for another descriptor, the child still gets the
# three it is given when none of them has to be copied: the error output
# of this process as its output, and that with the output of this
# process as its input besides, which must be put in place first. Only
# two that are each other's need a copy, and such a child ends with 127.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "lib/std/proc.aiw"
const setrlimit 160
data sh "/bin/sh" 0
data c "-c" 0
data s "echo out" 0
buf av 32
buf lim 16
store av sh
store av+8 c
store av+16 s
# 3 is taken by a file that the child closes when its program starts,
# and is the last number there is
rt close 3
call fileopen "tests/lib/words.txt" 0 0 as k
call putn k
store lim 4
store lim+8 4
sys setrlimit 7 lim as r
call putn r
call procstart av -1 2 -1 as p
call procwait p 5000 as r
call putn r
call procstart av 1 2 -1 as p
call procwait p 5000 as r
call putn r
call procstart av -1 2 1 as p
call procwait p 5000 as r
call putn r
call print "\n"
