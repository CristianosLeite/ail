# numdouble gives the double nearest to a decimal text, a tie to the
# one whose last bit is 0: whole numbers and fractions, the exact path
# and the long one, the edges of the subnormal numbers and of the
# largest double, texts of hundreds of digits, and texts that are no
# number. Each line is the text, or how long it is, and the bits.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/num.aiw"
buf hex 16
fn show p n
	if n>40
		call putn n
		call print " bytes"
	else
		call print p n
	end
	call numdouble p n as x ok
	ifz ok
		call print " no number\n"
	else
		i=0
		while i<16
			d=x>>(60-i*4)&15
			if d>9
				d+=39
			end
			storeb hex+i d+48
			i+=1
		end
		call print " "
		call print hex 16
		call print "\n"
	end
end

call show "0"
call show "-0"
call show "1"
call show "-1"
call show "0.1"
call show "3.141592653589793"
call show "1e22"
call show "1e23"
call show "123456789012345678"
call show "0.000001"
call show "1.5e-5"
call show "9007199254740993"
call show "9007199254740995"
call show "9007199254740993.0000000000000000000000001"
call show "2.2250738585072014e-308"
call show "2.2250738585072011e-308"
call show "2.2250738585072012e-308"
