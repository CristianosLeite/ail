# the table of lib/algo/hash.aiw with eight places: 5, 16 and 21 all go
# to the last place, so two of them go round the end; a key put in twice
# keeps its last value; keys that are not there give -1, also one whose
# place is the last and whose search goes round. Printed are the place
# of each key, the values plus one, and the places that stayed free
use "lib/std/io.aiw"
use "lib/algo/hash.aiw"
buf t 128
buf q 48
buf f 56
buf r 56
store q 10
store q+8 5
store q+16 16
store q+24 21
store q+32 2
store q+40 16
call hashfill t 7 q 6
i=0
while i<5
	load q+i*8 as k
	call hashplace t 14 k as p
	call putn (p-t)/16
	i+=1
end
call print " "
store f 5
store f+8 16
store f+16 21
store f+24 10
store f+32 2
store f+40 32
store f+48 4
call hashfind t 7 f 7 r
i=0
while i<7
	load r+i*8 as v
	call putn v+1
	i+=1
end
call print " "
i=0
while i<8
	load t+i*16 as k
	ifz k
		call putn i
	end
	i+=1
end
# no key: nothing is written, nothing is found
call hashfill t 7 q 0
call hashfind t 7 f 0 r
call print "\n"
