# a var of the program keeps its value: every variable of the server has
# a name that starts with "httpd"
var b c e f h i j k l n p q r t v w x
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/async/task.aiw"
use "lib/async/time.aiw"
use "lib/async/io.aiw"
use "lib/net/http.aiw"
use "lib/net/httpd.aiw"
buf rq 128
buf bb 24
async fn handle xx rr
	call byadd rr+88 "ok"
	ret 0
end
b=1
c=1
e=1
f=1
h=1
i=1
j=1
k=1
l=1
n=1
p=1
q=1
r=1
t=1
v=1
w=1
x=1
call asynclisten 0x7f000001 0 as ll
call asyncport ll as pp
ref handle as ff
call httpdserve ll ff 0 as sv
store rq 0x7f000001
store rq+8 pp
call httpcall rq bb as hh
await hh as st
call asyncclose ll
await sv as zz
call asyncrun
sys exit b+c+e+f+h+i+j+k+l+n+p+q+r+t+v+w+x+st-200
