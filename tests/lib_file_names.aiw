# the names in a directory, without "." and "..", and the error for a
# path that is none
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
buf b 24
call filemkdir "build/tests/lib_file_names.d" 493
call filewrite "build/tests/lib_file_names.d/one" "" as r
call filewrite "build/tests/lib_file_names.d/second.txt" "" as r
call filenames "build/tests/lib_file_names.d" b as n
load b as p
load b+8 as m
# the sum of the bytes says which names, in any order
s=0
z=0
i=0
while i<m
	loadb p+i as c
	s+=c
	z+=c==0
	i+=1
end
call fileunlink "build/tests/lib_file_names.d/one"
call fileunlink "build/tests/lib_file_names.d/second.txt"
call filermdir "build/tests/lib_file_names.d"
call putn n
call print " "
call putn z
call print " "
call putn s
call print " "
call filenames "build/tests/lib_file_names.d" b as n
call putn 0-n
call filenames "tests/lib/words.txt" b as n
call print " "
call putn 0-n
call print "\n"
