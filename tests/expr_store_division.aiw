# the value of a store may divide while the address waits in a register
buf out 8
n=4096
storeb out 48+n/1000
storeb out+1 48+n/100%10
storeb out+2 48+n/10%10
storeb out+3 48+n%10
i=4
storeb out+i 70/(i+3)
rt write 1 out 5
d=7
store out n/d
load out as q
store out+0 n%d<<(q&3)
load out as r
rt exit q+r
