# a limit on a task: when the time is up the result is -62 and the task
# is cancelled, which it is told; within the time the result is its own
use "lib/io.ai"
use "lib/async/task.ai"
use "lib/async/time.ai"
async fn slow ms
await asyncsleep ms as r
if r
call print "cancelled "
ret r
end
ret ms
end
call slow 5000 as h
call asynctimeout h 10 as g
await g as x
call putn 0-x
call print " "
call slow 5 as h
call asynctimeout h 5000 as g
await g as x
call putn x
call asyncrun as n
call print " "
call putn n
call print "\n"
