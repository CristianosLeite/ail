# a reap that has no descriptor of the child and cannot ask what the
# process does with the signal of children sends no signal by the number
# either: the signal is ignored, a filter of the process makes
# rt_sigaction fail with EPERM from then on, and with a limit of three
# open files a child that is given 20 ms gets the error of the
# descriptor, -24, and goes on to write its byte
const prctl 157
const setrlimit 160
buf act 32
buf filt 32
buf prog 16
buf fds 8
buf ts 16
buf lim 16
buf b 8
store act 1
sys rt_sigaction 17 act 0 8
sys pipe fds
load4 fds as rd
load4 fds+4 as wr
# the number of the call; for that one the error 1, else it goes on
store4 filt 32
store4 filt+8 21+16777216
store4 filt+12 13
store4 filt+16 6
store4 filt+20 327681
store4 filt+24 6
store4 filt+28 2147418112
store prog 4
store prog+8 filt
sys prctl 38 1 0 0 0 as r
ifz r
	sys prctl 22 2 prog 0 0 as r
end
if r
	rt exit 99
end
sys rt_sigaction 17 0 act 8 as r
if r!=-1
	rt exit 98
end
store lim 3
store lim+8 3
sys setrlimit 7 lim
store ts+8 250000000
sys fork as p
ifz p
	sys nanosleep ts 0
	sys write wr "x"
	rt exit 5
end
sys close wr
rt clock as t0
rt reap p 20 as a
rt clock as t1
sys read rd b 1 as n
rt reap p 0 as e
rt exit (a==-24)+(n==1)*2+(e==-1001)*4+(t1-t0<200000000)*8
