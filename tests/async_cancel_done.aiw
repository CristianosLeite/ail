# a cancelled task whose await finds its event done has the result, which
# may be something only it can give back; it is told at its next await
# that would wait. The same through a limit, and for a limit that is
# cancelled when what it limits is done.
use "lib/std/io.aiw"
use "lib/async/task.aiw"
use "lib/async/time.aiw"
var got told
async fn waiter e
	await e as v
	got=v
	await asyncsleep 5000 as r
	told=r
	ret 1
end
call asyncclock as t0
call async 64 0 as e
call waiter e as t
call asyncstep
call asyncfinish e 77
call asynccancel t
await t as x
call putn got
call print " "
call putn 0-told
call putn x
call print " "
call async 64 0 as e
call asynctimeout e 5000 as g
call asyncstep
call asyncfinish e 88
call asynccancel g as c
await g as y
call putn y
call putn c
call print " "
call async 64 0 as e
call asynctimeout e 5000 as g
call waiter g as t
call asyncstep
call asyncstep
call asyncfinish e 99
call asynccancel t
await t as x
call putn got
call putn x
call asyncrun as n
call putn n
call asyncclock as t1
call print "\n"
rt exit t1-t0>1000000000
