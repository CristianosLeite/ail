# parentheses group and may nest
jne (2+3)*4 20 f1
jne 2*(3+4) 14 f2
jne ((2+3))*((4)) 20 f3
jne (1+(2*(3+(4)))) 15 f4
jne (7) 7 f5
jne 20/(2+3) 4 f6
jne (1<<4)-(1<<2) 12 f7
jne ((((((((((5)))))))))) 5 f8
sys exit 0
label f1
sys exit 1
label f2
sys exit 2
label f3
sys exit 3
label f4
sys exit 4
label f5
sys exit 5
label f6
sys exit 6
label f7
sys exit 7
label f8
