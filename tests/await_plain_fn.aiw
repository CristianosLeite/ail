# a function that is not async awaits by polling tasks until the one it
# waits for is done, as the top level does
use "lib/async/task.aiw"
use "lib/async/time.aiw"
async fn slow v
	await asyncsleep 5
	ret v
end
fn wait v
	await slow v as x
	call slow x+1 as h
	await h as y
	ret x+y
end
call wait 10 as r
rt exit r
