# await with the name of a function calls it and awaits what it returns:
# an async function, or a function that returns a handle; with and
# without a result, with no value and with several
use "lib/async/task.aiw"
var n
async fn inc
	n+=1
end
async fn add a b c
	await inc
	ret a+b+c
end
fn later v
	call async 64 0 as e
	call asyncfinish e v
	ret e
end
async fn all
	await add 1 2 3 as x
	await later 30 as y
	await inc
	ret x+y
end
await all as r
await inc
rt exit r+n
