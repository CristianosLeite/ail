# parentheses group values that are computed when the program runs; exit status = the first check that fails
v0=2
v1=3
v2=4
v3=1
v4=7
v5=20
v6=5
v7=6
jne (v0+v1)*v2 20 f1
jne v0*(v1+v2) 14 f2
jne ((v0+v1))*((v2)) 20 f3
jne (v3+(v0*(v1+(v2)))) 15 f4
jne (v4) 7 f5
jne v5/(v0+v1) 4 f6
jne (v3<<v2)-(v3<<v0) 12 f7
jne (v0+v1)*(v2+v6)-(v7+v4)*(v3+v3) 19 f8
jne v0-(v1-(v2-(v6-(v7-v4)))) -3 f9
rt exit 0
label f1
rt exit 1
label f2
rt exit 2
label f3
rt exit 3
label f4
rt exit 4
label f5
rt exit 5
label f6
rt exit 6
label f7
rt exit 7
label f8
rt exit 8
label f9
rt exit 9
