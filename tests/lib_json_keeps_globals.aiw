# a var of the program keeps its value: every variable of the library has
# a name that starts with "json"
var a an b c d e end hi i k kn lo m n obj ok p q r s t v vn w j
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/json.aiw"
buf o 24
a=1
j=1
an=1
b=1
c=1
d=1
e=1
end=1
hi=1
i=1
k=1
kn=1
lo=1
m=1
n=1
obj=1
ok=1
p=1
q=1
r=1
s=1
t=1
v=1
vn=1
w=1
call jsonvalue " {\x22a\x5cu0062\x22:[1,-2.5e3,\x22\x5cud83d\x5cude00\x5cn\x22,null,true,false]} " as x y z
call jsonget x y "ab" as g h f
call jsonelem g+1 g+h
call jsonmember x+1 x+y
call jsonstr o "\x22\x5cu00e9\x5ct\x22"
call jsonadds o "\x01\x22\x0a"
call jsonaddi o 0-5
rt exit a+an+b+c+d+e+end+hi+i+k+kn+lo+m+n+obj+ok+p+q+r+s+t+v+vn+w+j
