# jz with a comparison as its value, for a smaller, an equal and a larger left side,
# also where the order is only right unsigned; exit status = the first wrong one
a=3
b=5
jz a==b t1
rt exit 1
label t1
label e1
jz a!=b t2
jmp e2
label t2
rt exit 2
label e2
jz a<b t3
jmp e3
label t3
rt exit 3
label e3
jz a<=b t4
jmp e4
label t4
rt exit 4
label e4
jz a>b t5
rt exit 5
label t5
label e5
jz a>=b t6
rt exit 6
label t6
label e6
