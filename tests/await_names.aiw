# the first word of await is a handle if it is a variable or a global
# name, also when a function has the name; an expression is a handle too
use "lib/async/task.aiw"
var g
buf hs 16
async fn h
	ret 1
end
async fn two
	ret 2
end
async fn f
	call two as h
	await h as x
	call two as k
	store hs+8 k
	load hs+8 as k
	await k+0 as y
	ret x+y
end
call two as g
await g as a
await f as b
await h as c
rt exit a*100+b*10+c
