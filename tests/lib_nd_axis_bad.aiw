# what a sum along an axis refuses, writing nothing: an axis the array
# has not got, a result with other lengths or another number of axes,
# a result in the storage of the array, and what is no array
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
use "lib/nd/elem.aiw"
use "lib/nd/reduce.aiw"
use "tests/lib/ndshow.aiw"
buf a 176
buf c 176
buf w 176
buf v 176
buf z 176
call ndmat a 3 4 as r
call ramp a 0 4
call ndvec c 4 as r
call ndvec w 3 as r
itof 7 as x
call ndfill c x
call ndfill w x
call ndsumax c a 2 as s
call ndsumax c a 1 as t
call ndsumax w a 0 as u
call ndsumax a a 0 as y
call ndmeanax c a 1 as b
call ndmeanax c z 0 as d
call ndsumax z a 0 as e
# the first row of the array as the result of its columns
call ndslice v a 0 0 1 1 as f
store v+16 1
store v+48 4
store v+112 8
call ndsumax v a 0 as g
call ndsum z as x h
call ndmean z as x k
call ndsumpw z as x l
call show c
call show w
call show a
call putn s+t+u+y+b+d+e+g+h+k+l
call print "\n"
call ndfree a
call ndfree c
call ndfree w
rt exit r+f
