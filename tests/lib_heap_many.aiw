# 50000 values in an order that neither rises nor falls, many of them
# equal, leave in rising order while the heap grows and shrinks; a freed
# heap is a heap again
use "lib/std/io.aiw"
use "lib/std/vec.aiw"
use "lib/std/heap.aiw"
buf h 24
x=1
s=0
i=0
while i<50000
	x=x*0x5851f42d4c957f2d+0x14057b7ef767814f
	call heappush h x>>52 as r
	ifz r
		sys exit 1
	end
	s+=x>>52
	i+=1
end
load h+8 as n
call putn n
p=0
t=0
i=0
while i<50000
	call heappop h as v r
	ifz r&(v>=p)
		sys exit 2
	end
	p=v
	t+=v
	i+=1
end
load h+8 as n
call print " "
call putn n
call print " "
call putn s==t
call print "\n"
call heapfree h
load h as a
load h+16 as c
call heappush h 4 as r
call heappop h as v d
call heapfree h
sys exit a+c+r+d+v
