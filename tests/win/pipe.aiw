# for a pipe as the input and one as the output: neither has a place,
# so seek and pwrite answer -29, and the input is read as it was
buf b 8
rt seek 0 0 1 as a
rt seek 0 0 0 as s
rt seek 0 0 2 as e
rt pwrite 1 "X" 0 as w
rt read 0 b 8 as n
loadb b as c
rt exit (a==-29)+(s==-29)*2+(e==-29)*4+(w==-29)*8+((n==2)&(c==112))*16
