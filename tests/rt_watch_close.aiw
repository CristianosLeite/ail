# a watch and a close of its descriptor at the same moment leave no
# watch behind: whichever comes first, a waker that then gets the number
# of the closed socket and is woken is no event of the poller, which
# was never given it. One thread watches while the other closes, 400
# times
buf ev 32
buf go 8
buf ack 8
buf fd 8
buf ep 8
fn work v
	i=0
	label next
	load go as g
	jeq g i next
	i=g
	if g!=-1
		load ep as p
		load fd as s
		rt watch p s 1 77
	end
	store ack g
	jne g -1 next
end
rt poller as p
store ep p
ref work as f
rt thread f 0
bad=0
i=1
while i<=400
	rt socket as s
	store fd s
	store go i
	rt close s
	a=0
	while a!=i
		load ack as a
	end
	rt waker as w
	rt wakeup w
	rt poll p ev 2 0 as n
	bad+=n!=0
	rt close w
	i+=1
end
store go -1
a=0
while a!=-1
	load ack as a
end
rt exit bad==0
