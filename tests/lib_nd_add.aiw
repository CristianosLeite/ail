# sum, difference, product and quotient of arrays with the same lengths,
# element by element, where they lie one behind the other and where
# they are views with steps; ndput copies
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
use "lib/nd/elem.aiw"
use "tests/lib/ndshow.aiw"
buf a 176
buf b 176
buf c 176
buf v 176
buf w 176
buf u 176
call ndmat a 2 3 as r
call ndmat b 2 3 as r
call ndmat c 2 3 as r
# a is 1 1.5 2 2.5 3 3.5, b is 4 2 0 -2 -4 -6
call ramp a 4 2
call ramp b 16 -8
call ndadd c a b as s
call show c
call ndsub c a b as t
call show c
call ndmul c a b as x
call show c
call nddiv c b a as y
call show c
call ndput c b as z
call show c
# columns from the last to the first, rows exchanged with columns
call ndslice v a 1 0 3 -1 as d
call ndtrans v v as d
call ndtrans w b as e
call ndmat u 3 2 as f
call ndsub u v w as g
call show v
call show w
call show u
# into every other element of one row
call ndslice v c 1 0 3 2 as h
call ndslice w a 1 1 3 1 as k
call ndslice u u 0 0 3 2 as l
call ndmul v w u as m
call show c
# a division by zero is an infinity, 0 by 0 no number
call ndfill a 0
call nddiv c b a as n
load c as p
load p as q
load p+16 as o
call putn q==0x7ff0000000000000
call putn o<<1>>52==0xfff
call print "\n"
call ndfree a
call ndfree b
call ndfree c
rt exit r+s+t+x+y+z+d+e+f+g+h+k+l+m+n
