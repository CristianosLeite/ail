# the record of a task whose result was given is the record of the next
# task of that size, also when the task was done while in the queue
use "lib/async/task.aiw"
fn poll t
	store t+16 5
	ret 1
end
fn twice t
	call asyncwake t
	store t+16 6
	ret 1
end
ref poll as p
call async 64 p as a
call asyncrun
call await a 0 as x
call async 64 p as b
r=a==b
call await b 0 as y
ref twice as p
call async 64 p as c
r+=b==c
call await c 0 as z
# c is still in the queue, so it is not free yet
call async 64 0 as d
r+=c!=d
call asyncrun
call async 64 0 as e
r+=c==e
rt exit r*100+x+y+z
