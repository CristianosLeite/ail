# the operators bind in six steps when the values are variables too, in a function whose parameters are the values
fn f v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11
	jne v0+v1*v2 14 f1
	jne v0*v1+v2 10 f2
	jne v3-v4/v0 17 f3
	jne v5%v2*v0 6 f4
	jne v6<<v0+v6 8 f5
	jne v7>>v6+v6 4 f6
	jne v6+v0<<v1 24 f7
	jne v4&v1<<v6 6 f8
	jne v5&v0+v6 3 f9
	jne v8^v1&v6 4 f10
	jne v4^v1&v0 4 f11
	jne v2|v0^v0 4 f12
	jne v6|v0&v2 1 f13
	jne v6+v0==v1 1 f14
	jne v0==v6+v6 1 f15
	jne v1<v0+v0 1 f16
	jne v6|v0==v0 0 f17
	jne v8&v2!=v9 1 f18
	jne v0*v1>=v4 1 f19
	jne v5-v0-v6 4 f20
	jne v10/v2/v0 8 f21
	jne v11%v5%v1 2 f22
	jne v6<<v0<<v1 32 f23
	ret 0
	label f1
	ret 1
	label f2
	ret 2
	label f3
	ret 3
	label f4
	ret 4
	label f5
	ret 5
	label f6
	ret 6
	label f7
	ret 7
	label f8
	ret 8
	label f9
	ret 9
	label f10
	ret 10
	label f11
	ret 11
	label f12
	ret 12
	label f13
	ret 13
	label f14
	ret 14
	label f15
	ret 15
	label f16
	ret 16
	label f17
	ret 17
	label f18
	ret 18
	label f19
	ret 19
	label f20
	ret 20
	label f21
	ret 21
	label f22
	ret 22
	label f23
	ret 23
end
call f 2 3 4 20 6 7 1 16 5 0 64 100 as r
rt exit r
