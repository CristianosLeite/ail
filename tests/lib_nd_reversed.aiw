# arrays that are all taken backwards are computed from their lowest
# address on, two doubles at a time: for 0 to 9 numbers, with two
# arrays, with a number on either side and into one of the two, the
# bits must be those of a loop of fadd, fsub, fmul and fdiv over the
# indices, forwards as well as backwards
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
use "lib/nd/elem.aiw"
buf a 176
buf b 176
buf o 176
buf p 176
buf w 176
buf ra 176
buf rb 176
buf rp 176
buf k 176
fn fill x s
	call ndsize x as n
	load x as q
	i=0
	while i<n
		itof i*7+s as u
		itof i+3 as v
		fdiv u v as u
		store q+i*8 u
		i+=1
	end
end
# the operation op of the doubles x and y
fn one op x y
	if op==0
		fadd x y as x
	end
	if op==1
		fsub x y as x
	end
	if op==2
		fmul x y as x
	end
	if op==3
		fdiv x y as x
	end
	ret x
end
# how many of the n doubles at r are not the operation op of those at
# x and at y, which are that far apart: 8, or 0 for one number
fn wrong op n r x sx y sy
	bad=0
	i=0
	while i<n
		load x+i*sx as u
		load y+i*sy as v
		call one op u v as u
		load r+i*8 as v
		bad+=u!=v
		i+=1
	end
	ret bad
end
# the operation op of lib/nd
fn nd op r x y
	if op==0
		tail ndadd r x y
	end
	if op==1
		tail ndsub r x y
	end
	if op==2
		tail ndmul r x y
	end
	tail nddiv r x y
end
fn all n
	call ndvec a n
	call ndvec b n
	call ndvec o n
	call ndvec p n
	call ndvec w n
	call fill a 1
	call fill b 11
	call ndslice ra a 0 0 n -1
	call ndslice rb b 0 0 n -1
	call ndslice rp p 0 0 n -1
	itof 3 as x
	fsqrt x as x
	call ndscalar k x
	load a as pa
	load b as pb
	load o as po
	load p as pp
	load w as pw
	bad=0
	op=0
	while op<4
		# two arrays
		call nd op o a b as r
		call nd op rp ra rb as s
		call wrong op n po pa 8 pb 8 as m
		call wrong op n pp pa 8 pb 8 as q
		bad+=m+q+2-r-s
		# a number second, a number first
		call nd op o a k as r
		call nd op rp ra k as s
		call wrong op n po pa 8 k+48 0 as m
		call wrong op n pp pa 8 k+48 0 as q
		bad+=m+q+2-r-s
		call nd op o k b as r
		call nd op rp k rb as s
		call wrong op n po k+48 0 pb 8 as m
		call wrong op n pp k+48 0 pb 8 as q
		bad+=m+q+2-r-s
		# into the first of the two, and into the second, backwards
		call ndput w a as r
		call nd op ra ra rb as s
		call wrong op n pa pw 8 pb 8 as m
		bad+=m+2-r-s
		call ndput a w as r
		call ndput w b as r
		call nd op rb ra rb as s
		call wrong op n pb pa 8 pw 8 as m
		bad+=m+2-r-s
		call ndput b w as r
		# a result backwards of arrays forwards goes one at a time
		call nd op rp a b as s
		i=0
		while i<n
			load pa+i*8 as u
			load pb+i*8 as v
			call one op u v as u
			load pp+(n-1-i)*8 as v
			bad+=u!=v
			i+=1
		end
		bad+=1-s
		op+=1
	end
	call ndfree a
	call ndfree b
	call ndfree o
	call ndfree p
	call ndfree w
	ret bad
end
n=0
while n<10
	call all n as x
	call putn x
	n+=1
end
call print "\n"
