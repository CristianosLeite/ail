# a slice is the elements of one axis from an index up to another, every
# one, every n-th, or from the top downwards with a negative step; it
# reads and writes the storage of its array, may be empty, and what does
# not lie in the axis is refused
use "lib/std/io.aiw"
use "lib/nd/array.aiw"
buf a 176
buf v 176
buf w 176
buf ix 16
# print every element of the array d with two axes, row by row
fn show d
	local ix 16
	load d+48 as n
	load d+56 as m
	i=0
	while i<n
		j=0
		while j<m
			store ix i
			store ix+8 j
			call ndget d ix as x ok
			call putn x
			call print " "
			j+=1
		end
		i+=1
	end
	call print "\n"
end
call ndmat a 4 5 as r
load a as p
i=0
while i<20
	store p+i*8 i
	i+=1
end
# rows 1 and 2
call ndslice v a 0 1 3 1 as s
call show v
# of those the columns 0, 2 and 4
call ndslice v v 1 0 5 2 as t
call show v
# the rows from the last to the first, every other one: 3 and 1
call ndslice w a 0 0 4 -2 as u
call show w
# and their columns 3, 2, 1
call ndslice w w 1 1 4 -1 as x
call show w
load w+112 as e
load w+120 as f
call putn 0-e
call print " "
call putn 0-f
call print " "
load w+40 as o
load w+24 as q
call putn o+(q!=p)
call print "\n"
# a store through the view is a store into the array
store ix 0
store ix+8 0
call ndset w ix 77 as y
load p+144 as z
call putn z
call print " "
# no element, and what cannot be
call ndslice v a 1 2 2 3 as b
call ndsize v as n
call putn n
call ndslice v a 2 0 1 1 as c
call ndslice v a 0 3 2 1 as d
call ndslice v a 0 0 5 1 as g
call ndslice v a 0 0 4 0 as h
call ndslice v ix 0 0 0 1 as k
call ndsize v as m
call putn c+d+g+h+k+m
call print "\n"
call ndfree a
rt exit r+s+t+u+x+y+b
