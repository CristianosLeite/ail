add r 1 as r
jmp d3
label d6
call ok r
call eol
if f
add p 32 as d
store d 0
add p 40 as d
store d nruns
sub op q as c
add p 24 as d
store d c
sub q out as c
add p 16 as d
store d c
call globdone
end
