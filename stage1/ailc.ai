shr d 3 as b
or a b as a
or a 72 as a
call eb a
call eb 137
and s 7 as s
shl s 3 as s
and d 7 as d
or s d as s
or s 192 as s
call eb s
end
# the row of regtab and argnum for the next value of the statement: its
# position, or 7 (r11) for a value of a call after the sixth. For callp the
# first value, the address, takes row 8 (rcx) and the rest are those of a call
fn aidx
add cur 2 as c
loadb c as c
and c 4 as c
if c
ifz ai
ret 8
end
sub ai 1 as i
jmp g
end
set ai as i
add cur 1 as c
loadb c as c
and c 16 as c
if c
label g
jlt i 6 b
ret 7
end
ifge ai 7
call ecount
end
label b
ret i
end
# the value is in its register: push it if it goes on the stack, count it
fn anext
set ai as i
add cur 2 as c
loadb c as c
and c 4 as c
if c
sub i 1 as i
jmp b
end
add cur 1 as c
loadb c as c
and c 16 as c
jz c x
label b
jslt i 6 x
call eb 65
call eb 83
add pushed 8 as pushed
label x
add ai 1 as ai
end
# mov <register of the next argument>, v, in its shortest form
fn mov v
call aidx as i
shr v 32 as c
ifz c
mul i 2 as r
add r regtab as r
loadb r as c
if c
call eb c
end
add r 1 as r
loadb r as c
call eb c
set op as immpos
call e4 v
jmp x
end
call areg i as r
shr r 3 as c
or c 72 as c
call eb c
and r 7 as r
ifge v 0xffffffff80000000
call eb 199
or r 192 as r
call eb r
call e4 v
jmp x
end
or r 184 as r
call eb r
store op v
add op 8 as op
label x
call anext
end
# lea <register of the next argument>, [rip+rel32], with the rel32 zero and
# its address in immpos
fn elea
call aidx as i
call areg i as r
shr r 3 as c
shl c 2 as c
or c 72 as c
call eb c
call eb 141
and r 7 as r
shl r 3 as r
or r 5 as r
call eb r
set op as immpos
call e4 0
call anext
end
# a 64-bit mov between the register g and memory: the cell number p (k = 1,
# rip-relative, filled in by fin) or rsp + p (k = 2); o = 139 to load the
# register, 137 to store it
fn emem g k p o
shr g 3 as c
shl c 2 as c
or c 72 as c
call eb c
ifeq o 175
call eb 15
end
call eb o
and g 7 as g
shl g 3 as g
ifeq k 1
or g 5 as g
call eb g
mul nrefs 32 as c
add c refs as c
store c p
add c 8 as d
store d 0
add c 16 as d
store d op
add c 24 as d
store d 3
add nrefs 1 as nrefs
call e4 0
ret 0
end
or g 132 as g
call eb g
call eb 36
call e4 p
end
# the same between the register g and variable i of the current scope; a
# local is not stored to, and loading it gives its address (lea, 141)
fn vmov i g o
call vplace i as k p
ifz k
ifeq o 139
call mrr g p
ret 0
end
call mrr p g
ret 0
end
ifeq k 3
call emem g 2 p 141
ret 0
end
call emem g k p o
end
# mov <register of the next argument>, [a]: read the cell of a var
fn ldvar a
call aidx as i
call areg i as r
call emem r 1 a 139
call anext
end
# 1 if the statement is at and this is its first value, which must be a name
fn atfirst
ifz ai
add cur 2 as c
loadb c as c
and c 1 as c
ret c
end
end
# record that the imm32 just written stands for the name read last: k = 0
# its address, 1 its length, 2 the bytes from it to the end of its object
fn addref k
mul nrefs 32 as p
add p refs as p
call putn p
add p 16 as q
store q immpos
add p 24 as q
store q k
add nrefs 1 as nrefs
end
# the innermost open block, which the statement at hand closes or continues;
# the jump recorded for it lands here
fn blktop
sub nblk 1 as p
mul p 40 as p
add p blks as p
load p as d
sub op d as c
sub c 4 as c
store4 d c
ret p
end
# where to note what is known of the next value of the statement
fn opdp
set ai as i
ifge i 2
set 2 as i
end
mul i 32 as i
add i opd as i
ret i
end
# note that the next value is the address of the global name read last
fn opda
call opdp as p
store p 2
add p 8 as p
store p ns
add p 8 as p
store p nl
add p 8 as p
store p 0
end
# copy the four cells at a to b
fn cp4 a b
set 4 as n
label l
load a as c
store b c
add a 8 as a
add b 8 as b
sub n 1 as n
jnz n l
end
