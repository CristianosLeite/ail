# "end": return 0, resolve the function's jumps, drop its labels and jumps
label fnend
jgt nblk blkbase blkend
set infn as d
call ok d
call eol
set fnres as q
set q as d
jnz q e0
set 1 as q
set 1 as d
jz fntail e0
set 6 as d
label e0
sub nfuncs 1 as p
