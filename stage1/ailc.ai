call rdnum as c
gt c 255 as d
call no d
call eb c
label d5
call tokchk
add r 1 as r
jmp d3
label d6
call ok r
call eol
if f
add p 32 as d
store d 0
add p 40 as d
store d nruns
sub op q as c
add p 24 as d
store d c
sub q out as c
add c 0x400000 as c
add p 16 as d
store d c
add nbufs 1 as c
set c as nbufs
end
set datarel as p
set op as q
sub q p as c
sub c 4 as c
store4 p c
set q as dataend
sub q out as c
add c 0x400000 as c
mul nruns 8 as d
add d runend as d
sub d 8 as d
store d c
jmp next

# "label <name>"
label labdef
call blank1
call rname
call eol
call llab as r
call nodup r
set nlabels as r
mul r 40 as p
add p labs as p
