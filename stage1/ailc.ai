add p 16 as p
store p op
add p 8 as p
store p asg
call z 4
add r 1 as nfix
loadb cur as d
jnz d next
call godead
jmp next

# "fn <name> <parameter>...": jump over the body, save the variable
# registers and open a scope whose first variables are the parameters
label fndef
set infn as d
call no d
jnz pass f0
set ip as sip
set op as sop
set nbufs as snb
set ngv as snv
set bsssz as sbs
set ncalls as snc
set nfuncs as snf
set nrefs as snr
