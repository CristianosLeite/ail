# "end" with a block open: what is assigned after it is what both ways
# here have assigned, its last line and the jump past it, or after an else
# part the last line of the part before
label blkend
call eol
call blktop as p
sub nblk 1 as nblk
add p 16 as q
load4 q as d
if d
add p 20 as q
load4 q as d
jnz d be3
end
add p 8 as q
load q as q
if dead
set q as asg
set 0 as dead
jmp be3
end
and asg q as asg
label be3
call clrvk
set 0 as dataend
jmp next

# "else": the block so far ends with a jump past the rest, and the jump of
# its "if" lands here
label elsedef
gt nblk blkbase as d
call ok d
call eol
call eb 233
set op as r
call z 4
