set 0xffffffff as i
end
set ncalls as n
mul n 32 as p
add p calls as p
set cn as c
store p c
set cl as c
add p 8 as r
store r c
set op as c
add p 16 as r
store r c
add p 24 as r
store4 r i
add p 28 as r
store4 r ncap
call z 4
add n 1 as ncalls
label w
if pushed
