# ailc stage1 -- the AIL compiler in AIL, a translation of stage0/ailc.s.
# usage: ailc < prog.ai > prog      (same output, byte for byte, as stage0)
#
# The fixed registers of stage0 are global vars here, since a function
# sees no top-level variable:
#   ip = input cursor    ie = input end     op = output cursor
#   ai = argument index of the statement    nv = variables of the scope
#   cur = optab row of the statement (at its operand count)
#   ns, nl = start and length of the name read last
# Top level uses the variables c d r f p q only.
var ip ie op ai nv cur ns nl
# the counters and the saved scope of stage0, under its names: nbufs counts
# the global names and ngv those that are vars; cn, cl = name of this call
var nbufs bsssz nlabels nfix infn topvars fnskip labbase fixbase cn cl
var nfuncs ncalls ngv dataend datarel nrefs
# pass is 1 while a function is compiled to measure its variables and 2 when
# it is compiled again for good; the s* vars are the state to return to
var pass fnslots nloops sip sop snb snv sbs snc snf snr sde sdr
# pushed = bytes of call values pushed so far in this statement; fnnpar =
# parameters of the function; immpos = where mov wrote its last imm32
var pushed fnnpar immpos
# asg: bit i is set when variable i of the scope is assigned on every way to
# this point, all ones where no way leads; dead = 1 after jmp or ret, until
# the next label; jmask = asg when dead was set; t* = those of the top level
var asg dead jmask tasg tdead tjmask
# nchks = loads and stores to check at the end; nruns = runs of data
# statements; snk, snu = both before the first pass over a function
var nchks nruns snk snu
# loccur = bytes of locals declared so far in this pass; fnlocal = those of
# the function, after its first pass
var loccur fnlocal
# fnregs = how many of the six registers the function uses
var fnregs
# srcend = end of all source read so far; nuses = files compiled through
# use; nustk = uses being compiled
var srcend nuses nustk
# fnres = results of the open function, 0 until its first ret; fntail = 1
# once it has a tail; ncap = names after "as" in this statement
var fnres fntail ncap
# nblk = open blocks; blkbase = those opened outside the open function;
# topblk = blkbase of the top level, in a function
var nblk blkbase topblk whead wsrc
# the hash of names: nhn = its nodes, hbkt = the bucket hhash found last,
# scope = 0 at top level or the number of the open function, nscope =
# functions opened so far, snh = nhn before the first pass over a function
var nhn hbkt scope nscope snh
# rwstart = where the writable segment starts in the image, known in fin
var rwstart
# expressions: the nodes, values and operators of the one being parsed, and
# whether it divides or shifts
var nex nexv nexs exdm exsh
# code for expressions: the free registers and the preferred one, the
# number of values that wait and of those that hold no register, the two
# operands of the operator at hand, and how many bytes of the row of a
# statement eop is to leave out
var xfree xpref nxs xspl xlk xla xlb xlc xrk xra xrb xrc xskip xcl xct
# epos = where an error is: 0 for the input cursor, -1 for nowhere, else an
# address in the source; ename, enamel = the name it is about, or 0;
# mainend = end of the source from stdin; curunit = 0, or 1 + the file of
# use being read
var epos ename enamel mainend curunit
# the source limit of 8 MiB is in the sizes below: in holds one byte more,
# out 16 times as much (see OUTSZ in stage0), and each table one entry for
# every shortest line that makes one
const inmax 8388609
buf in inmax
buf out 134217728
buf sig 32          # struct sigaction
buf vars 2048       # variables: 64 top level then 64 of the function, 16 bytes each: name, length
buf topcell 512     # per top-level variable after the sixth: the address of its cell
buf vfirst 512      # per variable of the function: where the source defines it,
buf vlast 512       # and mentions it last
buf fnloc 64        # its place: a register 0-5, or 6 + a stack slot
buf vlocal 512      # per variable of the function that is a local: 1 + its offset
buf vlocsz 512      # per local: its size as declared
buf locfree 560     # per place: the last mention of its variable
buf loops 22369632    # 1398102 backward jumps of the function: where the source has
                    # the label, and the jump
buf globs 201326640   # 4194305 global names of 48 bytes: name, length, address, size or
                    # value, kind (0 buffer or data, 1 var, 2 const), 1 + run of data
buf opd 96          # what is known of the first two values of the statement, 32 bytes
                    # each: kind (1 number, 2 name plus number, 3 string), then the
                    # number, or name, length and number; a third entry is scratch
buf vk 2048         # the same per variable of the current scope
buf chks 33554464     # 1048577 loads and stores through a known name, 32 bytes: name,
                    # length, offset, width + 256 for a store
buf runend 7456544    # per run of data statements: the address after its last byte
buf blks 67108880     # 1677722 open blocks of 40 bytes: address of the rel32 that jumps past
                    # the block, asg, and (4 bytes each) 1 for an else part and dead
                    # at its end, and for a while the address of its head and its
                    # place in the source, else 0
buf buckets 8388608 # 1048576 buckets of the hash of names: the first node of each, from 1
buf hnodes 484675328 # 7573052 nodes of 64 bytes: name, asg of the jumps to a label not
                    # yet defined, length, next node, scope, index in the table of
                    # its kind, bucket, kind (1 global, 2 function, 3 label, 4 a
                    # label with jumps but no definition yet)
buf ustart 9586984  # per file of use: where its bytes start,
buf uendp 9586984   # and end
buf ucur 9586984    # per use being compiled: curunit outside it
buf numbuf 24       # a line number in decimal
buf uses 19173968     # 1198373 files compiled through use, 16 bytes: path as written, length
buf ustack 19173968   # per use being compiled: where its line ended, and the end of
                    # the unit that has it
buf pathbuf 4096    # the path of a use, with a NUL for open
buf labs 41943080     # 1048577 labels of 40 bytes: name, length, address in out, place in the
                    # source, variables assigned on every way to it
buf fixs 44739264     # 1398102 jumps of 32 bytes: label name, length, rel32 address,
                    # variables assigned at the jump
buf funs 37282720     # 932068 functions of 40 bytes: name, length, entry, parameters, results
buf calls 38347936    # 1198373 calls of 32 bytes: name, length, rel32 address, then two
                    # 4-byte counts: values (all ones for ref) and names after "as"
buf ex 268435488     # 8388609 nodes of an expression, 32 bytes: kind and three cells
buf exv 111848480    # 2796212 values of 40 bytes while it is parsed: node, what is known
buf exs 8388609      # and as many operators or open parentheses, a byte each
buf exnm 8           # the name of a statement that compares and jumps
buf caps 96         # the names after "as": 0 and a variable, or 1 and the cell of a var
buf refs 134217760    # 4194305 uses of a name not declared yet, 32 bytes: name, length,
                    # imm32 address, 0 for its address or 1 for its length

# ---- errors: one line on stderr, "ailc: <place>: <message> <name>", then
# exit. Source problems exit 1, I/O problems 2. The place is the path of a
# file read by use and a colon, if the fault is in one, and the line number;
# it is taken from epos, or from the input cursor while that is zero.
fn ew p n
sys write 2 p n
end
# print the message m of n bytes with its place and exit with status s
fn die m n s
call ew "ailc: "
jeq epos -1 q
set ip as pos
set curunit as u
if epos
set epos as pos
set 0 as u
jlt pos mainend g
label a
add u 1 as u
jgt u nuses q
mul u 8 as c
add c ustart as c
sub c 8 as c
load c as c
jlt pos c a
mul u 8 as c
add c uendp as c
sub c 8 as c
load c as c
jge pos c a
label g
end
set in as st
if u
mul u 8 as c
add c ustart as c
sub c 8 as c
load c as st
sub u 1 as c
mul c 16 as c
add c uses as c
load c as pp
add c 8 as c
load c as pl
call ew pp pl
call ew ":"
end
set 1 as ln
label l
jge st pos d
loadb st as c
ifeq c 10
add ln 1 as ln
end
add st 1 as st
jmp l
label d
add numbuf 24 as e
set e as b
label t
sub b 1 as b
mod ln 10 as c
add c 48 as c
storeb b c
div ln 10 as ln
jnz ln t
sub e b as c
call ew b c
call ew ": "
label q
call ew m n
if enamel
call ew " "
call ew ename enamel
end
call ew "\n"
sys exit s
end
fn err
call die "syntax error" 1
end
fn estmt
call die "unknown statement" 1
end
fn eplace
call die "not allowed here" 1
end
fn eend
call die "missing end" 1
end
fn eas
call die "missing as" 1
end
fn enoas
call die "unexpected as" 1
end
fn emlab
call die "missing label" 1
end
fn ecount
call die "wrong operand count" 1
end
fn estr
call die "unterminated string" 1
end
fn enam
call die "expected a name" 1
end
fn evar
call die "too many variables" 1
end
fn enum
call die "number too big" 1
end
fn ebuf
call die "buffers too big" 1
end
fn eres
call die "wrong result count" 1
end
fn eunasgj
call die "unassigned variable" 1
end
fn eaccl
call die "invalid access" 1
end
fn edup
set ns as ename
set nl as enamel
call die "duplicate name" 1
end
fn eund
set ns as ename
set nl as enamel
call die "undefined variable" 1
end
fn eunasg
set ns as ename
set nl as enamel
call die "unassigned variable" 1
end
fn eacc
set ns as ename
set nl as enamel
call die "invalid access" 1
end
fn euse
set ns as ename
set nl as enamel
call die "cannot read file" 1
end
fn elab
set ns as ename
set nl as enamel
call die "undefined label" 1
end
fn efn
set ns as ename
set nl as enamel
call die "undefined function" 1
end
fn eargc
set ns as ename
set nl as enamel
call die "wrong argument count" 1
end
fn eresf
set ns as ename
set nl as enamel
call die "wrong result count" 1
end
fn ebig
set -1 as epos
call die "source too big" 1
end
fn eprog
set -1 as epos
call die "program too big" 1
end
fn erd
set -1 as epos
call die "read error" 2
end
fn ewr
set -1 as epos
call die "write error" 2
end
# syntax error unless c is not zero
fn ok c
ifz c
call err
end
end
# syntax error unless c is zero
fn no c
if c
call err
end
end
# duplicate name unless the lookup result i is "not found"
fn nodup i
eq i -1 as i
ifz i
call edup
end
end

# the output buffer must have room left for what comes before the next
# check: 4096 bytes, more than any statement emits between two checks
fn ochk
sub op out as c
ifgt c 134213632
call eprog
end
end

# ---- input
# the byte at the cursor, or 256 at the end of the input
fn pk
iflt ip ie
loadb ip as c
ret c
end
ret 256
end
fn adv
add ip 1 as ip
end
fn low c
sub c 97 as c
lt c 26 as c
ret c
end
fn dig c
sub c 48 as c
lt c 10 as c
ret c
end
fn blank c
eq c 32 as d
eq c 9 as c
or c d as c
ret c
end
# a CR at the cursor must be the first half of a CRLF line end
fn crlf
add ip 1 as p
set ie as e
jge p e bad
loadb p as c
eq c 10 as c
ifz c
label bad
call err
end
end
fn blanks
label a
call pk as c
call blank c as c
if c
call adv
jmp a
end
end
# one space or tab at least
fn blank1
call pk as c
call blank c as c
call ok c
call blanks
end
# after the last token of a statement: blanks, then a comment or line end
fn eol
call blanks
call pk as c
jeq c 256 k
jeq c 10 k
jeq c 35 k
eq c 13 as d
call ok d
call crlf
label k
end
# a token must be followed by a space, tab, comment or end of line
fn tokchk
call pk as c
jeq c 256 k
call blank c as d
jnz d k
jeq c 10 k
jeq c 13 k
eq c 35 as d
call ok d
label k
end
# read a name [a-z0-9_]* into ns and nl
fn name
set ip as p
set p as ns
label a
call pk as c
jeq c 95 t
call dig c as d
jnz d t
call low c as d
if d
label t
call adv
jmp a
end
sub ip p as e
set e as nl
end
# the same, but it must start with a letter
fn rname
call pk as c
call low c as c
ifz c
call enam
end
call name
end
# 1 if the name read last is "as"
fn isas
jne nl 2 x
set ns as p
loadb p as n
eq n 97 as n
jz n x
add p 1 as p
loadb p as n
eq n 115 as n
ret n
label x
end
# a name that starts with a letter and is not "as"
fn rdname
call rname
call isas as c
if c
call enam
end
end
# the number at the cursor: decimal, or hexadecimal after "0x", either one
# after an optional "-"; it must fit 64 bits
fn rdnum
call pk as c
eq c 45 as n
if n
call adv
call pk as c
end
call dig c as d
call ok d
set 0 as r
jne c 48 m
add ip 1 as d
jge d ie m
loadb d as d
eq d 120 as d
jz d m
add ip 2 as ip
set 0 as k
label h
call pk as c
call dig c as d
if d
sub c 48 as c
jmp h2
end
or c 32 as c
sub c 97 as c
iflt c 6
add c 10 as c
label h2
add k 1 as k
ifgt k 16
call enum
end
shl r 4 as r
or r c as r
call adv
jmp h
end
call ok k
jmp s
label m
call pk as c
call dig c as d
jz d s
sub c 48 as c
ifle r 0x1999999999999999
jne r 0x1999999999999999 f
jle c 5 f
end
call enum
label f
mul r 10 as r
add r c as r
call adv
jmp m
label s
if n
ifgt r 0x8000000000000000
call enum
end
sub 0 r as r
end
ret r
end

# ---- tables of names
# 1 if the n bytes at a and b are equal
fn eqn a b n
label l
jz n y
loadb a as c
loadb b as d
ne c d as c
ifz c
add a 1 as a
add b 1 as b
sub n 1 as n
jmp l
label y
ret 1
end
end
# 1 if the table entry q holds the name read last
fn same q
add q 8 as t
load t as t
set nl as n
ne t n as t
ifz t
load q as q
set ns as p
call eqn q p n as t
ret t
end
end
# index of the name read last among n entries of z bytes at b, or -1
fn look b n z
set 0 as i
label a
iflt i n
call same b as t
ifz t
add b z as b
add i 1 as i
jmp a
end
ret i
end
ret -1
end
# the variable pool of the current scope
fn vbase
set vars as p
set infn as c
if c
add p 1024 as p
end
ret p
end
fn lvar
call vbase as p
set nv as n
call look p n 16 as i
ret i
end
# the top-level variables, also from inside a function
fn ltop
set vars as p
set nv as n
set infn as c
if c
set topvars as n
end
call look p n 16 as i
ret i
end
# labels, functions and global names are found through one hash table with
# chains. Nodes are never removed, except those of the first pass over a
# function; the labels of a finished function match nothing afterwards,
# since every function has a scope number of its own.
# the bucket of the name read last with the kind k in the scope sc
fn hhash k sc
mul sc 0x9e3779b1 as m
add m k as m
and m 0xffffffff as m
set 2166136261 as h
set ns as p
set nl as n
label a
jz n b
loadb p as c
xor h c as h
mul h 16777619 as h
and h 0xffffffff as h
add p 1 as p
sub n 1 as n
jmp a
label b
xor h m as h
shr h 15 as c
xor h c as h
and h 1048575 as h
set h as hbkt
ret h
end
# the node of the name read last with the kind k in the scope sc, or 0
fn hfind k sc
call hhash k sc as b
mul b 8 as b
add b buckets as b
load b as i
label a
jz i x
mul i 64 as p
add p hnodes as p
sub p 64 as p
add p 56 as q
load q as c
jne c k t
add p 32 as q
load q as c
jne c sc t
add p 16 as q
load q as c
jne c nl t
load p as q
call eqn q ns nl as c
jz c t
ret p
label t
add p 24 as q
load q as i
jmp a
label x
end
# add a node for the name read last with the kind k in the scope sc and the
# value v, in front of its bucket, and return it
fn hadd k sc v
call hhash k sc as b
add nhn 1 as nhn
mul nhn 64 as p
add p hnodes as p
sub p 64 as p
store p ns
add p 8 as q
store q 0
add p 16 as q
store q nl
add p 32 as q
store q sc
add p 40 as q
store q v
add p 48 as q
store q b
add p 56 as q
store q k
mul b 8 as b
add b buckets as b
load b as c
add p 24 as q
store q c
store b nhn
ret p
end
# remove the nodes added after the first n, last first: each is then the
# first of its bucket
fn hundo n
label a
jle nhn n x
mul nhn 64 as p
add p hnodes as p
sub p 64 as p
add p 48 as q
load q as b
add p 24 as q
load q as c
mul b 8 as b
add b buckets as b
store b c
sub nhn 1 as nhn
jmp a
label x
end
# the index that the node p holds, or -1 for no node
fn hval p
ifz p
ret -1
end
add p 40 as p
load p as p
ret p
end
fn lbuf
call hfind 1 0 as p
tail hval p
end
# the entry of global name i
fn gent i
mul i 48 as i
add i globs as i
ret i
end
# the name read last must not be in use at top level or in the open
# function: enter it as the next global name and return its entry
fn newglob
call lvar as c
call nodup c
call ltop as c
call nodup c
call lbuf as c
call nodup c
set nbufs as c
call gent c as p
call putn p
ret p
end
# the syscall number named at the cursor: a const of the program, or else
# one of the names in sysnames
fn sname
call rdname
call lbuf as i
ifne i -1
call gent i as p
add p 32 as c
load c as c
eq c 2 as c
call ok c
add p 24 as p
load p as p
ret p
end
set sysnames as r
label a
loadb r as l
call ok l
add r 1 as r
jne l nl t
call eqn r ns l as c
jz c t
add r l as r
load2 r as r
ret r
label t
add r l as r
add r 2 as r
jmp a
end
# the value of the const whose name is at the cursor
fn cname
call rdname
call lbuf as i
ne i -1 as c
call ok c
call gent i as p
add p 32 as c
load c as c
eq c 2 as c
call ok c
add p 24 as p
load p as p
ret p
end
# a label of the current scope: the index counts from labbase
fn llab
call hfind 3 scope as p
ifz p
ret -1
end
add p 40 as p
load p as p
sub p labbase as p
ret p
end
fn lfn
call hfind 2 0 as p
tail hval p
end
# the global name whose entry newglob wrote is complete: from here on it is
# found
fn globdone
call gent nbufs as p
call getn p
call hadd 1 0 nbufs
add nbufs 1 as nbufs
end
# write the name read last into the table entry p, or read it back from it
fn putn p
set ns as c
store p c
add p 8 as p
set nl as c
store p c
end
fn getn p
load p as c
set c as ns
add p 8 as p
load p as c
set c as nl
end
# read a variable name and find it in the pool of the scope, or add it
fn defvar
call rdname
tail defv
end
# the same for the name read last
fn defv
call lbuf as c
jeq c -1 v
ifz infn
call edup
end
call gent c as c
add c 32 as c
load c as c
eq c 1 as c
jz c v
call edup
label v
call lvar as i
jne i -1 x
set nv as i
ifge i 64
call evar
end
call vbase as p
mul i 16 as c
add p c as p
call putn p
add i 1 as nv
ifz infn
ifge i 6
add ngv 1 as ngv
mul i 8 as p
add p topcell as p
store p ngv
end
ret i
end
mul i 8 as p
add p vfirst as p
store p ip
label x
mul i 8 as p
add p vlast as p
store p ip
ret i
end
# where variable i of the current scope lives, as two results: 0 and its
# x86 register, 1 and the address of its cell, 2 and its distance from rsp,
# or for a local 3 and the distance of its bytes from rsp
fn vplace i
ifz infn
iflt i 6
label r
add i varnum as i
loadb i as i
ret 0 i
end
mul i 8 as i
add i topcell as i
load i as i
ret 1 i
end
mul i 8 as c
add c vlocal as c
load c as c
if c
mul fnslots 8 as i
add i c as i
sub i 1 as i
add i pushed as i
ret 3 i
end
ifeq pass 1
set 0 as i
jmp r
end
add i fnloc as i
loadb i as i
jlt i 6 r
mul i 8 as i
sub i 48 as i
add i pushed as i
ret 2 i
end
# the optab row of the name read last, at its operand count, or 0
fn kw
set optab as r
set nl as n
set ns as p
label a
loadb r as l
if l
add r 1 as r
jne l n t
call eqn r p n as c
jz c t
add r l as r
ret r
label t
add r l as r
add r 3 as c
loadb c as c
add r 4 as r
add r c as r
jmp a
end
end
# x86 register number of argument position i
fn areg i
add i argnum as i
loadb i as i
ret i
end

# ---- expressions
# An argument written with operators or parentheses, and no space in it, is
# an expression. expr parses it into ex, a list of nodes in the order a
# stack machine runs them: both operands of an operator stand before it,
# the right one directly. A node is 32 bytes, a kind and three cells:
#   1 a number: its value
#   2 the address of a global name plus a number: name, length, number
#   4 a variable: its index
#   5 a var: its cell
#   6 an operator: its number, and the node of its left operand
# The operators, by number, with how tightly each binds:
#   0 *  1 /  2 %   (6)     3 +  4 -   (5)     5 <<  6 >>   (4)
#   7 &  (3)     8 ^  (2)     9 |  (1)     10 ==  11 !=  12 <  13 <=  14 >
#   15 >=   (0)
# exv is the stack of values while parsing, 40 bytes each: the node, then
# what is known of the value, four cells as in opd. exs is the stack of
# operators, a byte each, 255 for an open parenthesis.
fn exnode k a b c
mul nex 32 as p
add p ex as p
store p k
add p 8 as q
store q a
add p 16 as q
store q b
add p 24 as q
store q c
set nex as i
add nex 1 as nex
ret i
end
fn exvpush i a b c d
mul nexv 40 as p
add p exv as p
store p i
add p 8 as p
store p a
add p 8 as p
store p b
add p 8 as p
store p c
add p 8 as p
store p d
add nexv 1 as nexv
end
fn exspush o
add exs nexs as p
storeb p o
add nexs 1 as nexs
end
fn exspop
sub nexs 1 as nexs
add exs nexs as p
loadb p as o
ret o
end
# the name read last, as a value: a variable, a var, a const, or the
# address of a buffer or of data, which may be declared later
fn exname
call lvar as r
ifne r -1
mul r 8 as d
add d vlast as d
store d ip
