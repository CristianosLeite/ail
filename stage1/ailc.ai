call cp4 f d
call aidx as d
call areg d as f
call vmov r f 139
call anext
jmp tokend
label i2
call lbuf as r
jne r -1 i4
label i8
call opda
call elea
set 0 as r
label i9
call addref r
jmp tokend

# the first value of at: a name, passed as its address and its size
label atname
call lvar as r
ifne r -1
mul r 8 as d
add d vlocal as d
load d as d
call ok d
mul r 8 as d
add d vlast as d
store d ip
call vmov r 0 139
set 1 as ai
mul r 8 as d
add d vlocsz as d
load d as d
call mov d
jmp tokend
