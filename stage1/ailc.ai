# ---- output
fn eb v
storeb op v
add op 1 as op
end
fn e4 v
store4 op v
add op 4 as op
end
fn z n
add op n as op
end
fn cp a n
set op as p
label l
if n
loadb a as c
storeb p c
add a 1 as a
add p 1 as p
sub n 1 as n
jmp l
end
set p as op
end
# the value of the hexadecimal digit at the cursor, which is consumed
fn hexd
call pk as c
eq c 256 as d
call no d
call adv
call dig c as d
if d
sub c 48 as c
ret c
end
or c 32 as c
sub c 97 as c
lt c 6 as d
call ok d
add c 10 as c
ret c
end
# copy the bytes of a string, whose opening quote is behind the cursor
fn sbytes
label a
call pk as c
ifeq c 256
call estr
end
call adv
jeq c 34 x
jne c 92 k
call pk as c
ifeq c 256
call estr
end
call adv
ifeq c 110
set 10 as c
jmp k
end
ifeq c 116
set 9 as c
jmp k
end
ifeq c 48
set 0 as c
jmp k
end
jne c 120 k
call hexd as c
shl c 4 as c
call hexd as d
or c d as c
label k
call eb c
call ochk
jmp a
label x
end
# mov <register d>, <register s>, 64-bit
fn mrr d s
shr s 3 as a
