# ailc stage1 -- the AIL compiler in AIL, a translation of stage0/ailc.s.
# usage: ailc < prog.ai > prog      (same output, byte for byte, as stage0)
#
# The fixed registers of stage0 are global vars here, since a function
# sees no top-level variable:
#   ip = input cursor    ie = input end     op = output cursor
#   ai = argument index of the statement    nv = variables of the scope
#   cur = optab row of the statement (at its operand count)
#   ns, nl = start and length of the name read last
# Top level uses the variables c d r f p q only.
var ip ie op ai nv cur ns nl
# the counters and the saved scope of stage0, under its names: nbufs counts
# the global names and ngv those that are vars; cn, cl = name of this call
var nbufs bsssz nlabels nfix infn topvars fnskip labbase fixbase cn cl
var nfuncs ncalls ngv dataend datarel nrefs
# pass is 1 while a function is compiled to measure its variables and 2 when
# it is compiled again for good; the s* vars are the state to return to
var pass fnslots nloops sip sop snb snv sbs snc snf snr sde sdr
# pushed = bytes of call values pushed so far in this statement; fnnpar =
# parameters of the function; immpos = where mov wrote its last imm32
var pushed fnnpar immpos
# asg: bit i is set when variable i of the scope is assigned on every way to
# this point, all ones where no way leads; dead = 1 after jmp or ret, until
# the next label; jmask = asg when dead was set; t* = those of the top level
var asg dead jmask tasg tdead tjmask
# nchks = loads and stores to check at the end; nruns = runs of data
# statements; snk, snu = both before the first pass over a function
var nchks nruns snk snu
# loccur = bytes of locals declared so far in this pass; fnlocal = those of
# the function, after its first pass
var loccur fnlocal
# fnregs = how many of the six registers the function uses
var fnregs
# srcend = end of all source read so far; nuses = files compiled through
# use; nustk = uses being compiled
var srcend nuses nustk
# fnres = results of the open function, 0 until its first ret; fntail = 1
# once it has a tail; ncap = names after "as" in this statement
var fnres fntail ncap
# nblk = open blocks; blkbase = those opened outside the open function;
# topblk = blkbase of the top level, in a function
var nblk blkbase topblk
# the source limit of 8 MiB is in the sizes below: in holds one byte more,
# out 16 times as much (see OUTSZ in stage0), and each table one entry for
# every shortest line that makes one
const inmax 8388609
buf in inmax
buf out 134217728
buf sig 32          # struct sigaction
buf vars 2048       # variables: 64 top level then 64 of the function, 16 bytes each: name, length
buf topcell 512     # per top-level variable after the sixth: the address of its cell
buf vfirst 512      # per variable of the function: where the source defines it,
buf vlast 512       # and mentions it last
buf fnloc 64        # its place: a register 0-5, or 6 + a stack slot
buf vlocal 512      # per variable of the function that is a local: 1 + its offset
buf vlocsz 512      # per local: its size as declared
buf locfree 560     # per place: the last mention of its variable
buf loops 22369632    # 1398102 backward jumps of the function: where the source has
                    # the label, and the jump
buf globs 201326640   # 4194305 global names of 48 bytes: name, length, address, size or
                    # value, kind (0 buffer or data, 1 var, 2 const), 1 + run of data
buf opd 96          # what is known of the first two values of the statement, 32 bytes
                    # each: kind (1 number, 2 name plus number, 3 string), then the
                    # number, or name, length and number; a third entry is scratch
buf vk 2048         # the same per variable of the current scope
buf chks 33554464     # 1048577 loads and stores through a known name, 32 bytes: name,
                    # length, offset, width + 256 for a store
buf runend 7456544    # per run of data statements: the address after its last byte
buf blks 40265328     # 1677722 open blocks of 24 bytes: address of the rel32 that jumps past
                    # the block, asg, and (4 bytes each) 1 for an else part and dead
buf uses 19173968     # 1198373 files compiled through use, 16 bytes: path as written, length
buf ustack 19173968   # per use being compiled: where its line ended, and the end of
                    # the unit that has it
buf pathbuf 4096    # the path of a use, with a NUL for open
buf labs 41943080     # 1048577 labels of 40 bytes: name, length, address in out, place in the
                    # source, variables assigned on every way to it
buf fixs 44739264     # 1398102 jumps of 32 bytes: label name, length, rel32 address,
                    # variables assigned at the jump
buf funs 37282720     # 932068 functions of 40 bytes: name, length, entry, parameters, results
buf calls 38347936    # 1198373 calls of 32 bytes: name, length, rel32 address, then two
                    # 4-byte counts: values (all ones for ref) and names after "as"
buf caps 96         # the names after "as": 0 and a variable, or 1 and the cell of a var
buf refs 134217760    # 4194305 uses of a name not declared yet, 32 bytes: name, length,
                    # imm32 address, 0 for its address or 1 for its length

# ---- errors: source problems exit 1, I/O problems exit 2
fn err
sys write 2 "ailc: syntax error\n"
sys exit 1
end
fn ebig
sys write 2 "ailc: source too big\n"
sys exit 1
end
fn eund
sys write 2 "ailc: undefined variable\n"
sys exit 1
end
fn evar
sys write 2 "ailc: too many variables\n"
sys exit 1
end
fn edup
sys write 2 "ailc: duplicate name\n"
sys exit 1
end
fn enum
sys write 2 "ailc: number too big\n"
sys exit 1
end
fn eunasg
sys write 2 "ailc: unassigned variable\n"
sys exit 1
end
fn eacc
sys write 2 "ailc: invalid access\n"
sys exit 1
end
fn euse
sys write 2 "ailc: cannot read file\n"
sys exit 1
end
fn eres
sys write 2 "ailc: wrong result count\n"
sys exit 1
end
fn eprog
sys write 2 "ailc: program too big\n"
sys exit 1
end
fn ebuf
sys write 2 "ailc: buffers too big\n"
sys exit 1
end
fn elab
sys write 2 "ailc: undefined label\n"
sys exit 1
end
fn efn
sys write 2 "ailc: undefined function\n"
sys exit 1
end
fn eargc
sys write 2 "ailc: wrong argument count\n"
sys exit 1
end
fn erd
sys write 2 "ailc: read error\n"
sys exit 2
end
fn ewr
sys write 2 "ailc: write error\n"
sys exit 2
end
# syntax error unless c is not zero
fn ok c
ifz c
call err
end
end
# syntax error unless c is zero
fn no c
if c
call err
end
end
# duplicate name unless the lookup result i is "not found"
fn nodup i
eq i 99999 as i
ifz i
call edup
end
end

# the output buffer must have room left for what comes before the next
# check: 4096 bytes, more than any statement emits between two checks
fn ochk
sub op out as c
ifgt c 134213632
call eprog
end
end

# ---- input
# the byte at the cursor, or 256 at the end of the input
fn pk
iflt ip ie
loadb ip as c
ret c
end
ret 256
end
fn adv
add ip 1 as ip
end
fn low c
sub c 97 as c
lt c 26 as c
ret c
end
fn dig c
sub c 48 as c
lt c 10 as c
ret c
end
fn blank c
eq c 32 as d
eq c 9 as c
or c d as c
ret c
end
# a CR at the cursor must be the first half of a CRLF line end
fn crlf
add ip 1 as p
set ie as e
jge p e bad
loadb p as c
eq c 10 as c
ifz c
label bad
call err
end
end
fn blanks
label a
call pk as c
call blank c as c
if c
call adv
jmp a
end
end
# one space or tab at least
fn blank1
call pk as c
call blank c as c
call ok c
call blanks
end
# after the last token of a statement: blanks, then a comment or line end
fn eol
call blanks
call pk as c
jeq c 256 k
jeq c 10 k
jeq c 35 k
eq c 13 as d
call ok d
call crlf
label k
end
# a token must be followed by a space, tab, comment or end of line
fn tokchk
call pk as c
jeq c 256 k
call blank c as d
jnz d k
jeq c 10 k
jeq c 13 k
eq c 35 as d
call ok d
label k
end
# read a name [a-z0-9_]* into ns and nl
fn name
set ip as p
set p as ns
label a
call pk as c
jeq c 95 t
call dig c as d
jnz d t
call low c as d
if d
label t
call adv
jmp a
end
sub ip p as e
set e as nl
end
# the same, but it must start with a letter
fn rname
call pk as c
call low c as c
call ok c
call name
end
# 1 if the name read last is "as"
fn isas
jne nl 2 x
set ns as p
loadb p as n
eq n 97 as n
jz n x
add p 1 as p
loadb p as n
eq n 115 as n
ret n
label x
end
# a name that starts with a letter and is not "as"
fn rdname
call rname
call isas as c
call no c
end
# the number at the cursor: decimal, or hexadecimal after "0x", either one
# after an optional "-"; it must fit 64 bits
fn rdnum
call pk as c
eq c 45 as n
if n
call adv
call pk as c
end
call dig c as d
call ok d
set 0 as r
jne c 48 m
add ip 1 as d
jge d ie m
loadb d as d
eq d 120 as d
jz d m
add ip 2 as ip
set 0 as k
label h
call pk as c
call dig c as d
if d
sub c 48 as c
jmp h2
end
or c 32 as c
sub c 97 as c
iflt c 6
add c 10 as c
label h2
add k 1 as k
ifgt k 16
call enum
end
shl r 4 as r
or r c as r
call adv
jmp h
end
call ok k
jmp s
label m
call pk as c
call dig c as d
jz d s
sub c 48 as c
ifle r 0x1999999999999999
jne r 0x1999999999999999 f
jle c 5 f
end
call enum
label f
mul r 10 as r
add r c as r
call adv
jmp m
label s
if n
ifgt r 0x8000000000000000
call enum
end
sub 0 r as r
end
ret r
end

# ---- tables of names
# 1 if the n bytes at a and b are equal
fn eqn a b n
label l
jz n y
loadb a as c
loadb b as d
ne c d as c
ifz c
add a 1 as a
add b 1 as b
sub n 1 as n
jmp l
label y
ret 1
end
end
# 1 if the table entry q holds the name read last
fn same q
add q 8 as t
load t as t
set nl as n
ne t n as t
ifz t
load q as q
set ns as p
call eqn q p n as t
ret t
end
end
# index of the name read last among n entries of z bytes at b, or 99999
fn look b n z
set 0 as i
label a
iflt i n
call same b as t
ifz t
add b z as b
add i 1 as i
jmp a
end
ret i
end
ret 99999
end
# the variable pool of the current scope
fn vbase
set vars as p
set infn as c
if c
add p 1024 as p
end
ret p
end
fn lvar
call vbase as p
set nv as n
call look p n 16 as i
ret i
end
# the top-level variables, also from inside a function
fn ltop
set vars as p
set nv as n
set infn as c
if c
set topvars as n
end
call look p n 16 as i
ret i
end
fn lbuf
set nbufs as n
call look globs n 48 as i
ret i
end
# the entry of global name i
fn gent i
mul i 48 as i
add i globs as i
ret i
end
# the name read last must not be in use at top level or in the open
# function: enter it as the next global name and return its entry
fn newglob
call lvar as c
call nodup c
call ltop as c
call nodup c
call lbuf as c
call nodup c
set nbufs as c
call gent c as p
call putn p
ret p
end
# the syscall number named at the cursor: a const of the program, or else
# one of the names in sysnames
fn sname
call rdname
call lbuf as i
ifne i 99999
call gent i as p
add p 32 as c
load c as c
eq c 2 as c
call ok c
add p 24 as p
load p as p
ret p
end
set sysnames as r
label a
loadb r as l
call ok l
add r 1 as r
jne l nl t
call eqn r ns l as c
jz c t
add r l as r
load2 r as r
ret r
label t
add r l as r
add r 2 as r
jmp a
end
# the value of the const whose name is at the cursor
fn cname
call rdname
call lbuf as i
ne i 99999 as c
call ok c
call gent i as p
add p 32 as c
load c as c
eq c 2 as c
call ok c
add p 24 as p
load p as p
ret p
end
# a label of the current scope: the index counts from labbase
fn llab
set labbase as b
sub nlabels b as n
mul b 40 as b
add b labs as b
call look b n 40 as i
ret i
end
fn lfn
set nfuncs as n
call look funs n 40 as i
ret i
end
# write the name read last into the table entry p, or read it back from it
fn putn p
set ns as c
store p c
add p 8 as p
set nl as c
store p c
end
fn getn p
load p as c
set c as ns
add p 8 as p
load p as c
set c as nl
end
# read a variable name and find it in the pool of the scope, or add it
fn defvar
call rdname
call lbuf as c
jeq c 99999 v
ifz infn
call edup
end
call gent c as c
add c 32 as c
load c as c
eq c 1 as c
jz c v
call edup
label v
call lvar as i
jne i 99999 x
set nv as i
ifge i 64
call evar
end
call vbase as p
mul i 16 as c
add p c as p
call putn p
add i 1 as nv
ifz infn
ifge i 6
add ngv 1 as ngv
mul ngv 8 as c
sub 0x10000000 c as c
mul i 8 as p
add p topcell as p
store p c
end
ret i
end
mul i 8 as p
add p vfirst as p
store p ip
label x
mul i 8 as p
add p vlast as p
store p ip
ret i
end
# where variable i of the current scope lives, as two results: 0 and its
# x86 register, 1 and the address of its cell, 2 and its distance from rsp,
# or for a local 3 and the distance of its bytes from rsp
fn vplace i
ifz infn
iflt i 6
label r
add i varnum as i
loadb i as i
ret 0 i
end
mul i 8 as i
add i topcell as i
load i as i
ret 1 i
end
mul i 8 as c
add c vlocal as c
load c as c
if c
mul fnslots 8 as i
add i c as i
sub i 1 as i
add i pushed as i
ret 3 i
end
ifeq pass 1
set 0 as i
jmp r
end
add i fnloc as i
loadb i as i
jlt i 6 r
mul i 8 as i
sub i 48 as i
add i pushed as i
ret 2 i
end
# the optab row of the name read last, at its operand count, or 0
fn kw
set optab as r
set nl as n
set ns as p
label a
loadb r as l
if l
add r 1 as r
jne l n t
call eqn r p n as c
jz c t
add r l as r
ret r
label t
add r l as r
add r 3 as c
loadb c as c
add r 4 as r
add r c as r
jmp a
end
end
# x86 register number of argument position i
fn areg i
add i argnum as i
loadb i as i
ret i
end

# ---- output
fn eb v
storeb op v
add op 1 as op
end
fn e4 v
store4 op v
add op 4 as op
end
fn z n
add op n as op
end
fn cp a n
set op as p
label l
if n
loadb a as c
storeb p c
add a 1 as a
add p 1 as p
sub n 1 as n
jmp l
end
set p as op
end
# the value of the hexadecimal digit at the cursor, which is consumed
fn hexd
call pk as c
eq c 256 as d
call no d
call adv
call dig c as d
if d
sub c 48 as c
ret c
end
or c 32 as c
sub c 97 as c
lt c 6 as d
call ok d
add c 10 as c
ret c
end
# copy the bytes of a string, whose opening quote is behind the cursor
fn sbytes
label a
call pk as c
eq c 256 as d
call no d
call adv
jeq c 34 x
jne c 92 k
call pk as c
eq c 256 as d
call no d
call adv
ifeq c 110
set 10 as c
jmp k
end
ifeq c 116
set 9 as c
jmp k
end
ifeq c 48
set 0 as c
jmp k
end
jne c 120 k
call hexd as c
shl c 4 as c
call hexd as d
or c d as c
label k
call eb c
call ochk
jmp a
label x
end
# mov <register d>, <register s>, 64-bit
fn mrr d s
shr s 3 as a
shl a 2 as a
shr d 3 as b
or a b as a
or a 72 as a
call eb a
call eb 137
and s 7 as s
shl s 3 as s
and d 7 as d
or s d as s
or s 192 as s
call eb s
end
# the row of regtab and argnum for the next value of the statement: its
# position, or 7 (r11) for a value of a call after the sixth. For callp the
# first value, the address, takes row 8 (rcx) and the rest are those of a call
fn aidx
add cur 2 as c
loadb c as c
and c 4 as c
if c
ifz ai
ret 8
end
sub ai 1 as i
jmp g
end
set ai as i
add cur 1 as c
loadb c as c
and c 16 as c
if c
label g
jlt i 6 b
ret 7
end
lt ai 7 as c
call ok c
label b
ret i
end
# the value is in its register: push it if it goes on the stack, count it
fn anext
set ai as i
add cur 2 as c
loadb c as c
and c 4 as c
if c
sub i 1 as i
jmp b
end
add cur 1 as c
loadb c as c
and c 16 as c
jz c x
label b
jslt i 6 x
call eb 65
call eb 83
add pushed 8 as pushed
label x
add ai 1 as ai
end
# mov <register of the next argument>, v, in its shortest form
fn mov v
call aidx as i
shr v 32 as c
ifz c
mul i 2 as r
add r regtab as r
loadb r as c
if c
call eb c
end
add r 1 as r
loadb r as c
call eb c
set op as immpos
call e4 v
jmp x
end
call areg i as r
shr r 3 as c
or c 72 as c
call eb c
and r 7 as r
ifge v 0xffffffff80000000
call eb 199
or r 192 as r
call eb r
call e4 v
jmp x
end
or r 184 as r
call eb r
store op v
add op 8 as op
label x
call anext
end
# a 64-bit mov between the register g and memory: the address p (k = 1) or
# rsp + p (k = 2); o = 139 to load the register, 137 to store it
fn emem g k p o
shr g 3 as c
shl c 2 as c
or c 72 as c
call eb c
call eb o
and g 7 as g
shl g 3 as g
ifeq k 1
or g 4 as g
call eb g
call eb 37
call e4 p
ret 0
end
or g 132 as g
call eb g
call eb 36
call e4 p
end
# the same between the register g and variable i of the current scope; a
# local is not stored to, and loading it gives its address (lea, 141)
fn vmov i g o
call vplace i as k p
ifz k
ifeq o 139
call mrr g p
ret 0
end
call mrr p g
ret 0
end
ifeq k 3
call emem g 2 p 141
ret 0
end
call emem g k p o
end
# mov <register of the next argument>, [a]: read the cell of a var
fn ldvar a
call aidx as i
call areg i as r
call emem r 1 a 139
call anext
end
# 1 if the statement is at and this is its first value, which must be a name
fn atfirst
ifz ai
add cur 2 as c
loadb c as c
and c 1 as c
ret c
end
end
# record that the imm32 just written stands for the name read last: k = 0
# its address, 1 its length, 2 the bytes from it to the end of its object
fn addref k
mul nrefs 32 as p
add p refs as p
call putn p
add p 16 as q
store q immpos
add p 24 as q
store q k
add nrefs 1 as nrefs
end
# the innermost open block, which the statement at hand closes or continues;
# the jump recorded for it lands here
fn blktop
sub nblk 1 as p
mul p 24 as p
add p blks as p
load p as d
sub op d as c
sub c 4 as c
store4 d c
ret p
end
# where to note what is known of the next value of the statement
fn opdp
set ai as i
ifge i 2
set 2 as i
end
mul i 32 as i
add i opd as i
ret i
end
# note that the next value is the address of the global name read last
fn opda
call opdp as p
store p 2
add p 8 as p
store p ns
add p 8 as p
store p nl
add p 8 as p
store p 0
end
# copy the four cells at a to b
fn cp4 a b
set 4 as n
label l
load a as c
store b c
add a 8 as a
add b 8 as b
sub n 1 as n
jnz n l
end
# forget what is known of the variables: at a label and at the end of a
# function (the first pass over the next one may see stale knowledge, but
# its checks are dropped)
fn clrvk
set vk as p
set 64 as n
label a
store p 0
add p 32 as p
sub n 1 as n
jnz n a
end
# the statement assigns variable i: note what is known of the new value.
# Only set, add and sub carry knowledge
fn prop i
mul i 32 as k
add k vk as k
store k 0
add cur 1 as c
load2 c as c
ne c 1 as c
jnz c x
add cur 3 as n
loadb n as n
ifz n
load opd as c
eq c 3 as c
jnz c x
set 0 as d
jmp e
end
jne n 3 x
add cur 4 as c
load4 c as c
and c 0xffffff as c
add opd 32 as q
load q as t
add q 8 as q
load q as u
ifne c 0xf80148
jne c 0xf82948 x
jne t 1 x
sub 0 u as d
jmp e
end
jne t 1 f
set u as d
label e
load opd as c
jeq c 1 g
jne c 2 x
store k 2
add opd 8 as q
load q as c
add k 8 as n
store n c
add opd 16 as q
load q as c
add k 16 as n
store n c
add opd 24 as q
load q as c
add c d as c
add k 24 as n
store n c
ret 0
label g
store k 1
add opd 8 as q
load q as c
add c d as c
add k 8 as n
store n c
ret 0
label f
load opd as c
ne c 1 as c
jnz c x
jne t 2 x
add opd 8 as q
load q as d
store k 2
add k 8 as n
store n u
add opd 48 as q
load q as c
add k 16 as n
store n c
add opd 56 as q
load q as c
add c d as c
add k 24 as n
store n c
label x
end
# a load or store, r = its row: check an access through a string now, and
# note one through a global name plus a number for the end
fn memchk r
sub r 1 as c
loadb c as c
set 8 as w
ifeq c 98
set 1 as w
end
ifeq c 50
set 2 as w
end
ifeq c 52
set 4 as w
end
add r 1 as c
loadb c as c
and c 2 as c
if c
or w 256 as w
end
load opd as c
ifeq c 3
and w 256 as d
if d
call eacc
end
and w 255 as d
add opd 8 as c
load c as c
gt d c as d
jz d x
call eacc
end
jne c 2 x
mul nchks 32 as p
add p chks as p
add opd 8 as c
load c as c
store p c
add opd 16 as c
load c as c
add p 8 as p
store p c
add opd 24 as c
load c as c
add p 8 as p
store p c
add p 8 as p
store p w
add nchks 1 as nchks
label x
end
# no way leads to the code that follows, until a label: remember what was
# assigned and take everything as assigned
fn godead
ifz dead
set asg as jmask
set 1 as dead
set -1 as asg
end
end
# the label read last is being defined: asg becomes what is assigned on
# every way to it, the line before and each jump seen so far; a label that
# only later jumps reach starts from jmask
fn labasg
set asg as m
set 0 as k
sub nfix fixbase as n
mul fixbase 32 as p
add p fixs as p
label a
if n
call same p as c
if c
add p 24 as c
load c as c
and m c as m
add k 1 as k
end
add p 32 as p
sub n 1 as n
jmp a
end
jz dead x
jnz k x
set jmask as m
label x
set m as asg
set 0 as dead
end
# sub rsp, <frame> (o = 236) or add rsp, <frame> (o = 196), when the
# function has stack slots
fn frame o
mul fnslots 8 as c
add c fnlocal as c
if c
jne o 236 s
jlt c 4096 s
call cp probe 36
sub op 34 as d
store4 d c
ret 0
label s
call eb 72
call eb 129
call eb o
call e4 c
end
end
# how many bytes of the six pops to leave out: those of the registers that
# the function does not use and so did not save
fn popskip
add fnregs pushlen as c
loadb c as c
sub 10 c as c
ret c
end
# no variable is a local: where a function starts and ends
fn clrloc
set vlocal as p
set 64 as n
label a
store p 0
add p 8 as p
sub n 1 as n
jnz n a
end
# give each of the nv variables of the function a place. A variable is in
# use from its definition to its last mention; if that range meets a loop,
# to the end of the loop. A place is free for a variable defined after the
# last mention of the one that had it.
fn alloc
label a
set 0 as g
set nloops as n
set loops as b
label l
jz n e
load b as lo
add b 8 as t
load t as hi
set 0 as i
label v
iflt i nv
mul i 8 as k
add k vfirst as t
load t as t
gt t hi as t
jnz t s
add k vlast as k
load k as t
jlt t lo s
jge t hi s
store k hi
set 1 as g
label s
add i 1 as i
jmp v
end
add b 16 as b
sub n 1 as n
jmp l
label e
jnz g a
set 0 as i
label z
mul i 8 as t
add t locfree as t
store t 0
add i 1 as i
jlt i 70 z
set 0 as fnslots
set 0 as fnregs
set 0 as i
label p
jge i nv x
mul i 8 as k
add k vlocal as t
load t as t
jnz t c
add k vfirst as t
load t as lo
add k vlast as t
load t as hi
set 0 as j
label q
mul j 8 as t
add t locfree as t
load t as u
lt u lo as u
ifz u
add j 1 as j
jmp q
end
store t hi
add i fnloc as t
storeb t j
iflt j 6
jlt j fnregs c
add j 1 as fnregs
jmp c
end
sub j 5 as j
jle j fnslots c
set j as fnslots
label c
add i 1 as i
jmp p
label x
end
# the code of the statement, after checking its operand count; a call
# also leaves room for its rel32 and is recorded
fn eop
set cur as r
add r 1 as f
loadb f as f
and f 20 as c
jnz c k
add r 2 as c
loadb c as c
and c 4 as c
if c
call ok ai
jmp k
end
and f 32 as c
if c
call ok ai
gt ai 6 as c
call no c
ifz fnres
set ai as fnres
end
jeq fnres ai k
call eres
end
loadb r as c
set ai as i
eq c i as c
call ok c
label k
and f 128 as c
if c
call memchk r
end
and f 32 as c
jz c m
and f 16 as c
if c
gt ai 6 as c
call no c
set 1 as fntail
end
call frame 196
call godead
call popskip as n
add r 3 as c
loadb c as c
sub c n as c
add r 4 as p
add p n as p
call cp p c
jmp h
label m
add r 3 as c
loadb c as c
add r 4 as p
call cp p c
label h
and f 16 as f
jz f w
set ai as i
add cur 2 as c
loadb c as c
and c 2 as c
if c
call no ai
eq ncap 1 as c
call ok c
set 0xffffffff as i
end
set ncalls as n
mul n 32 as p
add p calls as p
set cn as c
store p c
set cl as c
add p 8 as r
store r c
set op as c
add p 16 as r
store r c
add p 24 as r
store4 r i
add p 28 as r
store4 r ncap
call z 4
add n 1 as ncalls
label w
if pushed
call eb 72
call eb 129
call eb 196
call e4 pushed
set 0 as pushed
end
end
# fill in the jumps of the current scope, now that its labels are known
fn resolve
set fixbase as i
sub nfix i as n
mul i 32 as p
add p fixs as p
label a
jz n x
call getn p
call llab as c
ifeq c 99999
call elab
end
set labbase as i
add c i as c
mul c 40 as c
add c labs as c
add c 16 as c
load c as c
add p 16 as i
load i as i
sub c i as c
sub c 4 as c
store4 i c
add p 32 as p
sub n 1 as n
jmp a
label x
end

# ---- start: a closed output pipe must be a write error, not a death
store sig 1
sys rt_sigaction 13 sig 0 8
set in as p
add in inmax as q
label rd
sub q p as r
ifz r
call ebig
end
sys read 0 p r as r
if r
ifgt r inmax
call erd
end
add p r as p
jmp rd
end
set p as ie
set p as srcend
set in as ip
set out as op
call cp hdr 176

# ---- statement
label next
call ochk
call pk as c
jeq c 256 uend
call blank c as d
jnz d n1
jeq c 10 n1
jeq c 35 n2
ifeq c 13
call crlf
label n1
call adv
jmp next
label n2
call adv
call pk as c
jeq c 256 uend
jeq c 10 next
jne c 13 n2
call crlf
jmp n2
end
call rname
call kw as r
call ok r
add r 1 as f
loadb f as f
ifeq f 255
loadb r as d
jeq d 1 fndef
jeq d 2 bufdef
jeq d 3 fnend
jeq d 4 labdef
jeq d 5 datadef
jeq d 6 vardef
jeq d 7 constdef
jeq d 8 localdef
jeq d 9 usedef
jmp elsedef
end
set r as cur
set 0 as ai
set 0 as ncap
store opd 0
add opd 32 as d
store d 0
call pk as c
call blank c as d
call ok d
call blanks
and f 32 as d
if d
set infn as d
call ok d
end
add cur 2 as d
loadb d as d
and d 16 as d
if d
call no infn
end
and f 16 as d
if d
call rname
set ns as d
set d as cn
set nl as d
set d as cl
jmp tokend
end
and f 4 as d
jz d arg
call pk as c
call low c as d
jz d num
call sname as r
call mov r
jmp tokend

# the end of a unit of source: go on after the use that named it, or finish
label uend
jz nustk fin
call no infn
sub nustk 1 as nustk
mul nustk 16 as p
add p ustack as p
load p as ip
add p 8 as p
load p as ie
jmp next

# "use "<path>"": read the file behind the source read so far and compile
# it here, unless a use with the same path was compiled before
label usedef
call no infn
call blank1
call pk as c
eq c 34 as d
call ok d
call adv
set ip as p
label u1
call pk as c
eq c 256 as d
call no d
ifne c 34
eq c 10 as d
call no d
call adv
jmp u1
end
sub ip p as q
call adv
call eol
set p as ns
set q as nl
call ok q
gt q 4095 as d
call no d
call look uses nuses 16 as r
jne r 99999 next
mul nuses 16 as r
add r uses as r
call putn r
add nuses 1 as nuses
set pathbuf as r
label u8
if q
loadb p as c
storeb r c
add p 1 as p
add r 1 as r
sub q 1 as q
jmp u8
end
storeb r 0
sys open pathbuf 0 0 as f
ifslt f 0
call euse
end
set srcend as r
label u4
add in inmax as q
sub q srcend as q
ifz q
call ebig
end
sys read f srcend q as c
ifslt c 0
call euse
end
if c
add srcend c as srcend
jmp u4
end
sys close f
mul nustk 16 as p
add p ustack as p
store p ip
add p 8 as p
store p ie
add nustk 1 as nustk
set r as ip
set srcend as ie
jmp next

# ---- arguments
# every token must be followed by a space, tab, comment or end of line
label tokend
call tokchk
label arg
call ochk
call pk as c
jeq c 256 a1
jeq c 10 a1
jeq c 35 a1
call blank c as d
jnz d a2
ifne c 13
jeq c 34 str
call low c as d
jnz d ident
jeq c 45 num
call dig c as d
jnz d num
call err
end
call crlf
label a1
set cur as r
add r 1 as f
loadb f as f
and f 9 as f
call no f
call eop
add cur 2 as f
loadb f as f
and f 8 as f
jz f next
mul nblk 24 as p
add p blks as p
store p op
add p 8 as p
store p asg
add p 8 as p
store p 0
call z 4
add nblk 1 as nblk
jmp next
label a2
call adv
jmp arg

label num
call atfirst as d
call no d
call rdnum as r
add cur 1 as d
loadb d as d
and d 64 as d
call no d
call opdp as p
store p 1
add p 8 as p
store p r
call mov r
jmp tokend

# string: the bytes go into the code behind a jmp. sys and call get two
# values (address, length), len the length, the rest the address
label str
call atfirst as d
call no d
call adv
call eb 233
set op as r
call z 4
set op as p
call sbytes
sub op p as q
store4 r q
call opdp as d
store d 3
add d 8 as d
store d q
add cur 1 as r
loadb r as r
and r 64 as d
jnz d s1
sub p out as p
add p 0x400000 as p
call mov p
and r 20 as d
jnz d s1
add cur 2 as d
loadb d as d
and d 4 as d
jz d tokend
label s1
call mov q
jmp tokend

# a name: a variable or buffer to pass, "as", or the label of a jump
label ident
call name
set cur as r
add r 1 as f
loadb f as f
and f 8 as f
if f
loadb r as f
jge ai f jtarget
end
call isas as d
jnz d capture
call atfirst as d
jnz d atname
add cur 1 as r
loadb r as r
and r 64 as d
if d
call lbuf as r
ifeq r 99999
call mov 0
set 1 as r
jmp i9
end
call gent r as r
add r 32 as d
load d as d
call no d
add r 24 as r
load r as r
call mov r
jmp tokend
end
call lvar as r
jeq r 99999 i2
mul r 8 as d
add d vlast as d
store d ip
shr asg r as d
and d 1 as d
ifz d
call eunasg
end
call opdp as d
mul r 32 as f
add f vk as f
call cp4 f d
call aidx as d
call areg d as f
call vmov r f 139
call anext
jmp tokend
label i2
call lbuf as r
jne r 99999 i4
call opda
call mov 0
set 0 as r
label i9
call addref r
jmp tokend

# the first value of at: a name, passed as its address and its size
label atname
call lvar as r
ifne r 99999
mul r 8 as d
add d vlocal as d
load d as d
call ok d
mul r 8 as d
add d vlast as d
store d ip
call vmov r 0 139
set 1 as ai
mul r 8 as d
add d vlocsz as d
load d as d
call mov d
jmp tokend
end
call lbuf as r
ifne r 99999
call gent r as p
add p 32 as d
load d as d
call no d
add p 16 as d
load d as d
call mov d
jmp at4
end
call mov 0
call addref 0
label at4
call mov 0
call addref 2
jmp tokend
label i4
call gent r as p
add p 32 as d
load d as d
ifne d 1
ifeq d 2
add p 24 as r
load r as r
call opdp as d
store d 1
add d 8 as d
store d r
call mov r
jmp tokend
end
add p 16 as r
load r as r
call opda
call mov r
jmp tokend
end
add p 16 as r
load r as r
call ldvar r
jmp tokend

# "as <name>": emit the statement and keep rax in the variable
label capture
add cur 1 as r
loadb r as r
and r 2 as r
call no r
label cp0
call blanks
set ip as q
call rdname
call lbuf as r
jeq r 99999 cp1
call gent r as p
add p 32 as d
load d as d
eq d 1 as d
jz d cp1
add p 16 as p
load p as p
set 1 as f
jmp cp3
label cp1
set q as ip
call defvar as p
mul p 8 as d
add d vlocal as d
load d as d
if d
call edup
end
set 0 as f
label cp3
lt ncap 6 as d
call ok d
mul ncap 16 as d
add d caps as d
store d f
add d 8 as d
store d p
add ncap 1 as ncap
call blanks
call pk as c
jeq c 256 cp4
jeq c 10 cp4
jeq c 13 cp4
jeq c 35 cp4
add cur 1 as d
loadb d as d
and d 16 as d
jnz d cp0
add cur 2 as d
loadb d as d
and d 4 as d
jnz d cp0
call err
label cp4
call eol
call eop
set 0 as r
label cp5
jge r ncap next
mul r 16 as d
add d caps as d
load d as f
add d 8 as d
load d as p
call areg r as q
ifz f
shl 1 p as d
or asg d as asg
call prop p
call vmov p q 137
jmp cp7
end
call emem q 1 p 137
label cp7
add r 1 as r
jmp cp5

# "buf <name> <size>"
label bufdef
call blank1
call rdname
call newglob as p
call blank1
call pk as c
call low c as d
if d
call cname as r
jmp b2
end
call rdnum as r
label b2
ifgt r 0xf0000000
