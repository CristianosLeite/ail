call eol
jmp next

# "const <name> <number>"
label constdef
call blank1
call rdname
call newglob as p
call blank1
call rdnum as r
call eol
add p 24 as q
store q r
add p 32 as q
store q 2
add nbufs 1 as r
set r as nbufs
jmp next

# "data [<name>] <item>...": bytes behind a jmp; data statements that
# follow each other share the jmp, so their bytes are contiguous
label datadef
call blank1
set 0 as f
call pk as c
eq c 256 as d
call no d
call low c as d
if d
call rdname
call newglob as p
call tokchk
set 1 as f
