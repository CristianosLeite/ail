end
sub fnnpar r as d
add d fnslots as d
add d fnregs as d
mul d 8 as d
add d fnlocal as d
call emem 11 2 d 139
call vmov r 11 137
jmp f1
label f2
call eol
set nv as fnnpar
set nv as q
