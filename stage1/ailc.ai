shl 1 p as d
or asg d as asg
call prop p
call vmov p q 137
jmp cp7
end
call emem q 1 p 137
label cp7
add r 1 as r
jmp cp5

# "buf <name> <size>"
label bufdef
call blank1
call rdname
call newglob as p
call blank1
call pk as c
call low c as d
if d
call cname as r
jmp b2
end
call rdnum as r
label b2
