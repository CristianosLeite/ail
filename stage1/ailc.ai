add d vlocal as d
load d as d
if d
call edup
end
set 0 as f
label cp3
lt ncap 6 as d
call ok d
mul ncap 16 as d
add d caps as d
store d f
add d 8 as d
store d p
add ncap 1 as ncap
call blanks
call pk as c
jeq c 256 cp4
jeq c 10 cp4
jeq c 13 cp4
jeq c 35 cp4
add cur 1 as d
loadb d as d
and d 16 as d
