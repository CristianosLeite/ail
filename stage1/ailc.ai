# "end" with a block open: what is assigned after it is what both ways
# here have assigned, its last line and the jump past it, or after an else
# part the last line of the part before
label blkend
call eol
sub nblk 1 as p
mul p 40 as p
add p blks as p
add p 24 as q
load q as r
if r
# the end of a while: jump back to its head. That way there must have
# assigned what the head had assigned, like a jump back to a label, and in
# the first pass over a function the loop is noted for alloc. After the
# loop, what is assigned is what the head had: the only way out is its test.
ifz dead
add p 8 as q
load q as q
xor asg -1 as f
and q f as q
if q
call eunasgj
end
end
ifeq pass 1
add p 32 as q
load q as q
mul nloops 16 as d
add d loops as d
store d q
add d 8 as d
store d ip
add nloops 1 as nloops
end
call eb 233
sub r op as r
sub r 4 as r
call e4 r
call blktop as p
sub nblk 1 as nblk
add p 8 as q
load q as q
set q as asg
set 0 as dead
jmp be3
end
call blktop as p
sub nblk 1 as nblk
add p 16 as q
load4 q as d
if d
add p 20 as q
load4 q as d
jnz d be3
end
add p 8 as q
load q as q
if dead
set q as asg
set 0 as dead
jmp be3
end
and asg q as asg
label be3
call clrvk
set 0 as dataend
jmp next

# "else": the block so far ends with a jump past the rest, and the jump of
# its "if" lands here
label elsedef
ifle nblk blkbase
call eplace
end
call eol
sub nblk 1 as p
mul p 40 as p
add p blks as p
add p 24 as q
load q as d
if d
call eplace
end
call eb 233
set op as r
call z 4
call blktop as p
add p 16 as q
load4 q as d
if d
call eplace
end
store p r
add p 8 as q
load q as f
store q asg
add p 20 as q
store4 q dead
add p 16 as q
store4 q 1
set f as asg
set 0 as dead
call clrvk
jmp next

# "while <value>": an "if <value>" whose block ends with a jump back to
# here. The head is a place that a jump reaches, so what is known of the
# variables is forgotten, as at a label.
label whiledef
call blank1
call clrvk
set 0 as dataend
set op as whead
set ip as wsrc
set exnm as p
store2 p 0x6669
set p as ns
set 2 as nl
call kw as r
set r as cur
set 0 as ai
