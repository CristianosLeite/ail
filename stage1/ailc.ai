call eol
add p 32 as q
store q 0
add p 40 as q
store q 0
add p 24 as q
store q r
add r 7 as r
shr r 3 as r
shl r 3 as r
set bsssz as q
add r q as r
ifgt r 0x7fffffff
call ebuf
end
set r as bsssz
add p 16 as p
store p q
call globdone
jmp next

# "local <name> <size>": bytes in the frame of the open function; the name
# takes one of its variables, whose value is the address
label localdef
ifz infn
call eplace
end
call blank1
set nv as q
call defvar as r
ifeq nv q
call edup
end
call blank1
call pk as c
call low c as d
