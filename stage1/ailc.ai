end
end
# fill in the jumps of the current scope, now that its labels are known
fn resolve
set fixbase as i
sub nfix i as n
mul i 32 as p
add p fixs as p
label a
jz n x
call getn p
set ns as epos
call llab as c
ifeq c -1
