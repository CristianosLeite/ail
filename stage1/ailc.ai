# after the name that starts a line: 0, or 1 for "=", or 2 + an operator
# for the operator and "=", with the cursor behind the "="
fn exasg
call pk as c
add ip 1 as p
jge p ie n
loadb p as d
ifeq c 61
jeq d 61 n
call adv
ret 1
end
set 99 as o
ifeq c 42
set 0 as o
