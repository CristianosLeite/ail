end
set r as bsssz
add q 0x10000000 as q
add p 16 as p
store p q
add nbufs 1 as r
set r as nbufs
jmp next

# "local <name> <size>": bytes in the frame of the open function; the name
# takes one of its variables, whose value is the address
label localdef
call ok infn
call blank1
set nv as q
call defvar as r
ifeq nv q
call edup
end
call blank1
call pk as c
call low c as d
if d
call cname as p
jmp l3
end
call rdnum as p
label l3
ifgt p 0x7ffffff0
call ebuf
end
call eol
mul r 8 as d
add d vlocsz as d
store d p
add p 7 as p
shr p 3 as p
shl p 3 as p
mul r 8 as d
add d vlocal as d
add loccur 1 as c
store d c
add p loccur as p
ifgt p 0x7ffffff0
call ebuf
end
set p as loccur
shl 1 r as d
or asg d as asg
mul r 32 as d
add d vk as d
store d 0
jmp next

# "var <name>...": global cells, below the buffers, the first one highest
label vardef
call blank1
label v1
call rdname
