add p 7 as p
shr p 3 as p
shl p 3 as p
mul r 8 as d
add d vlocal as d
add loccur 1 as c
store d c
add p loccur as p
ifgt p 0x7ffffff0
call ebuf
end
set p as loccur
shl 1 r as d
or asg d as asg
mul r 32 as d
add d vk as d
store d 0
jmp next

# "var <name>...": global cells, below the buffers, the first one highest
label vardef
call blank1
label v1
call rdname
