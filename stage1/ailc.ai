end
label n
ret 0
end
# "<name>=<expression>", or with operator f before the "=" (-1 for none):
# compute the expression, with the name as its left operand if there is an
# operator, and keep the result as "as <name>" would
fn exasn f
set ns as ts
set nl as tl
call exinit
set 0 as m
ifne f -1
call exname
set 1 as m
end
call exparse m
ifne f -1
call exred f
end
