jnz d s1
call elea
sub p immpos as c
sub c 4 as c
store4 immpos c
and r 20 as d
jnz d s1
add cur 2 as d
loadb d as d
and d 4 as d
jz d tokend
label s1
call mov q
jmp tokend

# a name: a variable or buffer to pass, "as", or the label of a jump
label ident
call name
