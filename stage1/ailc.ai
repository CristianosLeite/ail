set labbase as i
add c i as c
mul c 40 as c
add c labs as c
add c 16 as c
load c as c
add p 16 as i
load i as i
sub c i as c
sub c 4 as c
store4 i c
add p 32 as p
sub n 1 as n
jmp a
label x
set 0 as epos
end

# ---- start: a closed output pipe must be a write error, not a death
store sig 1
sys rt_sigaction 13 sig 0 8
set in as p
add in inmax as q
label rd
sub q p as r
ifz r
call ebig
end
sys read 0 p r as r
if r
ifgt r inmax
call erd
end
add p r as p
jmp rd
end
set p as ie
set p as srcend
set p as mainend
set in as ip
set out as op
call cp hdr 176

# ---- statement
label next
call ochk
call pk as c
jeq c 256 uend
call blank c as d
jnz d n1
jeq c 10 n1
jeq c 35 n2
ifeq c 13
call crlf
label n1
call adv
jmp next
label n2
call adv
call pk as c
jeq c 256 uend
jeq c 10 next
jne c 13 n2
call crlf
jmp n2
end
call pk as c
call low c as d
ifz d
call estmt
end
call name
call exasg as d
jnz d asgn
call kw as r
ifz r
call estmt
end
add r 1 as f
loadb f as f
ifeq f 255
loadb r as d
jeq d 1 fndef
jeq d 2 bufdef
jeq d 3 fnend
jeq d 4 labdef
jeq d 5 datadef
jeq d 6 vardef
jeq d 7 constdef
jeq d 8 localdef
jeq d 9 usedef
jeq d 10 elsedef
jmp whiledef
end
set r as cur
set 0 as ai
set 0 as ncap
store opd 0
add opd 32 as d
store d 0
call pk as c
call blank c as d
call ok d
call blanks
and f 32 as d
if d
ifz infn
call eplace
end
end
add cur 2 as d
loadb d as d
and d 16 as d
if d
if infn
call eplace
end
end
and f 16 as d
if d
call rname
set ns as d
set d as cn
set nl as d
set d as cl
jmp tokend
end
and f 4 as d
jz d arg
call pk as c
call low c as d
jz d num
call sname as r
call mov r
jmp tokend

# "<name>=<expression>" and "<name><operator>=<expression>"
label asgn
sub d 2 as d
call exasn d
jmp next

# the end of a unit of source: go on after the use that named it, or finish
label uend
jz nustk fin
if infn
call eend
end
sub nustk 1 as nustk
mul nustk 8 as p
add p ucur as p
load p as curunit
mul nustk 16 as p
add p ustack as p
load p as ip
add p 8 as p
load p as ie
jmp next

# "use "<path>"": read the file behind the source read so far and compile
# it here, unless a use with the same path was compiled before
label usedef
if infn
call eplace
end
call blank1
call pk as c
eq c 34 as d
call ok d
call adv
set ip as p
label u1
call pk as c
ifeq c 256
call estr
end
ifne c 34
ifeq c 10
call estr
end
call adv
jmp u1
end
sub ip p as q
call adv
call eol
set p as ns
set q as nl
call ok q
gt q 4095 as d
call no d
call look uses nuses 16 as r
jne r -1 next
mul nuses 16 as r
add r uses as r
call putn r
add nuses 1 as nuses
set pathbuf as r
label u8
if q
loadb p as c
storeb r c
add p 1 as p
add r 1 as r
sub q 1 as q
jmp u8
end
storeb r 0
set ns as epos
sys open pathbuf 0 0 as f
ifslt f 0
call euse
end
set srcend as r
label u4
add in inmax as q
sub q srcend as q
ifz q
call ebig
end
sys read f srcend q as c
ifslt c 0
call euse
end
if c
add srcend c as srcend
jmp u4
end
sys close f
set 0 as epos
mul nuses 8 as p
add p ustart as c
sub c 8 as c
store c r
add p uendp as c
sub c 8 as c
store c srcend
mul nustk 8 as p
add p ucur as p
store p curunit
set nuses as curunit
mul nustk 16 as p
add p ustack as p
store p ip
add p 8 as p
store p ie
add nustk 1 as nustk
set r as ip
set srcend as ie
jmp next

# ---- arguments
# every token must be followed by a space, tab, comment or end of line
label tokend
call tokchk
label arg
call ochk
call pk as c
jeq c 256 a1
jeq c 10 a1
jeq c 35 a1
call blank c as d
jnz d a2
ifne c 13
jeq c 34 str
call excomp as d
jnz d earg
call low c as d
jnz d ident
jeq c 45 num
call dig c as d
jnz d num
call err
end
call crlf
label a1
set cur as r
add r 1 as f
loadb f as f
and f 8 as d
if d
call emlab
end
and f 1 as d
if d
call eas
end
call eop
add cur 2 as f
loadb f as f
and f 8 as f
jz f next
mul nblk 40 as p
add p blks as p
store p op
add p 8 as p
store p asg
add p 8 as p
store p 0
add p 8 as p
store p whead
add p 8 as p
store p wsrc
set 0 as whead
call z 4
add nblk 1 as nblk
jmp next
label a2
call adv
jmp arg

# an expression: not where a name must stand (the first value of at, the
# operand of len, the label of a jump)
label earg
call atfirst as d
call no d
add cur 1 as r
loadb r as r
and r 64 as d
call no d
and r 8 as d
if d
loadb cur as d
ifge ai d
call err
end
end
call exinit
call exparse 0
call excond as d
jnz d tokend
call exarg
jmp tokend

label num
call atfirst as d
call no d
call rdnum as r
add cur 1 as d
loadb d as d
and d 64 as d
call no d
call opdp as p
store p 1
add p 8 as p
store p r
call mov r
jmp tokend

# string: the bytes go into the code behind a jmp. sys and call get two
# values (address, length), len the length, the rest the address
label str
call atfirst as d
call no d
call adv
