fn clrloc
set vlocal as p
set 64 as n
label a
store p 0
add p 8 as p
sub n 1 as n
jnz n a
end
# give each of the nv variables of the function a place. A variable is in
# use from its definition to its last mention; if that range meets a loop,
# to the end of the loop. A place is free for a variable defined after the
# last mention of the one that had it.
fn alloc
label a
set 0 as g
set nloops as n
set loops as b
label l
jz n e
load b as lo
add b 8 as t
load t as hi
set 0 as i
label v
iflt i nv
mul i 8 as k
add k vfirst as t
load t as t
gt t hi as t
jnz t s
add k vlast as k
load k as t
jlt t lo s
jge t hi s
store k hi
set 1 as g
label s
add i 1 as i
jmp v
end
add b 16 as b
sub n 1 as n
jmp l
label e
jnz g a
set 0 as i
label z
mul i 8 as t
add t locfree as t
store t 0
add i 1 as i
jlt i 70 z
set 0 as fnslots
set 0 as fnregs
set 0 as i
label p
jge i nv x
mul i 8 as k
add k vlocal as t
load t as t
jnz t c
add k vfirst as t
load t as lo
add k vlast as t
load t as hi
set 0 as j
label q
mul j 8 as t
add t locfree as t
load t as u
lt u lo as u
ifz u
add j 1 as j
jmp q
end
store t hi
add i fnloc as t
storeb t j
iflt j 6
jlt j fnregs c
add j 1 as fnregs
jmp c
end
sub j 5 as j
jle j fnslots c
set j as fnslots
label c
add i 1 as i
jmp p
label x
end
# the code of the statement, after checking its operand count; a call
# also leaves room for its rel32 and is recorded
fn eop
set cur as r
add r 1 as f
loadb f as f
and f 20 as c
jnz c k
add r 2 as c
loadb c as c
and c 4 as c
if c
ifz ai
call ecount
end
jmp k
end
and f 32 as c
if c
ifz ai
call ecount
end
ifgt ai 6
call ecount
end
ifz fnres
set ai as fnres
end
jeq fnres ai k
call eres
end
loadb r as c
ifne c ai
call ecount
end
label k
and f 128 as c
if c
call memchk r
end
and f 32 as c
jz c m
and f 16 as c
if c
ifgt ai 6
call ecount
end
set 1 as fntail
end
call frame 196
call godead
call popskip as n
add r 3 as c
loadb c as c
sub c n as c
add r 4 as p
add p n as p
call cp p c
jmp h
label m
add r 3 as c
loadb c as c
add r 4 as p
add p xskip as p
sub c xskip as c
set 0 as xskip
call cp p c
label h
and f 16 as f
jz f w
set ai as i
add cur 2 as c
loadb c as c
and c 2 as c
if c
if ai
call ecount
end
eq ncap 1 as c
