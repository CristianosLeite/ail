# print how many bytes of stdin were read (at most 4096) as four digits
buf in 4096
buf out 8
sys 0 0 in 4096 as n

div n 1000 as d         # thousands
add d 48 as d           # 48 is "0"
storeb out d

mod n 1000 as r         # hundreds
div r 100 as d
add d 48 as d
add out 1 as p
storeb p d

mod r 100 as r          # tens
div r 10 as d
add d 48 as d
add p 1 as p
storeb p d

mod r 10 as d           # units
add d 48 as d
add p 1 as p
storeb p d

add p 1 as p
storeb p 10             # newline
sys 1 1 out 5
