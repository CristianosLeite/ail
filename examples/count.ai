# print how many bytes of stdin were read (at most 4096) as four digits;
# exit status 1 if reading or printing fails
buf in 4096
buf out 8
sys 0 0 in 4096 as n    # n = bytes read, or a negative error
gt n 4096 as e          # unsigned: a negative n is far above 4096
jnz e fail

div n 1000 as d         # thousands
add d 48 as d           # 48 is "0"
storeb out d

mod n 1000 as r         # hundreds
div r 100 as d
add d 48 as d
add out 1 as p
storeb p d

mod r 100 as r          # tens
div r 10 as d
add d 48 as d
add p 1 as p
storeb p d

mod r 10 as d           # units
add d 48 as d
add p 1 as p
storeb p d

add p 1 as p
storeb p 10             # newline
sys 1 1 out 5 as w      # w = bytes written, or a negative error
ne w 5 as e             # a short write counts as a failure
jnz e fail
sys 60 0
label fail
sys 60 1
