# add up the lengths of the Collatz sequences that start at 1 to n, an
# 8-byte number read from stdin (at most 10000000), and write the sum
# as 8 bytes; exit status 1 on failure
buf b 8
sys read 0 b 8 as n
jne n 8 fail
load b as n
jgt n 10000000 fail
set 0 as c
label start
jz n done
set n as x
label step
jeq x 1 next
add c 1 as c
mod x 2 as r
if r
mul x 3 as x
add x 1 as x
else
div x 2 as x
end
jmp step
label next
sub n 1 as n
jmp start
label done
store b c
sys write 1 b 8 as n
jne n 8 fail
sys exit 0
label fail
sys exit 1
