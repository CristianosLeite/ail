# print how many bytes of stdin were read (at most 4096) as four digits;
# exit status 1 if reading or printing fails
buf in 4096
buf out 8
rt read 0 in 4096 as n    # n = bytes read, or a negative error
jgt n 4096 fail         # unsigned: a negative n is far above 4096
storeb out 48+n/1000    # 48 is "0"
storeb out+1 48+n/100%10
storeb out+2 48+n/10%10
storeb out+3 48+n%10
storeb out+4 10         # newline
rt write 1 out 5 as w      # w = bytes written, or a negative error
jne w 5 fail            # a short write counts as a failure
rt exit 0
label fail
rt exit 1
