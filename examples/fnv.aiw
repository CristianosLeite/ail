# hash stdin (at most 1048576 bytes) a hundred times over with FNV-1a,
# one pass continuing the hash of the one before, and write the 64-bit
# hash as 8 bytes; exit status 1 on failure
const size 1048576
buf d size
buf b 8
n=0
label more
rt read 0 d+n size-n as r  # 0 at the end of the input or of the buffer
jgt r size fail             # unsigned: a negative r is far above size
n+=r
jnz r more
h=0xcbf29ce484222325
k=100
while k
	i=0
	while i<n
		loadb d+i as r
		h=(h^r)*0x100000001b3
		i+=1
	end
	k-=1
end
store b h
rt write 1 b 8 as r
jne r 8 fail
rt exit 0
label fail
rt exit 1
