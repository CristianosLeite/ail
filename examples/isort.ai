# fill 30000 numbers from a seed of 8 bytes read from stdin, sort them
# by insertion and write a 64-bit checksum of the order as 8 bytes;
# exit status 1 on failure
const count 30000
buf b 8
buf a 240000
sys read 0 b 8 as n
jne n 8 fail
load b as x
set 0 as i
label fill
mul x 0x5851f42d4c957f2d as x
add x 0x14057b7ef767814f as x
shr x 33 as v
mul i 8 as p
add a p as p
store p v
add i 1 as i
jlt i count fill
set 1 as i
label outer
mul i 8 as p
add a p as p
load p as x             # the number to place
label inner
jeq p a place
sub p 8 as q
load q as v
jle v x place
store p v               # a larger one moves up
set q as p
jmp inner
label place
store p x
add i 1 as i
jlt i count outer
set 0 as n
set 0 as i
label sum
mul i 8 as p
add a p as p
load p as v
mul n 31 as n
add n v as n
add i 1 as i
jlt i count sum
store b n
sys write 1 b 8 as n
jne n 8 fail
sys exit 0
label fail
sys exit 1
