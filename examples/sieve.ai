# count the primes below n, an 8-byte number read from stdin (at most
# 16000000), and write the count as 8 bytes; exit status 1 on failure
const size 16000000
buf b 8
buf s size
sys read 0 b 8 as n
jne n 8 fail
load b as n
jgt n size fail
set 0 as c
set 2 as i
label next
jge i n done
add s i as p
loadb p as f            # 1 if i is a multiple of a smaller prime
jnz f skip
add c 1 as c
mul i i as j
label mark
jge j n skip
add s j as p
storeb p 1
add j i as j
jmp mark
label skip
add i 1 as i
jmp next
label done
store b c
sys write 1 b 8 as n
jne n 8 fail
sys exit 0
label fail
sys exit 1
